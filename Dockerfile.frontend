FROM node:22-alpine
WORKDIR /app
ARG VCS_REF=unknown
LABEL org.opencontainers.image.revision=$VCS_REF
COPY Front-End/hestia-prototipo-sprint1-atualizado/package*.json ./
RUN npm ci --omit=dev
COPY Front-End/hestia-prototipo-sprint1-atualizado/ ./
EXPOSE 3000
HEALTHCHECK --interval=15s --timeout=5s --start-period=60s --retries=5 CMD node -e "fetch('http://127.0.0.1:3000/ready').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"
CMD ["npm", "start"]
