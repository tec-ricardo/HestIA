POSTGRES_PORT=5432
DB_URL=jdbc:postgresql://localhost:5432/hestia
DB_USERNAME=hestia
DB_PASSWORD=hestia
JPA_DDL_AUTO=validate
JPA_SHOW_SQL=false
ALERT_SERVICE_URL=http://localhost:3001
ALERT_SERVICE_TIMEOUT=2s

# Publicação: definir valores reais somente no ambiente, nunca no Git.
PUBLIC_APP_URL=
SESSION_SECRET=
SESSION_DATABASE_URL=
HESTIA_VCS_REF=
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
RECOVERY_FROM=

# RAG: definir no servidor; nunca versionar a chave real.
HESTIA_RAG_MODELO=gpt-4.1-mini
RAG_CONTEXT_MAX_CHARS=6000
RAG_CONTEXT_RECENT_TURNS=4
RAG_CONTEXT_MAX_INTERACTIONS=100
RAG_CONTEXT_SUMMARY_CHARS=1200

# Resposta geral é opcional e não constitui política corporativa.
HESTIA_RAG_PERMITIR_RESPOSTA_GERAL=false
