<!doctype html><html lang="pt-BR"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Catálogo de treinamentos — HestIA</title><link rel="stylesheet" href="/styles.css"></head><body><div class="app-shell"><%- include('menu',{perfil,email,active}) %><main class="main-content" style="padding:32px"><h1>Catálogo de treinamentos</h1><p>Cadastre conteúdo autorizado, encaminhe à revisão e publique após conferir a fonte e o acesso. A retirada preserva o histórico.</p><p id="resultado" role="status"></p>
<section class="panel"><h2>Conteúdos cadastrados</h2><% if(!itens.length){ %><p>Nenhum conteúdo cadastrado.</p><% } %><% itens.forEach(t=>{ %><article><h3><a href="/catalogo-real/<%= t.id %>"><%= t.titulo %></a></h3><p><%= t.descricao %></p><p><%= t.estado %> · Referência <%= t.id %></p><% const proximo=({RASCUNHO:'EM_REVISAO',EM_REVISAO:'PUBLICADO',PUBLICADO:'RETIRADO'})[t.estado]; if(proximo){ %><button type="button" class="transicao" data-id="<%= t.id %>" data-estado="<%= proximo %>"><%= ({EM_REVISAO:'Enviar para revisão',PUBLICADO:'Publicar após revisão',RETIRADO:'Retirar'})[proximo] %></button><% } %></article><% }) %></section>
<section class="panel"><h2>Novo conteúdo ou revisão</h2><form id="conteudo" class="form-grid">
<label>Título<input name="titulo" maxlength="250" required></label><label>Resumo<input name="descricao" maxlength="2000" required></label>
<label>Tema<select name="tema"><% ['PROTECAO_DE_DADOS','USO_DE_FERRAMENTAS_AUTORIZADAS','POLITICAS_INTERNAS','BOAS_PRATICAS_DE_USO','VALIDACAO_HUMANA','REGISTRO_E_AUDITORIA','LGPD'].forEach(t=>{ %><option value="<%= t %>"><%= t.replaceAll('_',' ') %></option><% }) %></select></label>
<label>Duração em minutos<input name="duracaoMinutos" type="number" min="1" required></label><label>Referência anterior, se for revisão<input name="anteriorId" type="number" min="1"></label>
<% [['fonte','Fonte, provedor e endereço de acesso'],['autorizacaoUso','Autoria e autorização de uso'],['objetivo','Objetivo de aprendizagem'],['publico','Público, idioma e pré-requisitos'],['atividade','Atividade prática e evidência esperada'],['criterioAceite','Critério de aceite e relação com a política']].forEach(([campo,label])=>{ %><label class="full"><%= label %><textarea name="<%= campo %>" maxlength="2000" required></textarea></label><% }) %>
<label class="full">Conteúdo autorizado<textarea name="conteudo" rows="12" maxlength="200000" required></textarea></label>
<h3 class="full">Avaliação de aprendizagem</h3><% for(let i=1;i<=5;i++){ %><fieldset class="full"><legend>Questão <%= i %></legend><label>Enunciado<input name="q<%= i %>" required></label><% ['A','B','C'].forEach(k=>{ %><label>Alternativa <%= k %><input name="q<%= i %><%= k %>" required></label><% }) %><label>Resposta correta<select name="correta<%= i %>"><option>A</option><option>B</option><option>C</option></select></label><label>Explicação<input name="explicacao<%= i %>" required></label></fieldset><% } %>
<button class="primary" type="submit">Salvar rascunho</button></form></section></main></div><script>
const csrf=<%- JSON.stringify(csrf) %>;const resultado=document.getElementById('resultado');
async function enviar(url,dados){const r=await fetch(url,{method:'POST',headers:{'Content-Type':'application/json','X-CSRF-Token':csrf},body:JSON.stringify(dados)});const d=await r.json();if(!r.ok)throw Error(d.erro||'Operação indisponível');location.reload();}
document.getElementById('conteudo').addEventListener('submit',async e=>{e.preventDefault();const botao=e.submitter;botao.disabled=true;try{const f=new FormData(e.target);const d=Object.fromEntries(["titulo","descricao","conteudo","tema","duracaoMinutos","anteriorId","fonte","autorizacaoUso","objetivo","publico","atividade","criterioAceite"].map(k=>[k,f.get(k)]));d.duracaoMinutos=Number(d.duracaoMinutos);d.anteriorId=d.anteriorId?Number(d.anteriorId):null;d.questoes=Array.from({length:5},(_,n)=>{const i=n+1;return{id:'q'+i,enunciado:f.get('q'+i),alternativas:{A:f.get('q'+i+'A'),B:f.get('q'+i+'B'),C:f.get('q'+i+'C')},correta:f.get('correta'+i),explicacao:f.get('explicacao'+i)};});await enviar('/api/catalogo-real',d);}catch(err){resultado.textContent=err.message;botao.disabled=false;}});
document.querySelectorAll('.transicao').forEach(b=>b.addEventListener('click',async()=>{let motivo='';if(b.dataset.estado!=='EM_REVISAO'){motivo=prompt(b.dataset.estado==='PUBLICADO'?'Registre como conferiu fonte, acesso, autorização e adequação:':'Informe o motivo da retirada:');if(!motivo)return;}b.disabled=true;try{await enviar('/api/catalogo-real/'+b.dataset.id+'/estado',{estado:b.dataset.estado,motivo});}catch(err){resultado.textContent=err.message;b.disabled=false;}}));
</script></body></html>
