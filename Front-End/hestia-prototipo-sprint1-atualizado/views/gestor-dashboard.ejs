<!DOCTYPE html>
<html lang="pt-BR">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>HestIA | Visão executiva</title><link rel="stylesheet" href="/styles.css"><link rel="stylesheet" href="/dashboard-executivo.css"></head>
<body><div class="app-shell">
<%- include("menu",{perfil,email,active}) %>
<main class="main ex-page">
<% const d=dashboard,p=d.painel,m=d.maturidade;
const fmt=n=>n==null?'—':Number(n).toLocaleString('pt-BR',{maximumFractionDigits:1});
const pct=n=>n==null?'—':fmt(n)+'%';
const fmtNota=n=>n==null?'—':Number(n).toLocaleString('pt-BR',{minimumFractionDigits:2,maximumFractionDigits:2});
const dia=s=>s?String(s).slice(0,10).split('-').reverse().join('/'):'—';
const detalhes='/gestao-colaboradores?'+d.query;
const custos='/custos?'+d.query;
const cm=d.consultaMaturidade;
const fonte=cm?.fonte||(typeof fonteSelecionada!=='undefined'?fonteSelecionada:'OPERACIONAL');
const maturidadeUrl=cm?'/maturidade/resultados?'+new URLSearchParams(cm):'/maturidade';
%>
<header class="ex-header"><div class="ex-title"><button class="menu-button" id="menuButton" aria-label="Abrir menu">☰</button><div><p class="ex-eyebrow">HESTIA / INTELIGÊNCIA DE GESTÃO</p><h1>Visão executiva</h1><p><%= p ? p.empresa+' · '+p.departamento : 'Dados da organização autenticada' %></p></div></div><span class="ex-live <%= d.disponivel?'':'ex-offline' %>"><i></i> <%= d.disponivel?'Dados operacionais':'Dados indisponíveis' %></span></header>
<form class="ex-filters" method="get" action="/">
 <div><strong>Recorte de análise</strong><p><%= p?dia(p.inicio)+' — '+dia(p.fim):'Selecione o período' %></p></div>
 <label>Período operacional<select name="dias"><% for(const n of [7,30,90]){ %><option value="<%= n %>" <%= d.filtros.dias===n?'selected':'' %>>Últimos <%= n %> dias</option><% } %></select></label>
 <% if(perfil==='administrador'&&p){ %><label>Departamento<select name="departamentoId"><option value="">Todos os departamentos</option><% for(const dep of p.departamentosDisponiveis||[]){ %><option value="<%= dep.id %>" <%= String(dep.id)===String(p.departamentoId)?'selected':'' %>><%= dep.nome %></option><% } %></select></label><% } %>
 <% if(demonstracao){ %><label>Fonte da maturidade<select name="fonteMaturidade"><option value="DEMO" <%= fonte==='DEMO'?'selected':'' %>>Demonstrativa · QSoft</option><option value="OPERACIONAL" <%= fonte==='OPERACIONAL'?'selected':'' %>>Operacional</option></select></label><% } %>
 <button type="submit">Aplicar filtros</button><a href="/">Limpar</a>
</form>
<% if(!d.disponivel){ %><section class="ex-card ex-empty" role="status"><h2>Dados indisponíveis</h2><p><%= erro||'Entre com uma conta autorizada para consultar os indicadores. Não há valores estimados.' %></p><a href="/">Tentar novamente →</a></section>
<% }else{ %>
<section class="ex-hero"><div class="ex-hero-copy"><p class="ex-eyebrow">AI MATURITY SCORE · <%= fonte==='DEMO'?'DEMONSTRAÇÃO NO BANCO':'OPERACIONAL' %></p><h2><%= fonte==='DEMO'?'Maturidade do cenário demonstrativo':'Como está a maturidade da sua organização?' %></h2><p><%= cm?dia(cm.inicio)+' — '+dia(cm.fim):'Período indisponível' %> · <%= fonte==='DEMO'?'Notas fictícias do cenário QSoft. Os KPIs e alertas abaixo permanecem operacionais.':'Registros operacionais da organização.' %></p><p><%= m?d.diagnostico.conclusao:'Apuração indisponível para esta fonte. Nenhuma nota estimada.' %></p><a href="<%= maturidadeUrl %>" class="ex-hero-link">Ver diagnóstico completo <span>↗</span></a><div class="ex-hero-priorities"><a href="#decisoes"><%= d.atencao %> colaboradores para acompanhar ↗</a><a href="#conformidade"><%= d.nao %> avaliações não conformes ↗</a></div></div>
<div class="ex-score"><div class="ex-score-ring" style="--score:<%= Math.max(0,Math.min(100,Number(m?.scoreGlobal??m?.scoreParcial??0))) %>%"><div><span>MATURITY</span><strong><%= fmtNota(m?.scoreGlobal??m?.scoreParcial) %></strong><small>de 100</small></div></div><div><b><%= m?.scoreGlobal!=null?'Score completo':m?.scoreParcial!=null?'Score parcial exploratório':'Sem apuração elegível' %></b><p>Cobertura de pesos: <%= m?.coberturaPesos==null?'—':pct(Number(m.coberturaPesos)*100) %></p></div></div></section>

<section aria-label="Indicadores principais"><div class="ex-section-head"><div><p class="ex-eyebrow">01 / VISÃO EM NÚMEROS</p><h2>Indicadores-chave</h2></div><span>Colaboradores ativos no escopo · período selecionado</span></div>
<div class="ex-kpi-grid">
<% const cards=[
{label:'Adoção de IA',tag:'ADOÇÃO',value:pct(d.adocao),sub:fmt(d.ativos)+' de '+fmt(d.total)+' com uso registrado',href:'#adocao',accent:'blue',progress:d.adocao},
{label:'Taxa de conformidade',tag:'GOVERNANÇA',value:pct(d.conformidade),sub:fmt(d.conformes)+' conformes de '+fmt(d.conformes+d.nao)+' definitivas',href:'#conformidade',accent:'green',progress:d.conformidade},
{label:'AI Literacy médio',tag:'CAPACITAÇÃO',value:d.literacy==null?'—':fmt(d.literacy)+' / 100',sub:fmt(d.avaliados)+' colaboradores avaliados',href:'#aprendizagem',accent:'gold',progress:d.literacy},
{label:'Tokens registrados',tag:'CONSUMO',value:fmt(d.tokens),sub:fmt(d.medidos)+' usos com tokens positivos',href:custos,accent:'blue'},
{label:'Reutilizações pontuadas',tag:'REUSO',value:fmt(d.reutilizacoes),sub:'Ações de reutilização registradas no XP',href:'#aprendizagem',accent:'purple'},
{label:'Colaboradores em atenção',tag:'DECISÃO',value:fmt(d.atencao),sub:'Com pontos de acompanhamento, não penalidades',href:'#decisoes',accent:'amber'}
]; %>
<% for(const k of cards){ %><a class="ex-kpi ex-card" href="<%= k.href %>" data-accent="<%= k.accent %>"><div class="ex-kpi-top"><span class="ex-tag"><%= k.tag %></span><span class="ex-arrow">↗</span></div><h3><%= k.label %></h3><strong><%= k.value %></strong><p><%= k.sub %></p><% if(k.progress!=null){ %><div class="ex-meter"><i style="width:<%= Math.max(0,Math.min(100,k.progress)) %>%"></i></div><% } %></a><% } %>
</div></section>

<section aria-label="Adoção e utilização" id="adocao"><div class="ex-section-head"><div><p class="ex-eyebrow">02 / COMPORTAMENTO DE USO</p><h2>Adoção e utilização</h2></div><a href="<%= detalhes %>">Ver colaboradores ↗</a></div>
<div class="ex-grid ex-grid-wide">
<article class="ex-card ex-chart"><div class="ex-card-head"><div><h3>Evolução das utilizações</h3><p>Registros por dia · inclui o dia atual</p></div><span class="ex-chip"><%= fmt(d.usos) %> usos</span></div>
<p class="ex-trend"><%= d.variacao==null?'Sem base anterior positiva para comparação':(d.variacao>=0?'+':'')+fmt(d.variacao)+'% versus período anterior' %><% if(d.anterior!=null){ %> · <%= fmt(d.anterior) %> registros anteriores<% } %></p>
<% if(!d.serie.length||!d.usos){ %><div class="ex-chart-empty">Nenhuma utilização registrada no período.</div><% } else{
const W=680,H=215,L=43,R=18,T=19,B=35, max=Math.max(1,...d.serie.map(x=>x.usos)),x=i=>L+i*(W-L-R)/Math.max(1,d.serie.length-1),y=n=>H-B-(H-B-T)*n/max;
const pontos=d.serie.map((v,i)=>x(i).toFixed(1)+','+y(v.usos).toFixed(1)).join(' ');
const area=L+','+(H-B)+' '+pontos+' '+x(d.serie.length-1)+','+(H-B);
%><svg class="ex-line" viewBox="0 0 680 215" role="img" aria-label="Gráfico de utilizações diárias, valores detalhados abaixo">
<% for(const n of [0,.25,.5,.75,1]){ %><line x1="<%= L %>" x2="<%= W-R %>" y1="<%= y(n*max) %>" y2="<%= y(n*max) %>" stroke="#e5eaf0" stroke-dasharray="4 5"/><text x="<%= L-8 %>" y="<%= y(n*max)+4 %>" text-anchor="end" fill="#61748a" font-size="11"><%= fmt(n*max) %></text><% } %>
<polygon points="<%= area %>" fill="#e7edf5"/><polyline points="<%= pontos %>" fill="none" stroke="#1a4269" stroke-width="3" stroke-linejoin="round" stroke-linecap="round"/>
<% for(let i=0;i<d.serie.length;i++){ %><circle cx="<%= x(i) %>" cy="<%= y(d.serie[i].usos) %>" r="<%= d.serie.length>30?1.6:3 %>" fill="#b87346"><title><%= dia(d.serie[i].dia) %>: <%= d.serie[i].usos %> usos</title></circle><% } %>
<% for(const i of [...new Set([0,Math.floor((d.serie.length-1)/2),d.serie.length-1])]){ %><text x="<%= x(i) %>" y="<%= H-9 %>" text-anchor="<%= i===0?'start':i===d.serie.length-1?'end':'middle' %>" fill="#61748a" font-size="11"><%= dia(d.serie[i].dia).slice(0,5) %></text><% } %></svg>
<details class="ex-data"><summary>Ver dados diários</summary><div class="ex-data-scroll"><table><thead><tr><th>Data</th><th>Usos</th><th>Tokens registrados</th></tr></thead><tbody><% for(const v of d.serie){ %><tr><td><%= dia(v.dia) %></td><td><%= fmt(v.usos) %></td><td><%= fmt(v.tokens) %></td></tr><% } %></tbody></table></div></details><% } %>
</article>
<article class="ex-card"><div class="ex-card-head"><div><h3>Adoção por departamento</h3><p>Pessoas com uso registrado / ativos</p></div></div>
<% if(!d.departamentos.length){ %><div class="ex-chart-empty">Nenhum colaborador ativo.</div><% } %>
<div class="ex-rank-list"><% for(const dep of d.departamentos){ %><div class="ex-rank-row"><div><span><%= dep.nome %></span><b><%= pct(dep.taxa) %></b></div><div class="ex-meter"><i style="width:<%= dep.taxa||0 %>%"></i></div><small><%= dep.participantes %> de <%= dep.total %> colaboradores · <%= dep.usos %> usos</small></div><% } %></div>
</article>
</div>
<div class="ex-grid">
<% for(const grupo of [{titulo:'Ferramentas mais utilizadas',sub:'Até seis ferramentas com mais registros',linhas:d.ferramentas},{titulo:'Finalidade do uso',sub:'Até seis finalidades mais registradas',linhas:d.finalidades}]){ %>
<article class="ex-card"><div class="ex-card-head"><div><h3><%= grupo.titulo %></h3><p><%= grupo.sub %></p></div></div><% if(!grupo.linhas.length){ %><div class="ex-chart-empty">Sem registros no recorte.</div><% } %>
<div class="ex-rank-list"><% for(const l of grupo.linhas){ %><div class="ex-rank-row"><div><span><%= String(l.nome||'Não informada').replaceAll('_',' ') %></span><b><%= fmt(l.usos) %></b></div><div class="ex-meter"><i style="width:<%= d.usos?Math.max(0,Math.min(100,100*Number(l.usos)/d.usos)):0 %>%"></i></div></div><% } %></div></article><% } %>
</div></section>

<section aria-label="Governança e desenvolvimento"><div class="ex-section-head"><div><p class="ex-eyebrow">03 / QUALIDADE E DESENVOLVIMENTO</p><h2>Uso responsável e capacitação</h2></div><a href="/governanca">Ver governança ↗</a></div>
<div class="ex-grid"><article class="ex-card" id="conformidade"><div class="ex-card-head"><div><h3>Distribuição das avaliações</h3><p>Classificações com evidências preservadas</p></div><a href="/ocorrencias">Ocorrências ↗</a></div>
<% const totalAvaliacoes=d.conformes+d.nao+d.revisoes,a=totalAvaliacoes?100*d.conformes/totalAvaliacoes:0,b=totalAvaliacoes?100*(d.conformes+d.nao)/totalAvaliacoes:0; %>
<div class="ex-conform"><div class="ex-donut" role="img" aria-label="<%= d.conformes %> conformes, <%= d.nao %> não conformes, <%= d.revisoes %> em revisão" style="--a:<%= a %>%;--b:<%= b %>%;--donut:<%= totalAvaliacoes?'conic-gradient(#237b61 0 var(--a),#b84d51 var(--a) var(--b),#c8974c var(--b) 100%)':'#e7edf2' %>"><div><strong><%= fmt(totalAvaliacoes) %></strong><small>Avaliações</small></div></div>
<div class="ex-legend"><p><i class="ex-dot green"></i> Conformes <b><%= fmt(d.conformes) %></b></p><p><i class="ex-dot red"></i> Não conformes <b><%= fmt(d.nao) %></b></p><p><i class="ex-dot amber"></i> Em revisão <b><%= fmt(d.revisoes) %></b></p></div></div><p class="ex-note">Taxa de conformidade exclui avaliações em revisão. Sem avaliações definitivas, a taxa fica indisponível.</p></article>
<article class="ex-card" id="aprendizagem"><div class="ex-card-head"><div><h3>Engajamento e aprendizagem</h3><p>Evidências das ações registradas</p></div><a href="<%= detalhes %>">Acompanhar ↗</a></div>
<div class="ex-metric-list"><div><span>Microtreinamentos pontuados</span><strong><%= fmt(d.treinamentos) %></strong></div><div><span>XP conquistado no período</span><strong><%= fmt(d.xp) %> XP</strong></div><div><span>Colaboradores com avaliação elegível</span><strong><%= fmt(d.avaliados) %> / <%= fmt(d.total) %></strong></div><div><span>Reutilizações pontuadas</span><strong><%= fmt(d.reutilizacoes) %></strong></div></div><p class="ex-note">XP sinaliza engajamento, não produtividade ou avaliação profissional.</p></article></div></section>

<section id="decisoes"><div class="ex-section-head"><div><p class="ex-eyebrow">04 / PRÓXIMOS PASSOS</p><h2>Central de decisões</h2></div><a href="<%= detalhes %>">Todos os colaboradores ↗</a></div>
<article class="ex-card"><div class="ex-card-head"><div><h3>Prioridades individuais</h3><p><%= d.atencao %> colaboradores com pontos de acompanhamento · <%= d.acoes.length %> sinais encontrados</p></div><span class="ex-chip ex-warm"><%= d.acoes.length %> sinais</span></div>
<% if(!d.acoes.length){ %><p class="ex-note">Nenhum ponto de atenção identificado pelas regras atuais.</p><% }else{ %>
<div class="ex-data-scroll"><table class="ex-decisions"><thead><tr><th>Colaborador</th><th>Ponto de atenção</th><th>Evidência</th><th>Ação recomendada</th></tr></thead><tbody><% for(const a of d.acoes.slice(0,8)){ %><tr><td><a href="<%= detalhes %>#colaborador-<%= a.id %>"><strong><%= a.nome %></strong></a><small><%= a.departamento %></small></td><td><span class="ex-chip <%= a.dimensao==='Uso responsável'?'ex-danger':'ex-warm' %>"><%= a.dimensao %></span></td><td><%= a.motivo %></td><td><%= a.acao %> <a href="<%= detalhes %>#colaborador-<%= a.id %>" aria-label="Detalhar <%= a.nome %>">↗</a></td></tr><% } %></tbody></table></div><% } %>
<p class="ex-note">A referência de tokens é configurável em acompanhamento. Lacuna de evidência não equivale a desempenho ruim.</p></article>
<article class="ex-card ex-dimensions"><div class="ex-card-head"><div><h3>Diagnóstico das oito dimensões</h3><p><%= fonte==='DEMO'?'DEMONSTRAÇÃO NO BANCO · '+dia(cm?.inicio)+' a '+dia(cm?.fim)+' · dados fictícios':'OPERACIONAL · score, qualidade da evidência e recomendação' %></p></div><a href="<%= maturidadeUrl %>">Racional de cálculo ↗</a></div><div class="ex-dim-grid"><% for(const i of d.diagnostico.indicadores){ %><details class="ex-dim"><summary><span><b><%= i.nome %></b><small><%= i.status %></small></span><strong><%= fmtNota(i.nota) %></strong></summary><p><%= i.significado %></p><p><%= i.recomendacao %></p><% if(i.formula){ %><small>Fórmula: <%= i.formula %></small><% } %><a href="<%= i.link %>">Consultar →</a></details><% } %></div></article>
</section><footer class="ex-footer">Escopo: <%= p.empresa %> · <%= p.departamento %>. KPIs e prioridades: registros operacionais do HestIA. Maturidade: <%= fonte==='DEMO'?'cenário demonstrativo separado (QSoft)':'fonte operacional' %>. As métricas de adoção usam funcionários atualmente ativos e não medem retorno financeiro nem ganho real de produtividade.</footer>
<% } %>
</main></div><script src="/app.js"></script></body></html>
