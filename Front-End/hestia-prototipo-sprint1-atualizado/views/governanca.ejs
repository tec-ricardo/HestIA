<!DOCTYPE html>
<html lang="pt-BR">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0">

    <title>
        HestIA - Governança
    </title>

    <link
        rel="stylesheet"
        href="/styles.css">

</head>

<body>

    <div class="app-shell">

        <%- include("menu", {
            perfil: perfil,
            email: email,
            active: active
        }) %>


        <main class="main">

            <!-- TOPO -->

            <header class="topbar">

                <button
                    class="menu-button"
                    id="menuButton">

                    ☰

                </button>


                <div>

                    <p class="eyebrow">
                        Governança
                    </p>

                    <h1>
                        Políticas e conformidade
                    </h1>

                </div>


                <div class="profile-switch">

                    <span>
                        <%= email %>
                    </span>

                </div>


                <a
                    class="topbar-logout"
                    href="/sair">

                    Sair

                </a>

            </header>


            <% if (mensagem) { %>

                <div class="feedback success">
                    <%= mensagem %>
                </div>

            <% } %>


            <% if (erro) { %>

                <div class="feedback error">
                    <%= erro %>
                </div>

            <% } %>


            <!-- INDICADORES -->

            <section class="grid two">

                <article class="metric-card">

                    <span>
                        Políticas
                    </span>

                    <strong>
                        <%= politicas.length ? politicas.length : 3 %>
                    </strong>

                    <p>
                        <%= politicas.length ? "Políticas registradas no backend." : "Políticas demonstrativas do protótipo." %>
                    </p>

                </article>


                <article class="metric-card">

                    <span>
                        Conformidade
                    </span>

                    <strong>
                        82%
                    </strong>

                    <p>
                        82 de 100 utilizações estão conformes.
                    </p>

                </article>

            </section>


            <!-- DASHBOARD -->

            <section class="panel">

                <div class="panel-head">

                    <h3>
                        Conformidade das utilizações
                    </h3>

                </div>


                <div class="dashboard-chart governanca-chart">

                    <canvas id="graficoConformidade"></canvas>

                    <div
                        class="chart-empty"
                        id="semConformidade">

                        Nenhum registro de conformidade disponível.

                    </div>

                </div>

            </section>


            <!-- POLITICAS -->

            <section class="panel">

                <div class="panel-head">

                    <h3>
                        Políticas e diretrizes
                    </h3>

                </div>


                <div class="table-wrap">

                    <table>

                        <thead>

                            <tr>

                                <th>
                                    Política / diretriz
                                </th>

                                <th>
                                    Situação
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            <% politicas.forEach(function(politica) { %>

                                <tr>

                                    <td>
                                        <%= politica.titulo %>
                                        <small>
                                            v<%= politica.versao %>
                                        </small>
                                    </td>

                                    <td>
                                        <%= politica.ativa ? "Ativa" : "Inativa" %>
                                    </td>

                                </tr>

                            <% }) %>


                            <% if (!politicas.length) { %>

                                <tr>

                                    <td>
                                        Uso responsável de IA
                                        <small>v1.0</small>
                                    </td>

                                    <td>
                                        Ativa
                                    </td>

                                </tr>


                                <tr>

                                    <td>
                                        Proteção de dados
                                        <small>v1.0</small>
                                    </td>

                                    <td>
                                        Ativa
                                    </td>

                                </tr>


                                <tr>

                                    <td>
                                        Uso de informações corporativas
                                        <small>v1.0</small>
                                    </td>

                                    <td>
                                        Ativa
                                    </td>

                                </tr>

                            <% } %>

                        </tbody>

                    </table>

                </div>

            </section>


            <!-- ADMINISTRADOR -->

            <% if (perfil == "administrador") { %>

                <section class="grid two">


                    <article class="panel">

                        <div class="panel-head">

                            <h3>
                                Cadastrar política ou diretriz
                            </h3>

                        </div>


                        <form
                            class="form-grid"
                            action="/governanca/politicas"
                            method="post">


                            <label class="full">

                                Política ou diretriz

                                <input
                                    name="titulo"
                                    type="text"
                                    required>

                            </label>


                            <label>

                                Empresa

                                <select
                                    name="empresaId"
                                    required>

                                    <option value="">
                                        Selecione
                                    </option>

                                    <% empresas.forEach(function(empresa) { %>

                                        <option value="<%= empresa.id %>">
                                            <%= empresa.nome %>
                                        </option>

                                    <% }) %>

                                </select>

                            </label>


                            <label>

                                Versão

                                <input
                                    name="versao"
                                    type="text"
                                    value="1.0"
                                    required>

                            </label>


                            <label class="full">

                                Descrição

                                <input
                                    name="descricao"
                                    type="text"
                                    required>

                            </label>


                            <label class="full">

                                Conteúdo

                                <textarea
                                    name="conteudo"
                                    rows="4"
                                    required></textarea>

                            </label>


                            <button
                                class="primary"
                                type="submit">

                                Cadastrar

                            </button>

                        </form>

                    </article>


                    <!-- REGISTRAR CONFORMIDADE -->

                    <article class="panel">

                        <div class="panel-head">

                            <h3>
                                Registrar conformidade
                            </h3>

                        </div>


                        <form
                            class="form-grid"
                            onsubmit="return false;">


                            <label>

                                Utilização de IA

                                <select required>

                                    <option value="">
                                        Selecione uma utilização
                                    </option>

                                    <option>
                                        Resumo de documento - w@colaborador
                                    </option>

                                    <option>
                                        Apoio na elaboração de relatório - w@colaborador
                                    </option>

                                    <option>
                                        Análise de dados - w@colaborador
                                    </option>

                                    <option>
                                        Geração de apresentação - w@colaborador
                                    </option>

                                </select>

                            </label>


                            <label>

                                Conformidade

                                <select required>

                                    <option value="">
                                        Selecione
                                    </option>

                                    <option value="conforme">
                                        Conforme
                                    </option>

                                    <option value="nao-conforme">
                                        Não conforme
                                    </option>

                                </select>

                            </label>


                            <!-- SCRUM 194 - DETALHES DA CONFORMIDADE -->

                            <label class="full">

                                Política / regra acionada

                                <select required>

                                    <option value="">
                                        Selecione uma política ou regra
                                    </option>


                                    <% if (politicas.length) { %>

                                        <% politicas.forEach(function(politica) { %>

                                            <option value="<%= politica.id %>">
                                                <%= politica.titulo %> - v<%= politica.versao %>
                                            </option>

                                        <% }) %>

                                    <% } else { %>

                                        <option>
                                            Uso responsável de IA - v1.0
                                        </option>

                                        <option>
                                            Proteção de dados - v1.0
                                        </option>

                                        <option>
                                            Uso de informações corporativas - v1.0
                                        </option>

                                    <% } %>

                                </select>

                            </label>


                            <label class="full">

                                Justificativa

                                <textarea
                                    rows="4"
                                    placeholder="Informe a justificativa da avaliação de conformidade"
                                    required></textarea>

                            </label>


                            <button
                                class="primary fake-save"
                                type="button">

                                Registrar

                            </button>

                        </form>

                    </article>

                </section>

            <% } %>


            <div
                class="toast"
                id="toast">

                Dados persistidos pelo backend HestIA.

            </div>

        </main>

    </div>


    <!-- CHART JS -->

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>


    <!-- GRAFICO DE CONFORMIDADE -->

    <script>

        const graficoConformidade =
            document.getElementById("graficoConformidade");


        const tiposConformidade = [
            "Conforme",
            "Não conforme"
        ];


        const valoresConformidade = [
            82,
            18
        ];


        if (
            graficoConformidade &&
            tiposConformidade.length > 0
        ) {

            document
                .getElementById("semConformidade")
                .style.display = "none";


            new Chart(graficoConformidade, {

                type: "doughnut",

                data: {

                    labels: tiposConformidade,

                    datasets: [{

                        data: valoresConformidade

                    }]

                },


                options: {

                    responsive: true,

                    maintainAspectRatio: false,

                    cutout: "65%",

                    plugins: {

                        legend: {

                            position: "top"

                        }

                    }

                }

            });

        }

    </script>


    <script src="/app.js"></script>

</body>

</html>