<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HestIA - Governança</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
<div class="app-shell">
    <%- include("menu", { perfil, email, active }) %>
    <main class="main">
        <header class="topbar">
            <button class="menu-button" id="menuButton">☰</button>
            <div><p class="eyebrow">Governança</p><h1>Políticas e conformidade</h1></div>
            <div class="profile-switch"><span><%= email %></span></div>
            <a class="topbar-logout" href="/sair">Sair</a>
        </header>

        <% if (mensagem) { %><div class="feedback success"><%= mensagem %></div><% } %>
        <% if (erro) { %><div class="feedback error"><%= erro %></div><% } %>

        <section class="hero-card">
            <p class="eyebrow"><%= perfil === 'colaborador' ? 'Meu uso' : 'Visão da empresa' %></p>
            <h2>Regras vigentes e resultados registrados</h2>
            <p>Esta tela utiliza somente políticas e avaliações persistidas no banco do HestIA.</p>
        </section>

        <section class="dashboard-summary">
            <article class="dashboard-summary-card"><span>Políticas cadastradas</span><strong><%= politicas.length %></strong><p><%= politicas.filter(p => p.ativa && !p.excluida).length %> ativas</p></article>
            <article class="dashboard-summary-card"><span>Usos registrados</span><strong><%= resumoConformidade ? resumoConformidade.registros : '—' %></strong><p><%= perfil === 'colaborador' ? 'Associados à sua conta' : 'No escopo da empresa' %></p></article>
            <article class="dashboard-summary-card"><span>Usos avaliados</span><strong><%= resumoConformidade ? resumoConformidade.avaliadas : '—' %></strong><p>Avaliações de conformidade persistidas</p></article>
            <article class="dashboard-summary-card"><span>Conformidade</span><strong><%= resumoConformidade && resumoConformidade.percentualConformidade !== null ? Number(resumoConformidade.percentualConformidade).toLocaleString('pt-BR') + '%' : '—' %></strong><p><%= resumoConformidade && resumoConformidade.avaliadas ? resumoConformidade.conformes + ' conformes de ' + resumoConformidade.avaliadas + ' avaliadas' : 'Ainda não há amostra avaliada' %></p></article>
        </section>

        <section class="grid three">
            <article class="metric-card"><span>Conformes</span><strong><%= resumoConformidade ? resumoConformidade.conformes : '—' %></strong><p>Atendem à política aplicada.</p></article>
            <article class="metric-card"><span>Não conformes</span><strong><%= resumoConformidade ? resumoConformidade.nao_conformes : '—' %></strong><p>Demandam tratamento.</p></article>
            <article class="metric-card"><span>Em revisão</span><strong><%= resumoConformidade ? resumoConformidade.requerem_revisao : '—' %></strong><p>Aguardam decisão complementar.</p></article>
        </section>

        <section class="panel">
            <div class="panel-head"><div><h3>Políticas e diretrizes</h3><p>Versões atualmente registradas para a empresa autenticada.</p></div></div>
            <% if (!politicas.length) { %>
                <p class="muted">Nenhuma política cadastrada. Um administrador precisa publicar a primeira política antes das avaliações.</p>
            <% } else { %>
                <div class="table-wrap"><table>
                    <thead><tr><th>Política</th><th>Versão</th><th>Revisão</th><th>Situação</th><th>Atualizada em</th></tr></thead>
                    <tbody><% politicas.forEach(politica => { %><tr>
                        <td><strong><%= politica.titulo %></strong><br><small><%= politica.descricao %></small></td>
                        <td><%= politica.versao %></td><td><%= politica.revisao || 1 %></td>
                        <td><%= politica.ativa && !politica.excluida ? 'Ativa' : 'Inativa' %></td>
                        <td><%= politica.dataAtualizacao ? new Date(politica.dataAtualizacao).toLocaleString('pt-BR') : '—' %></td>
                    </tr><% }) %></tbody>
                </table></div>
            <% } %>
        </section>

        <% if (perfil === 'administrador') { %>
            <section class="panel">
                <div class="panel-head"><div><h3>Cadastrar política</h3><p>A política será vinculada automaticamente à empresa da sua sessão.</p></div></div>
                <form class="form-grid" action="/governanca/politicas" method="post">
                    <label class="full">Título<input name="titulo" type="text" maxlength="150" required></label>
                    <label>Versão<input name="versao" type="text" maxlength="20" value="1.0" required></label>
                    <label class="full">Descrição<input name="descricao" type="text" maxlength="500" required></label>
                    <label class="full">Conteúdo<textarea name="conteudo" rows="6" required></textarea></label>
                    <button class="primary" type="submit">Cadastrar política</button>
                </form>
            </section>
        <% } %>

        <section class="panel">
            <div class="panel-head"><div><h3>Como uma avaliação é registrada</h3><p>A conformidade nasce da avaliação de um registro de uso contra uma política e sua revisão exata.</p></div></div>
            <p>Consulte os registros para acompanhar o uso. A avaliação preserva a política, a regra, o motivo e as limitações utilizados na decisão.</p>
            <a class="personal-card-link" href="/utilizacoes/registros">Ver registros de uso →</a>
        </section>
    </main>
</div>
<script src="/app.js"></script>
</body>
</html>
