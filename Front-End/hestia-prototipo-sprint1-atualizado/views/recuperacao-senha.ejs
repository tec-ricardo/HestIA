<!doctype html><html lang="pt-BR"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Recuperação de acesso — HestIA</title><link rel="stylesheet" href="/styles.css"></head><body><main class="main"><section class="panel"><h1><%= redefinir?'Definir nova senha':'Recuperar acesso' %></h1><% if(erro){ %><p role="alert"><%= erro %></p><% } %><% if(ok){ %><p role="status"><%= redefinir?'Senha alterada. Entre novamente.':'Se a conta estiver cadastrada, você receberá as instruções de recuperação.' %></p><% }else{ %><form method="post"><input type="hidden" name="csrf" value="<%= csrf %>"><% if(redefinir){ %><label>Nova senha<input type="password" name="senha" minlength="8" maxlength="100" autocomplete="new-password" required></label><% }else{ %><label>E-mail<input type="email" name="email" autocomplete="email" required></label><% } %><button class="primary" type="submit">Continuar</button></form><% } %><a href="/acesso">Voltar ao acesso</a></section></main></body></html>
