
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HestIA — Maturidade</title>

    <link rel="stylesheet" href="/styles.css">
    <link rel="stylesheet" href="/qualidade-indicadores.css">

    <style>
        .maturidade-conteudo {
            width: 100%;
            max-width: 1200px;
            margin: 0 auto;
            padding: 32px;
            box-sizing: border-box;
        }

        .maturidade-conteudo h1 {
            font-size: 30px;
            margin: 0 0 10px;
            color: #14233d;
        }

        .maturidade-conteudo h2 {
            font-size: 21px;
            margin: 30px 0 15px;
            color: #14233d;
        }

        .maturidade-conteudo h3 {
            color: #14233d;
        }

        .maturidade-descricao {
            color: #64748b;
            line-height: 1.6;
            margin-bottom: 24px;
        }

        .maturidade-links {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            margin: 20px 0;
        }

        .maturidade-links a {
            display: inline-block;
            padding: 11px 15px;
            border: 1px solid #dbe3ee;
            border-radius: 9px;
            background: white;
            color: #3154c9;
            text-decoration: none;
            font-weight: 600;
        }

        .maturidade-links a:hover {
            background: #eef3ff;
        }

        .maturidade-card {
            background: white;
            border: 1px solid #e2e8f0;
            border-radius: 14px;
            padding: 24px;
            margin-bottom: 22px;
            box-shadow: 0 3px 12px rgba(15, 23, 42, 0.04);
        }

        .maturidade-card h2 {
            margin-top: 0;
        }

        .maturidade-filtros {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
            gap: 16px;
            margin-bottom: 18px;
        }

        .maturidade-campo {
            display: flex;
            flex-direction: column;
            gap: 7px;
            font-size: 14px;
            font-weight: 600;
            color: #334155;
        }

        .maturidade-campo input,
        .maturidade-campo select {
            width: 100%;
            min-height: 42px;
            padding: 9px 12px;
            border: 1px solid #cbd5e1;
            border-radius: 8px;
            background: white;
            color: #17243d;
            box-sizing: border-box;
        }

        .maturidade-detalhes {
            margin: 18px 0;
            padding: 16px;
            background: #f8fafc;
            border-radius: 9px;
            border: 1px solid #e2e8f0;
        }

        .maturidade-detalhes summary {
            cursor: pointer;
            font-weight: 600;
        }

        .maturidade-detalhes .maturidade-filtros {
            margin-top: 18px;
        }

        .maturidade-botao {
            border: none;
            border-radius: 8px;
            background: #3154d5;
            color: white;
            padding: 12px 20px;
            font-weight: 600;
            cursor: pointer;
        }

        .maturidade-botao:hover {
            background: #2442b0;
        }

        .maturidade-alerta {
            padding: 14px 16px;
            border: 1px solid #fecaca;
            border-radius: 9px;
            background: #fef2f2;
            color: #991b1b;
            margin: 18px 0;
        }

        .maturidade-indicadores {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
            gap: 16px;
            margin: 20px 0;
        }

        .maturidade-indicador {
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            border-radius: 10px;
            padding: 20px;
        }

        .maturidade-indicador span {
            display: block;
            font-size: 13px;
            color: #64748b;
            margin-bottom: 10px;
        }

        .maturidade-indicador strong {
            font-size: 27px;
            color: #14233d;
        }

        .maturidade-tabela {
            width: 100%;
            border-collapse: collapse;
            font-size: 13px;
        }

        .maturidade-tabela th,
        .maturidade-tabela td {
            padding: 13px;
            text-align: left;
            border-bottom: 1px solid #e2e8f0;
            vertical-align: top;
        }

        .maturidade-tabela th {
            background: #f1f5f9;
            color: #334155;
            white-space: nowrap;
        }

        .maturidade-tabela td p {
            margin: 7px 0 0;
        }

        .maturidade-nota {
            font-size: 13px;
            color: #64748b;
            line-height: 1.6;
        }

        @media (max-width: 768px) {
            .maturidade-conteudo {
                padding: 18px;
            }

            .maturidade-card {
                padding: 16px;
            }

            .maturidade-conteudo h1 {
                font-size: 25px;
            }
        }
    </style>
</head>

<body>
<div class="app-shell">
    <%- include("menu", { perfil, email, active }) %>

    <main class="main">
        <div class="maturidade-conteudo">

            <h1>Maturidade em IA</h1>

            <p class="maturidade-descricao">
                Consulte as notas observadas na base autorizada da QSoft
                e sua cobertura. A proposta 0.1 está em validação pelo grupo.
            </p>

            <div class="maturidade-links">
                <a href="/maturidade/simulacao-produtividade">
                    Comparar cenários simulados de produtividade
                </a>

                <a href="/maturidade/confiabilidade">
                    Indicadores operacionais e confiabilidade
                </a>

                <a href="/maturidade/metodologia">
                    Consultar metodologia e versões
                </a>
            </div>

            <section class="maturidade-card">
                <h2>Consultar indicadores</h2>

                <form method="get" action="/maturidade/resultados">

                    <div class="maturidade-filtros">
                        <label class="maturidade-campo">
                            Início
                            <input required type="date" name="inicio"
                                   value="<%= filtros.inicio || '' %>">
                        </label>

                        <label class="maturidade-campo">
                            Fim
                            <input required type="date" name="fim"
                                   value="<%= filtros.fim || '' %>">
                        </label>

                        <label class="maturidade-campo">
                            Fonte
                            <select required name="fonte">
                                <option value="">Selecione</option>
                                <option value="SINTETICA" <%= filtros.fonte === 'SINTETICA' ? 'selected' : '' %>>
                                    Sintética
                                </option>
                                <option value="OPERACIONAL" <%= filtros.fonte === 'OPERACIONAL' ? 'selected' : '' %>>
                                    Operacional
                                </option>
                            </select>
                        </label>
                    </div>

                    <details class="maturidade-detalhes">
                        <summary>Filtros da consulta</summary>

                        <div class="maturidade-filtros">
                            <label class="maturidade-campo">
                                Hash do snapshot sintético
                                <input name="snapshot" maxlength="64"
                                       pattern="[0-9a-fA-F]{64}"
                                       value="<%= filtros.snapshot || '' %>">
                            </label>

                            <label class="maturidade-campo">
                                ID do departamento autorizado
                                <input name="departamentoId" type="number" min="1"
                                       value="<%= filtros.departamentoId || '' %>">
                            </label>

                            <label class="maturidade-campo">
                                Departamento de origem (administrador)
                                <input name="departamentoOrigem"
                                       value="<%= filtros.departamentoOrigem || '' %>">
                            </label>

                            <label class="maturidade-campo">
                                Tipo de issue para produtividade
                                <input name="tipoIssue"
                                       value="<%= filtros.tipoIssue || '' %>">
                            </label>
                        </div>

                        <p class="maturidade-nota">
                            O escopo é validado no servidor. Funcionários anônimos
                            da origem são usados apenas de forma agregada e não
                            são convertidos em contas HestIA.
                        </p>
                    </details>

                    <button class="maturidade-botao" type="submit">
                        Consultar resultados
                    </button>
                </form>
            </section>

            <% if (erro) { %>
                <div class="maturidade-alerta" role="alert">
                    <%= erro %>
                </div>
            <% } %>

            <% if (resultado) { %>
                <section class="maturidade-card">
                    <h2>Resultado da consulta</h2>

                    <p class="maturidade-nota">
                        Fonte: <%= resultado.naturezaDados %>.
                        Período: <%= resultado.inicio %> a <%= resultado.fim %>.
                    </p>

                    <div class="maturidade-indicadores">
                        <div class="maturidade-indicador">
                            <span>Score global</span>
                            <strong>
                                <%= resultado.scoreGlobal == null
                                    ? 'Indisponível'
                                    : Number(resultado.scoreGlobal).toFixed(2) %>
                            </strong>
                        </div>

                        <div class="maturidade-indicador">
                            <span>Score parcial exploratório</span>
                            <strong>
                                <%= resultado.scoreParcial == null
                                    ? 'Indisponível'
                                    : Number(resultado.scoreParcial).toFixed(2) %>
                            </strong>
                        </div>

                        <div class="maturidade-indicador">
                            <span>Cobertura dos pesos elegíveis</span>
                            <strong>
                                <%= (100 * Number(resultado.coberturaPesos)).toFixed(2) %>%
                            </strong>
                        </div>
                    </div>

                    <p class="maturidade-nota">
                        Um resultado parcial não pode ser comparado ao índice completo.
                        Falta de dados não significa imaturidade.
                    </p>

                    <section class="legenda-qualidade" aria-label="Legenda da qualidade dos dados">
                        <h3>Qualidade dos dados</h3>

                        <p>
                            <span class="qualidade qualidade-fragil">Laranja: informação frágil</span>
                            — amostra, cobertura ou evidência insuficiente.

                            <span class="qualidade qualidade-suficiente">Verde: dados suficientes</span>
                            — critérios do indicador atendidos.

                            <span class="qualidade qualidade-indisponivel">Cinza: indisponível</span>
                            — sem dados ou configuração.
                        </p>

                        <p class="maturidade-nota">
                            Nos fatores com mínimo de amostra: pelo menos 30 observações
                            válidas e 95% de cobertura. Segurança e FinOps exigem o universo
                            completo. As cores indicam qualidade da informação, não desempenho;
                            verde não é garantia estatística.
                        </p>
                    </section>
                </section>

                <section class="maturidade-card">
                    <h2>Indicadores por fator</h2>

                    <div style="overflow-x:auto">
                        <table class="maturidade-tabela">
                            <thead>
                                <tr>
                                    <th>Fator</th>
                                    <th>Nota</th>
                                    <th>Estado</th>
                                    <th>Qualidade dos dados</th>
                                    <th>Amostra</th>
                                    <th>Cobertura técnica</th>
                                    <th>Elegível no global</th>
                                    <th>Motivo</th>
                                </tr>
                            </thead>

                            <tbody>
                                <% for (const fator of resultado.fatores) {
                                    const qualidade = qualidadeIndicador(fator);
                                %>
                                    <tr>
                                        <td><%= fator.codigo %></td>

                                        <td>
                                            <%= fator.nota == null
                                                ? 'Indisponível'
                                                : Number(fator.nota).toFixed(2) %>
                                        </td>

                                        <td><%= fator.estado %></td>

                                        <td>
                                            <span class="qualidade qualidade-<%= qualidade.classe %>">
                                                <%= qualidade.rotulo %>
                                            </span>
                                            <p><%= qualidade.detalhe %></p>
                                        </td>

                                        <td><%= fator.amostra %></td>

                                        <td>
                                            <%= fator.coberturaTecnica == null
                                                ? 'Desconhecida'
                                                : (100 * Number(fator.coberturaTecnica)).toFixed(2) + '%' %>
                                        </td>

                                        <td><%= fator.elegivelGlobal ? 'Sim' : 'Não' %></td>

                                        <td><%= fator.motivo %></td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>

                    <p class="maturidade-nota">
                        Pesos: <%= resultado.versaoPesos %>.
                        Cálculo: <%= resultado.versaoCalculo %>.
                        Parâmetros: <%= resultado.versaoParametros %>.
                    </p>

                    <% for (const aviso of resultado.avisos || []) { %>
                        <p class="maturidade-nota"><%= aviso %></p>
                    <% } %>
                </section>
            <% } %>

            <section class="maturidade-card">
                <h2>Metodologia e histórico</h2>

                <p>
                    <a href="/maturidade/metodologia/detalhes">
                        Entenda a metodologia e os limites dos indicadores
                    </a>
                </p>

                <%- include('integracao-apuracoes') %>
            </section>

        </div>
    </main>
</div>
</body>
</html>
