<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HestIA — Maturidade</title>

    <link rel="stylesheet" href="/styles.css">
    <link rel="stylesheet" href="/qualidade-indicadores.css">

    <style>

/* HestIA | identidade visual: marinho, creme, cobre e âmbar. Somente apresentação. */
:root { --h-navy:#14243c; --h-cream:#f8f6f2; --h-white:#ffffff; --h-copper:#b87346; --h-amber:#e9a044; --h-ink:#223249; --h-muted:#697586; --h-border:#e7e1d9; }
.main { min-width:0; background:var(--h-cream); }
.maturidade-conteudo { box-sizing:border-box; width:100%; max-width:1640px; margin:0 auto; padding:clamp(22px,2.8vw,44px); color:var(--h-ink); font-family:inherit; }
.maturidade-conteudo h1 { color:var(--h-navy); font-size:clamp(28px,2.35vw,38px); font-weight:800; letter-spacing:-.9px; line-height:1.2; margin:0 0 8px; }
.maturidade-descricao { color:var(--h-muted); font-size:14px; line-height:1.6; margin:0 0 25px; }
.maturidade-links { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:14px; margin:0 0 22px; }
.maturidade-links a { position:relative; box-sizing:border-box; display:flex; align-items:center; min-height:73px; padding:16px 42px 16px 20px; background:var(--h-white); border:1px solid var(--h-border); border-radius:12px; color:var(--h-navy); font-size:13px; font-weight:700; line-height:1.5; text-decoration:none; box-shadow:0 5px 16px rgba(27,32,39,.035); transition:transform .16s,box-shadow .16s,border-color .16s; }
.maturidade-links a::before { content:''; width:4px; position:absolute; left:0; top:16px; bottom:16px; background:var(--h-copper); border-radius:0 4px 4px 0; }
.maturidade-links a::after { content:'↗'; position:absolute; right:16px; color:var(--h-copper); font-size:21px; }
.maturidade-links a:hover { transform:translateY(-2px); border-color:#d8b69d; box-shadow:0 10px 22px rgba(42,30,20,.08); }
.maturidade-card { box-sizing:border-box; background:var(--h-white); border:1px solid var(--h-border); border-radius:16px; padding:25px 27px; margin:0 0 19px; box-shadow:0 6px 24px rgba(36,31,26,.035); }
.maturidade-card h2 { color:var(--h-navy); font-size:18px; letter-spacing:-.25px; font-weight:800; margin:0 0 16px; }
.maturidade-nota { color:var(--h-muted); font-size:12px; line-height:1.65; }
.maturidade-barra-consulta { background:#fffdfa; }
.maturidade-barra-consulta h2 { font-size:14px; margin:0 0 16px; }
.maturidade-filtros,.maturidade-barra-consulta .maturidade-filtros { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)) auto; align-items:end; gap:14px; margin:0; }
.maturidade-campo { display:flex; flex-direction:column; gap:7px; color:#596476; font-size:12px; font-weight:700; }
.maturidade-campo input,.maturidade-campo select { box-sizing:border-box; width:100%; min-height:45px; padding:10px 12px; color:var(--h-ink); background:#fff; border:1px solid #ded8d1; border-radius:9px; font:inherit; font-size:13px; }
.maturidade-campo input:focus,.maturidade-campo select:focus { outline:2px solid rgba(184,115,70,.22); border-color:var(--h-copper); }
.maturidade-botao { min-height:45px; padding:10px 24px; background:var(--h-navy); color:#fff; border:0; border-radius:9px; font-size:13px; font-weight:750; white-space:nowrap; cursor:pointer; transition:background .15s; }
.maturidade-botao:hover { background:#254265; }
.maturidade-detalhes { background:#fbfaf8; border:1px solid #ede7df; border-radius:9px; margin:14px 0 0; padding:12px 14px; }
.maturidade-detalhes summary { color:#746e68; cursor:pointer; font-size:12px; font-weight:650; }
.maturidade-detalhes .maturidade-filtros { grid-template-columns:repeat(2,minmax(0,1fr)); margin:15px 0 0; }
.maturidade-alerta { background:#fff4ed; border:1px solid #edc7b2; color:#8b3f26; border-radius:10px; padding:14px 16px; margin-bottom:16px; }
.maturidade-indicadores { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:15px; margin:17px 0 12px; }
.maturidade-indicador { position:relative; box-sizing:border-box; background:linear-gradient(140deg,#fbf9f6,#f5f1ea); border:1px solid #e9e1d8; border-radius:12px; padding:22px 22px 23px; min-height:120px; overflow:hidden; }
.maturidade-indicador::before { content:''; position:absolute; left:0; top:0; bottom:0; width:4px; background:var(--h-copper); }
.maturidade-indicador:nth-child(2)::before { background:var(--h-amber); }
.maturidade-indicador:nth-child(3)::before { background:var(--h-navy); }
.maturidade-indicador span { display:block; color:#746f69; font-size:12px; font-weight:650; margin-bottom:13px; }
.maturidade-indicador strong { display:block; color:var(--h-navy); font-size:clamp(21px,2.2vw,30px); font-weight:800; letter-spacing:-.6px; overflow-wrap:anywhere; }
.maturidade-qualidade-card { padding:23px 27px; }
.maturidade-qualidade-resumo { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:12px; }
.maturidade-qualidade-resumo span { box-sizing:border-box; display:flex; align-items:center; gap:7px; min-height:46px; background:#fbfaf8; border:1px solid #eee8e0; border-radius:9px; padding:10px 13px; color:#4c5663; font-size:12px; }
.maturidade-dot { display:inline-block; flex-shrink:0; width:10px; height:10px; border-radius:50%; }
.maturidade-dot.verde { background:#26865a; }.maturidade-dot.laranja { background:#d18a2e; }.maturidade-dot.cinza { background:#9aa3ae; }
.legenda-qualidade { margin:13px 0 0; padding:0; background:transparent; border:0; }
.legenda-qualidade summary { color:#9b5d39; cursor:pointer; font-size:12px; font-weight:700; }
.legenda-qualidade[open] summary { margin-bottom:10px; }
.maturidade-tabela-wrapper { margin-top:18px; overflow-x:auto; border:1px solid #e6dfd6; border-radius:11px; }
.maturidade-tabela { width:100%; border-collapse:collapse; }
.maturidade-tabela-completa { min-width:1120px; }
.maturidade-tabela-completa thead th { background:#f2eee8; color:#465161; text-transform:uppercase; letter-spacing:.35px; font-size:11px; font-weight:800; white-space:normal; }
.maturidade-tabela-completa th,.maturidade-tabela-completa td { text-align:left; vertical-align:middle; padding:15px 13px; border-bottom:1px solid #ece7e1; font-size:12px; line-height:1.55; }
.maturidade-tabela-completa tbody th { min-width:155px; font-size:13px; font-weight:750; color:var(--h-navy); }
.maturidade-tabela-completa tbody tr:nth-child(even) { background:#fcfaf7; }
.maturidade-tabela-completa tbody tr:hover { background:#f7f0e8; }
.maturidade-tabela-nota { font-weight:800; color:var(--h-navy); font-size:16px!important; white-space:nowrap; }
.maturidade-qualidade-detalhe { display:block; color:#79828e; font-size:11px; margin-top:5px; }
.maturidade-motivo-celula { min-width:180px; max-width:260px; color:#596474; }
/* Preserva semântica da qualidade e garante legibilidade dos badges externos */
.maturidade-tabela .qualidade { display:inline-block; border-radius:6px; padding:3px 7px; font-size:11px; font-weight:750; }
@media(max-width:1100px) { .maturidade-links { grid-template-columns:1fr; } .maturidade-filtros,.maturidade-barra-consulta .maturidade-filtros { grid-template-columns:repeat(2,minmax(0,1fr)); } .maturidade-qualidade-resumo { grid-template-columns:1fr; } }
@media(max-width:720px) { .maturidade-conteudo { padding:18px 13px; } .maturidade-card { padding:18px 15px; } .maturidade-indicadores,.maturidade-filtros,.maturidade-barra-consulta .maturidade-filtros,.maturidade-detalhes .maturidade-filtros { grid-template-columns:1fr; } .maturidade-botao { width:100%; } }


        /* Paleta HestIA — contraste corporativo: azul-marinho, cinza-azulado e cobre */
        :root { --hest-navy:#14243C; --hest-bg:#F1F5F9; --hest-card:#FFFFFF; --hest-copper:#B87346; --hest-amber:#E9A044; --hest-border:#DCE4EE; --hest-muted:#64748B; }
        body, .main { background:var(--hest-bg) !important; }
        .maturidade-conteudo { color:var(--hest-navy); }
        .maturidade-conteudo h1,.maturidade-conteudo h2,.maturidade-conteudo h3 { color:var(--hest-navy); }
        .maturidade-descricao,.maturidade-nota { color:var(--hest-muted); }
        .maturidade-card { background:var(--hest-card) !important; border-color:var(--hest-border) !important; box-shadow:0 6px 24px rgba(20,36,60,.055); }
        .maturidade-links a { background:#fff !important; color:var(--hest-navy) !important; border-color:var(--hest-border) !important; }
        .maturidade-links a::before { background:var(--hest-copper) !important; }
        .maturidade-links a::after { color:var(--hest-copper) !important; }
        .maturidade-links a:hover { background:#F8FAFC !important; border-color:#CDA184 !important; }
        .maturidade-barra-consulta { background:#fff !important; }
        .maturidade-campo { color:#34465D; }
        .maturidade-campo input,.maturidade-campo select { background:#F8FAFC !important; color:var(--hest-navy); border-color:var(--hest-border) !important; }
        .maturidade-campo input:focus,.maturidade-campo select:focus { border-color:var(--hest-copper) !important; box-shadow:0 0 0 3px rgba(184,115,70,.15) !important; }
        .maturidade-botao { background:var(--hest-navy) !important; color:#fff !important; box-shadow:0 5px 15px rgba(20,36,60,.15) !important; }
        .maturidade-botao:hover { background:#243C5B !important; }
        .maturidade-detalhes { background:#F8FAFC !important; border-color:var(--hest-border) !important; }
        .maturidade-detalhes summary,.legenda-qualidade summary { color:#59677A !important; }
        .maturidade-indicador { background:#fff !important; border-color:var(--hest-border) !important; }
        .maturidade-indicador::before { background:var(--hest-copper) !important; }
        .maturidade-indicador span { color:var(--hest-muted) !important; }
        .maturidade-indicador strong { color:var(--hest-navy) !important; }
        .maturidade-qualidade-resumo span { background:#F8FAFC !important; border-color:var(--hest-border) !important; color:#43546B !important; }
        .maturidade-tabela-wrapper { border-color:var(--hest-border) !important; }
        .maturidade-tabela-completa thead th { background:#E9EFF6 !important; color:var(--hest-navy) !important; border-color:var(--hest-border) !important; }
        .maturidade-tabela-completa tbody tr:nth-child(even) { background:#F8FAFC !important; }
        .maturidade-tabela-completa tbody tr:hover { background:#EDF3F8 !important; }
        .maturidade-tabela-completa tbody th,.maturidade-tabela-nota { color:var(--hest-navy) !important; }
        .maturidade-qualidade-detalhe,.maturidade-motivo-celula { color:#52637A !important; }
        .maturidade-alerta { background:#FFF6F0 !important; border-color:#E7B79B !important; color:#924D2B !important; }

    
/* Critérios de qualidade: identificação visual clara por cor */
.maturidade-criterios-cores { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:12px; margin-top:14px; }
.maturidade-criterio { display:flex; gap:11px; align-items:flex-start; padding:15px; border:1px solid; border-radius:11px; }
.maturidade-criterio-sinal { flex:none; width:12px; height:12px; border-radius:50%; margin-top:4px; }
.maturidade-criterio strong { display:block; font-size:12px; line-height:1.4; }
.maturidade-criterio p { margin:6px 0 0; font-size:12px; line-height:1.5; }
.maturidade-criterio-verde { background:#edf9f2; border-color:#b7e5c9; color:#17633d; }
.maturidade-criterio-verde .maturidade-criterio-sinal { background:#198754; }
.maturidade-criterio-laranja { background:#fff5e8; border-color:#f1d2a2; color:#97550c; }
.maturidade-criterio-laranja .maturidade-criterio-sinal { background:#e38b16; }
.maturidade-criterio-cinza { background:#f1f5f9; border-color:#d2dce6; color:#475569; }
.maturidade-criterio-cinza .maturidade-criterio-sinal { background:#8795a8; }
@media(max-width:900px) { .maturidade-criterios-cores { grid-template-columns:1fr; } }

</style>
</head>

<body>
<div class="app-shell">
    <%- include("menu", { perfil, email, active }) %>

    <main class="main">
        <div class="maturidade-conteudo">

            <h1>Maturidade em IA</h1>

            <div class="maturidade-links">
                <a href="/maturidade/simulacao-produtividade">
                    Comparar cenários simulados de produtividade
                </a>

                <a href="/maturidade/confiabilidade">
                    Indicadores operacionais e confiabilidade
                </a>

                <a href="/maturidade/metodologia/detalhes?<%= new URLSearchParams(filtros || {}).toString().replace(/&/g, '&amp;') %>">
                    Consultar metodologia e versões
                </a>
            </div>

            <section class="maturidade-card maturidade-barra-consulta">
                <h2>Período de análise</h2>

                <form method="get" action="/maturidade/resultados">

                    <div class="maturidade-filtros">
                        <label class="maturidade-campo">
                            Início
                            <input required type="date" name="inicio"
                                   value="<%= filtros.inicio || '' %>">
                        </label>

                        <label class="maturidade-campo">
                            Fim
                            <input required type="date" name="fim"
                                   value="<%= filtros.fim || '' %>">
                        </label>

                        <label class="maturidade-campo">
                            Fonte
                            <select required name="fonte">
                                <option value="">Selecione</option>
                                <option value="SINTETICA" <%= filtros.fonte === 'SINTETICA' ? 'selected' : '' %>>
                                    Sintética
                                </option>
                                <option value="OPERACIONAL" <%= filtros.fonte === 'OPERACIONAL' ? 'selected' : '' %>>
                                    Operacional
                                </option>
                            </select>
                        </label>
                        <button class="maturidade-botao" type="submit">Ver período</button>
                    </div>

                    <details class="maturidade-detalhes">
                        <summary>Filtros avançados (opcional)</summary>

                        <div class="maturidade-filtros">
                            <label class="maturidade-campo">
                                Hash do snapshot sintético
                                <input name="snapshot" maxlength="64"
                                       pattern="[0-9a-fA-F]{64}"
                                       value="<%= filtros.snapshot || '' %>">
                            </label>

                            <label class="maturidade-campo">
                                ID do departamento autorizado
                                <input name="departamentoId" type="number" min="1"
                                       value="<%= filtros.departamentoId || '' %>">
                            </label>

                            <label class="maturidade-campo">
                                Departamento de origem (administrador)
                                <input name="departamentoOrigem"
                                       value="<%= filtros.departamentoOrigem || '' %>">
                            </label>

                            <label class="maturidade-campo">
                                Tipo de issue para produtividade
                                <input name="tipoIssue"
                                       value="<%= filtros.tipoIssue || '' %>">
                            </label>
                        </div>
                    </details>

                </form>
            </section>

            <% if (erro) { %>
                <div class="maturidade-alerta" role="alert">
                    <%= erro %>
                </div>
            <% } %>

            <% if (resultado) { %>
                <section class="maturidade-card">
                    <h2>Resumo do período</h2>

                    <p class="maturidade-nota">
                        Fonte: <%= resultado.naturezaDados %>.
                        Período: <%= resultado.inicio %> a <%= resultado.fim %>.
                    </p>

                    <div class="maturidade-indicadores">
                        <div class="maturidade-indicador">
                            <span>Score global</span>
                            <strong>
                                <%= resultado.scoreGlobal == null
                                    ? 'Indisponível'
                                    : Number(resultado.scoreGlobal).toFixed(2) %>
                            </strong>
                        </div>

                        <div class="maturidade-indicador">
                            <span>Score parcial exploratório</span>
                            <strong>
                                <%= resultado.scoreParcial == null
                                    ? 'Indisponível'
                                    : Number(resultado.scoreParcial).toFixed(2) %>
                            </strong>
                        </div>

                        <div class="maturidade-indicador">
                            <span>Cobertura dos pesos elegíveis</span>
                            <strong>
                                <%= (100 * Number(resultado.coberturaPesos)).toFixed(2) %>%
                            </strong>
                        </div>
                    </div>


                </section>

                <section class="maturidade-card maturidade-qualidade-card" aria-label="Qualidade dos dados">
                    <h2>Qualidade dos dados</h2>
                    <div class="maturidade-qualidade-resumo">
                        <span><i class="maturidade-dot verde"></i> <strong>Verde:</strong> dados suficientes</span>
                        <span><i class="maturidade-dot laranja"></i> <strong>Laranja:</strong> informação frágil</span>
                        <span><i class="maturidade-dot cinza"></i> <strong>Cinza:</strong> indisponível</span>
                    </div>
                    <details class="legenda-qualidade" aria-label="Legenda da qualidade dos dados">
                        <summary>Ver critérios de avaliação</summary>

                        <div class="maturidade-criterios-cores">
                            <div class="maturidade-criterio maturidade-criterio-verde"><span class="maturidade-criterio-sinal" aria-hidden="true"></span><div><strong>Verde — Dados suficientes</strong><p>Os critérios de qualidade do indicador foram atendidos.</p></div></div>
                            <div class="maturidade-criterio maturidade-criterio-laranja"><span class="maturidade-criterio-sinal" aria-hidden="true"></span><div><strong>Laranja — Informação frágil</strong><p>A amostra, a cobertura ou as evidências são insuficientes.</p></div></div>
                            <div class="maturidade-criterio maturidade-criterio-cinza"><span class="maturidade-criterio-sinal" aria-hidden="true"></span><div><strong>Cinza — Indisponível</strong><p>Não existem dados ou configuração disponíveis para o indicador.</p></div></div>
                        </div>
                    </details>
                </section>

                <section class="maturidade-card">
                    <h2>Indicadores e notas</h2>

                    <% const nomesIndicadores = {
                        aiLiteracy: 'Alfabetização em IA',
                        governanca: 'Governança',
                        produtividade: 'Produtividade',
                        finOps: 'Gestão de custos',
                        seguranca: 'Segurança',
                        colaboracao: 'Colaboração',
                        desenvolvimentoCompetencias: 'Desenvolvimento de competências',
                        usoResponsavel: 'Uso responsável'
                    }; %>
                    <div class="maturidade-tabela-wrapper" role="region" aria-label="Indicadores e notas com dados técnicos" tabindex="0">
                        <table class="maturidade-tabela maturidade-tabela-completa">
                            <thead>
                                <tr>
                                    <th scope="col">Indicador</th>
                                    <th scope="col">Nota</th>
                                    <th scope="col">Estado</th>
                                    <th scope="col">Qualidade dos dados</th>
                                    <th scope="col">Amostra</th>
                                    <th scope="col">Cobertura técnica</th>
                                    <th scope="col">Elegível no global</th>
                                    <th scope="col">Motivo</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% for (const fator of resultado.fatores) {
                                    const qualidade = qualidadeIndicador(fator);
                                %>
                                    <tr>
                                        <th scope="row"><%= nomesIndicadores[fator.codigo] || fator.codigo %></th>
                                        <td class="maturidade-tabela-nota"><%= fator.nota == null ? '—' : Number(fator.nota).toFixed(2) %></td>
                                        <td><%= fator.estado %></td>
                                        <td>
                                            <span class="qualidade qualidade-<%= qualidade.classe %>"><%= qualidade.rotulo %></span>
                                            <span class="maturidade-qualidade-detalhe"><%= qualidade.detalhe %></span>
                                        </td>
                                        <td><%= fator.amostra %></td>
                                        <td><%= fator.coberturaTecnica == null ? 'Desconhecida' : (100 * Number(fator.coberturaTecnica)).toFixed(2) + '%' %></td>
                                        <td><%= fator.elegivelGlobal ? 'Sim' : 'Não' %></td>
                                        <td class="maturidade-motivo-celula"><%= fator.motivo %></td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>

                    <% const avisosOcultos = [
                          'Cálculo experimental: proposta 0.1 ainda sujeita à validação do grupo',
                          'Score parcial é exploratório e não comparável ao global',
                          'Populações sintética e operacional são mantidas separadas'
                      ]; %>
                      <% for (const aviso of resultado.avisos || []) { %>
                          <% if (!avisosOcultos.includes(String(aviso).trim().replace(/[.!]+$/, ''))) { %>
                              <p class="maturidade-nota"><%= aviso %></p>
                          <% } %>
                      <% } %>
                </section>
            <% } %>

        </div>
    </main>
</div>
</body>
</html>