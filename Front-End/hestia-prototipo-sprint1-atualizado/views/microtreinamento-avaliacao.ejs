<!DOCTYPE html><html lang="pt-BR"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Avaliação | HestIA</title><link rel="stylesheet" href="/styles.css"></head><body><div class="app-shell"><%- include("menu", {active: active, perfil: perfil}) %><main class="main-content"><section class="mt-page"><a class="mt-back" href="/microtreinamentos/<%= cursoId %>">← Voltar ao curso</a><div id="mt-exam" data-course="<%= cursoId %>" class="mt-panel" aria-live="polite">Carregando avaliação...</div></section></main></div><script>
// Microtreinamentos HestIA
// Funcoes simples com fetch, if, for e getElementById

let cursos = [];
let cursoAtual = null;
let filtroAtual = "todos";

function buscarDados(url, metodo, dados) {
    let opcoes = {
        method: metodo,
        headers: { "Content-Type": "application/json" }
    };

    if (dados != null) {
        opcoes.body = JSON.stringify(dados);
    }

    return fetch(url, opcoes).then(function(resposta) {
        return resposta.json().then(function(resultado) {
            if (!resposta.ok) {
                throw new Error(resultado.erro || "Erro na requisicao.");
            }
            return resultado;
        });
    });
}

function limparTexto(texto) {
    let elemento = document.createElement("div");
    elemento.textContent = texto;
    return elemento.innerHTML;
}

function porcentagem(curso) {
    if (curso.concluido) {
        return 100;
    }
    return Math.round(curso.etapa * 100 / curso.totalEtapas);
}

function carregarCursos() {
    let lista = document.getElementById("mt-list");
    lista.innerHTML = "Carregando cursos...";

    buscarDados("/api/microtreinamentos", "GET", null).then(function(resultado) {
        cursos = resultado.treinamentos;
        mostrarCursos();
    }).catch(function(erro) {
        lista.textContent = erro.message;
    });
}

function mostrarCursos() {
    let lista = document.getElementById("mt-list");
    let concluidos = 0;
    let andamento = 0;
    let disponiveis = 0;
    let html = "";

    for (let i = 0; i < cursos.length; i++) {
        let curso = cursos[i];

        if (curso.concluido) concluidos++;
        if (curso.etapa > 0 && !curso.concluido) andamento++;
        if (!curso.bloqueado) disponiveis++;

        let mostrar = true;
        if (filtroAtual == "recomendados" && !curso.recomendado) mostrar = false;
        if (filtroAtual == "andamento" && (curso.etapa == 0 || curso.concluido)) mostrar = false;
        if (filtroAtual == "concluidos" && !curso.concluido) mostrar = false;
        if (!mostrar) continue;

        let estado = "Disponivel";
        if (curso.bloqueado) estado = "Bloqueado";
        else if (curso.concluido) estado = "Concluido";
        else if (curso.etapa > 0) estado = "Em andamento";

        html += '<div class="mt-card">';
        html += '<div class="mt-card-top"><span class="mt-tag">🏅 ' + limparTexto(curso.nivel) + '</span>';
        html += '<span class="mt-tag">' + estado + '</span></div>';
        html += '<h3>' + limparTexto(curso.titulo) + '</h3>';
        html += '<p>' + limparTexto(curso.descricao) + '</p>';
        html += '<div class="mt-meta">' + curso.duracao + ' minutos | ' + curso.totalEtapas + ' aulas</div>';
        html += '<div class="mt-progress"><span style="width:' + porcentagem(curso) + '%"></span></div>';
        html += '<div class="mt-card-footer"><small>' + porcentagem(curso) + '% concluido</small>';

        if (curso.bloqueado) {
            html += '<small>' + limparTexto(curso.motivo) + '</small>';
        } else {
            html += '<a class="mt-btn mt-btn-primary" href="/microtreinamentos/' + encodeURIComponent(curso.id) + '">Abrir curso</a>';
        }
        html += '</div></div>';
    }

    document.getElementById("mt-total").textContent = disponiveis;
    document.getElementById("mt-done").textContent = concluidos;
    document.getElementById("mt-running").textContent = andamento;
    lista.innerHTML = html || '<div class="mt-empty">Nenhum curso encontrado.</div>';
}

function carregarCurso() {
    let tela = document.getElementById("mt-course");
    let id = tela.getAttribute("data-course");

    buscarDados("/api/microtreinamentos/" + id, "GET", null).then(function(resultado) {
        cursoAtual = resultado.treinamento;
        mostrarAula(cursoAtual.etapa);
    }).catch(function(erro) {
        tela.textContent = erro.message;
    });
}

function mostrarAula(numero) {
    let tela = document.getElementById("mt-course");
    let curso = cursoAtual;

    if (numero >= curso.licoes.length) {
        tela.innerHTML = '<h2>Conteudo concluido!</h2><p>Voce ja pode fazer a avaliacao.</p>' +
            '<a class="mt-btn mt-btn-primary" href="/microtreinamentos/' + curso.id + '/avaliacao">Fazer avaliacao</a>';
        return;
    }

    let aula = curso.licoes[numero];
    let html = '<p class="mt-step">Aula ' + (numero + 1) + ' de ' + curso.licoes.length + '</p>';
    html += '<h2 class="mt-lesson-title">' + limparTexto(aula.titulo) + '</h2>';
    html += '<div class="mt-lesson-text" style="white-space:pre-line;line-height:1.85">' + limparTexto(aula.texto) + '</div>';
    html += '<div class="mt-actions">';
    if (numero > 0) html += '<button class="mt-btn" id="voltarAula">Anterior</button>';
    html += '<button class="mt-btn mt-btn-primary" id="proximaAula">Concluir aula</button></div>';
    tela.innerHTML = html;

    if (numero > 0) {
        document.getElementById("voltarAula").addEventListener("click", function() {
            mostrarAula(numero - 1);
        });
    }

    document.getElementById("proximaAula").addEventListener("click", function() {
        let botao = document.getElementById("proximaAula");
        botao.disabled = true;

        if (numero < curso.etapa) {
            mostrarAula(numero + 1);
            return;
        }

        buscarDados("/api/microtreinamentos/" + curso.id + "/progresso", "POST", { etapa: numero + 1 })
            .then(function() {
                curso.etapa = numero + 1;
                mostrarAula(numero + 1);
            }).catch(function(erro) {
                alert(erro.message);
                botao.disabled = false;
            });
    });
}

function carregarAvaliacao() {
    let tela = document.getElementById("mt-exam");
    let id = tela.getAttribute("data-course");

    buscarDados("/api/microtreinamentos/" + id + "?avaliacao=1", "GET", null).then(function(resultado) {
        cursoAtual = resultado.treinamento;
        if (cursoAtual.etapa < cursoAtual.totalEtapas) {
            window.location.href = "/microtreinamentos/" + id;
            return;
        }
        mostrarAvaliacao();
    }).catch(function(erro) {
        tela.textContent = erro.message;
    });
}

function mostrarAvaliacao() {
    const tela = document.getElementById('mt-exam');
    let html = '<div class="academy-eyebrow">HESTIA ACADEMY · AVALIAÇÃO</div><h1 class="academy-heading">' + limparTexto(cursoAtual.titulo) + '</h1>' +
        '<p class="academy-subtitle">Avalie sua capacidade de tomar decisões seguras em situações reais.</p><div class="academy-exam-summary"><span>5 questões</span><span>Nota mínima: 80%</span><span>3 tentativas por ciclo</span></div><form id="formAvaliacao">';
    for (let i = 0; i < cursoAtual.questoes.length; i++) {
        const q = cursoAtual.questoes[i];
        html += '<fieldset class="academy-question"><legend><span>QUESTÃO ' + String(i + 1).padStart(2, '0') + '</span>' + limparTexto(q.pergunta) + '</legend>';
        for (let j = 0; j < q.opcoes.length; j++) {
            html += '<label class="academy-option"><input type="radio" name="questao' + i + '" value="' + j + '" required><span>' + String.fromCharCode(65 + j) + '</span><span>' + limparTexto(q.opcoes[j]) + '</span></label>';
        }
        html += '</fieldset>';
    }
    html += '<div id="resultadoAvaliacao" role="status" aria-live="polite"></div><div class="academy-exam-footer"><span id="academy-answered">0 de ' + cursoAtual.questoes.length + ' respondidas</span><button class="mt-btn mt-btn-primary" type="submit">Finalizar avaliação →</button></div></form>';
    tela.innerHTML = html;
    const form = document.getElementById('formAvaliacao');
    form.addEventListener('change', () => { const n = form.querySelectorAll('input[type="radio"]:checked').length; document.getElementById('academy-answered').textContent = n + ' de ' + cursoAtual.questoes.length + ' respondidas'; });
    form.addEventListener('submit', enviarAvaliacao);
}

// Atualiza o HestIA Pass apos a avaliacao, sem interromper a nota caso a consulta falhe.
function avisarAtualizacaoDoPasse() {
    fetch('/api/passe-hestia/status', { method: 'GET', credentials: 'same-origin', cache: 'no-store' })
        .then(function(resposta) { if (!resposta.ok) throw new Error('Status indisponivel'); return resposta.json(); })
        .then(function(dados) {
            window.dispatchEvent(new CustomEvent('hestia:passe-atualizado', { detail: dados }));
        })
        .catch(function() { /* A avaliacao ja foi registrada; o passe sera atualizado na proxima consulta. */ });
}

function enviarAvaliacao(evento) {
    evento.preventDefault();
    const form = document.getElementById('formAvaliacao');
    const resultado = document.getElementById('resultadoAvaliacao');
    const respostas = [];
    for (let i = 0; i < cursoAtual.questoes.length; i++) {
        const escolhida = form.querySelector('input[name="questao' + i + '"]:checked');
        if (!escolhida) { resultado.textContent = 'Responda todas as questões antes de enviar.'; return; }
        respostas.push(Number(escolhida.value));
    }
    const botao = form.querySelector('button[type="submit"]'); botao.disabled = true;
    buscarDados('/api/microtreinamentos/' + cursoAtual.id + '/avaliacao', 'POST', { respostas })
        .then(dados => {
            resultado.innerHTML = '<div class="academy-result ' + (dados.aprovado ? 'approved' : 'retry') + '"><div class="academy-result-score">' + limparTexto(String(dados.nota)) + '%</div><h2>' + (dados.aprovado ? 'Você foi aprovado!' : 'Continue aprendendo') + '</h2><p>' + limparTexto(dados.mensagem || '') + '</p><a class="mt-btn mt-btn-primary" href="/microtreinamentos">Voltar aos treinamentos</a></div>';
            if (dados.aprovado) {
                avisarAtualizacaoDoPasse();
                fetch('/api/certificacoes', { method: 'GET', cache: 'no-store' })
                  .catch(() => { /* A verificação também ocorre ao voltar à Academy. */ });
            }
            form.querySelectorAll('input').forEach(input => input.disabled = true);
            // A avaliação já foi enviada e gravada no backend. Não enviar novamente.
            botao.type = 'button';
            botao.disabled = false;
            botao.textContent = 'Voltar aos treinamentos →';
            botao.onclick = function () { window.location.assign('/microtreinamentos'); };
            if (dados.aprovado) {
                // Atualiza a lista a partir do banco; nunca marca como concluído só no navegador.
                buscarDados('/api/microtreinamentos', 'GET', null)
                    .catch(function (erro) { console.warn('Atualização do progresso:', erro.message); });
            }
        }).catch(erro => { resultado.textContent = erro.message; botao.disabled = false; });
}

if (document.getElementById("mt-list") != null) {
    let filtros = document.querySelectorAll("[data-filter]");
    for (let i = 0; i < filtros.length; i++) {
        filtros[i].addEventListener("click", function() {
            filtroAtual = filtros[i].getAttribute("data-filter");
            for (let j = 0; j < filtros.length; j++) filtros[j].classList.remove("active");
            filtros[i].classList.add("active");
            mostrarCursos();
        });
    }
    carregarCursos();
}
if (document.getElementById("mt-course") != null) carregarCurso();
if (document.getElementById("mt-exam") != null) carregarAvaliacao();

</script></body></html>