<!DOCTYPE html><html lang="pt-BR"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Metodologia | HestIA</title><link rel="stylesheet" href="/style.css"><style>main{max-width:1000px;margin:auto;padding:30px}article{padding:20px;border-bottom:1px solid #ddd}p{line-height:1.6;overflow-wrap:anywhere}</style></head><body><%- include('menu') %><main><h1>Como os indicadores são calculados</h1><p><%= metodologia.statusNotas %></p><p><%= metodologia.tratamentoAusencia %></p><% for(const fonte of metodologia.fontes){ %><article><h2><%= fonte.fator %></h2><p><strong>Fórmula:</strong> <%= fonte.formula || 'Consultar proposta 0.1 e versão preservada na apuração.' %></p><p><strong>Fonte:</strong> <%= fonte.fontePotencial %></p><p><strong>Unidade:</strong> <%= fonte.unidade || 'Nota derivada de 0 a 100' %></p><p><%= fonte.situacao %></p><p><%= fonte.referencia %></p></article><% } %><p><a href="/maturidade">Voltar aos resultados</a></p></main></body></html>
