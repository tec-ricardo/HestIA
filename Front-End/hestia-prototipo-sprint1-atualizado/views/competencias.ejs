<!DOCTYPE html>
<html lang="pt-BR">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0">

    <title>
        HestIA - Competências
    </title>

    <link
        rel="stylesheet"
        href="/styles.css">

</head>

<body>

    <div class="app-shell">

        <%- include("menu", {
            perfil: perfil,
            email: email,
            active: active
        }) %>


        <main class="main">

            <!-- TOPO -->

            <header class="topbar">

                <button
                    class="menu-button"
                    id="menuButton">

                    ☰

                </button>

                <div>

                    <p class="eyebrow">
                        Desenvolvimento
                    </p>

                    <h1>
                        Competências
                    </h1>

                </div>

                <div class="profile-switch">

                    <span>
                        <%= email %>
                    </span>

                </div>

                <a
                    class="topbar-logout"
                    href="/sair">

                    Sair

                </a>

            </header>


            <!-- COLABORADOR -->

            <% if (perfil == "colaborador") { %>

                <section class="grid two">

                    <article class="panel">

                        <div class="panel-head">

                            <h3>
                                AI Literacy
                            </h3>

                        </div>

                        <div class="empty-state">

                            A avaliação do nível de conhecimento
                            e capacidade no uso de Inteligência
                            Artificial será exibida aqui.

                        </div>

                    </article>


                    <article class="panel">

                        <div class="panel-head">

                            <h3>
                                Capacitações
                            </h3>

                        </div>

                        <form
                            class="form-grid"
                            onsubmit="return false;">

                            <label class="full">

                                Capacitação realizada

                                <input
                                    type="text"
                                    required>

                            </label>

                            <button
                                class="primary fake-save"
                                type="button">

                                Registrar capacitação

                            </button>

                        </form>

                    </article>


                    <article class="panel">

                        <div class="panel-head">

                            <h3>
                                Certificações
                            </h3>

                        </div>

                        <form
                            class="form-grid"
                            onsubmit="return false;">

                            <label class="full">

                                Certificação

                                <input
                                    type="text"
                                    required>

                            </label>

                            <button
                                class="primary fake-save"
                                type="button">

                                Registrar certificação

                            </button>

                        </form>

                    </article>

                </section>

            <% } %>


            <!-- ADMINISTRADOR -->

            <% if (perfil == "administrador") { %>

                <section class="grid two">

                    <article class="panel">

                        <div class="panel-head">

                            <h3>
                                Cadastrar competência
                            </h3>

                        </div>

                        <form
                            class="form-grid"
                            onsubmit="return false;">

                            <label class="full">

                                Competência

                                <input
                                    type="text"
                                    required>

                            </label>

                            <button
                                class="primary fake-save"
                                type="button">

                                Cadastrar competência

                            </button>

                        </form>

                    </article>


                    <article class="panel">

                        <div class="panel-head">

                            <h3>
                                Associar competência ao colaborador
                            </h3>

                        </div>

                        <form
                            class="form-grid"
                            onsubmit="return false;">

                            <label>

                                Colaborador

                                <input
                                    type="text"
                                    required>

                            </label>

                            <label>

                                Competência

                                <input
                                    type="text"
                                    required>

                            </label>

                            <button
                                class="primary fake-save"
                                type="button">

                                Associar competência

                            </button>

                        </form>

                    </article>

                </section>

            <% } %>


            <div
                class="toast"
                id="toast">

                Ação demonstrativa do protótipo visual.

            </div>

        </main>

    </div>


    <script src="/app.js"></script>

</body>

</html>