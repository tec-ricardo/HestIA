<!doctype html><html lang="pt-BR"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Fundamentos da avaliação — HestIA</title><link rel="stylesheet" href="/styles.css"></head><body><div class="app-shell"><%- include('menu',{perfil,email,active}) %><main class="main-content" style="padding:32px"><a href="/avaliacoes-automaticas">Voltar às avaliações</a><h1>Fundamentos do uso <%= id %></h1><section class="panel"><h2>Critérios e evidências preservadas</h2><% dados.criterios.forEach(c=>{ %><article><h3><%= c.criterio.replaceAll('_',' ') %></h3><p><%= c.estado.replaceAll('_',' ') %></p><p><%= c.fundamento %></p></article><% }) %></section><section class="panel"><h2>Histórico de tentativas</h2><% dados.tentativas.forEach(t=>{ %><p>Tentativa <%= t.tentativa %>: <%= t.estado %> — <%= t.registrada_em %></p><% }) %></section></main></div></body></html>
