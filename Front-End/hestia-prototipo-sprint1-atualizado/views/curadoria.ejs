
<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>Curadoria de Respostas | HestIA</title><link rel="stylesheet" href="/styles.css">
<style>
.cr-page{max-width:1200px;margin:0 auto;padding:28px}.cr-header{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap}.cr-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px;margin:22px 0}.cr-card,.cr-panel{background:#fff;border:1px solid #e2e8f0;border-radius:14px;padding:18px}.cr-card strong{display:block;font-size:28px;margin-top:8px}.cr-toolbar{display:flex;gap:10px;flex-wrap:wrap;margin:18px 0}.cr-toolbar input,.cr-toolbar select{border:1px solid #cbd5e1;border-radius:8px;padding:11px;font:inherit;min-width:190px}.cr-toolbar input{flex:1}.cr-table{width:100%;border-collapse:collapse}.cr-table th,.cr-table td{padding:13px;text-align:left;border-bottom:1px solid #e2e8f0;vertical-align:top}.cr-table th{font-size:13px;color:#64748b}.cr-btn{border:1px solid #cbd5e1;background:white;padding:9px 12px;border-radius:8px;cursor:pointer;font:inherit}.cr-btn:hover{background:#f1f5f9}.cr-primary{background:#3555d8;color:#fff;border-color:#3555d8}.cr-primary:hover{background:#2845b9}.cr-danger{color:#a11b2a}.cr-actions{display:flex;gap:8px;flex-wrap:wrap;margin:15px 0}.cr-muted{color:#64748b;font-size:13px}.cr-status{font-weight:700;font-size:12px}.cr-detail{margin-top:18px}.cr-history{padding-left:20px}.cr-history li{margin:8px 0}.cr-empty{padding:22px;color:#64748b}.cr-note{font-size:12px;color:#64748b}.cr-wrap{overflow-x:auto}.cr-badge{display:inline-block;padding:5px 9px;border-radius:999px;font-size:12px;font-weight:700;background:#f1f5f9;color:#334155}.cr-badge.aprovada{background:#dcfce7;color:#166534}.cr-badge.pendente{background:#fef3c7;color:#92400e}.cr-badge.bloqueada{background:#fee2e2;color:#991b1b}.cr-badge.retirada{background:#e2e8f0;color:#475569}.cr-demo{margin:10px 0;color:#64748b;font-size:12px}@media(max-width:780px){.cr-grid{grid-template-columns:repeat(2,1fr)}.cr-page{padding:15px}}
</style>
</head>
<body><div class="app-shell"><%- include('menu', {active:'curadoria', perfil:perfil}) %>
<main class="main-content"><section class="cr-page">
<div class="cr-header"><div><h1>Curadoria de Respostas</h1><p class="cr-muted">Revisão e gestão de respostas reutilizáveis do Assistente RAG</p></div><span class="cr-note">Administrador</span></div>
<p class="cr-demo">Respostas geradas pelo RAG aguardam revisão antes de serem disponibilizadas para reutilização.</p>
<div class="cr-grid"><div class="cr-card">Total<strong id="cr-total">0</strong></div><div class="cr-card">Pendentes<strong id="cr-pendente">0</strong></div><div class="cr-card">Aprovadas<strong id="cr-aprovada">0</strong></div><div class="cr-card">Bloqueadas/retiradas<strong id="cr-inativas">0</strong></div></div>
<div class="cr-panel"><div class="cr-toolbar"><input id="cr-busca" placeholder="Pesquisar pergunta ou resposta" aria-label="Pesquisar respostas"><select id="cr-filtro" aria-label="Filtrar status"><option value="">Todos os estados</option><option value="pendente">Pendente</option><option value="aprovada">Aprovada</option><option value="bloqueada">Bloqueada</option><option value="retirada">Retirada</option></select><button class="cr-btn" id="cr-atualizar" type="button">Atualizar</button></div>
<div class="cr-wrap"><table class="cr-table"><thead><tr><th>Pergunta</th><th>Política</th><th>Estado</th><th>Versão</th><th>Ações</th></tr></thead><tbody id="cr-linhas"><tr><td colspan="5">Carregando...</td></tr></tbody></table></div><p class="cr-note">Dados reais do servidor. Clique em Atualizar para consultar novamente.</p></div>
<div class="cr-panel cr-detail" id="cr-detalhes" hidden><h2>Detalhes da resposta</h2><h3 id="cr-pergunta"></h3><p id="cr-resposta"></p><p class="cr-muted" id="cr-politica"></p><p class="cr-muted" id="cr-qualidade"></p>
<div style="margin:14px 0;padding:14px;border:1px solid #e2e8f0;border-radius:10px;background:#f8fafc">
<label for="cr-nota"><strong>Avaliar qualidade da resposta (0 a 100)</strong></label>
<div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin-top:8px">
<input id="cr-nota" type="number" min="0" max="100" step="1" placeholder="Ex.: 85" style="padding:10px;border:1px solid #cbd5e1;border-radius:8px;width:125px" aria-describedby="cr-ajuda-nota">
<button id="cr-salvar-nota" type="button" class="cr-btn cr-primary" disabled title="A API atual não permite salvar nota de qualidade">Salvar avaliação</button>
</div>
<p id="cr-ajuda-nota" class="cr-note">A nota de qualidade ainda não possui endpoint de persistência; as decisões de revisão são registradas no servidor.</p>
</div>
<p class="cr-muted" id="cr-versao"></p><label for="cr-motivo">Motivo da decisão</label><input id="cr-motivo" style="display:block;width:100%;max-width:540px;padding:10px;margin:8px 0 16px;border:1px solid #cbd5e1;border-radius:8px" placeholder="Informe o motivo da alteração"><label style="display:block;margin:12px 0"><input type="checkbox" id="cr-verificado"> Revisei o conteúdo e confirmo que não contém dados sensíveis nem confidenciais e pode ser reutilizado pelos perfis autorizados.</label><div class="cr-actions"><button type="button" class="cr-btn cr-primary" data-acao="aprovada">Aprovar</button><button type="button" class="cr-btn" data-acao="bloqueada">Bloquear</button><button type="button" class="cr-btn cr-danger" data-acao="retirada">Retirar</button></div><h3>Histórico de revisões</h3><ol class="cr-history" id="cr-historico"></ol><p id="cr-mensagem" role="status"></p></div>
</section></main></div>
<script>
(function(){
'use strict';
const $=id=>document.getElementById(id);
const texto=(tag,valor)=>{const el=document.createElement(tag);el.textContent=valor==null?'—':String(valor);return el;};
let itens=[],selecionado=null,detalheAtual=null;
const estado=x=>String(x.status_qualidade||x.statusQualidade||'EM_REVISAO').toUpperCase();
const rotulo={EM_REVISAO:'pendente',APROVADA:'aprovada',BLOQUEADA:'bloqueada',RETIRADA:'retirada'};
async function requisicao(url,opcoes={}){const r=await fetch(url,{credentials:'same-origin',...opcoes});let dados;try{dados=await r.json();}catch(_){dados=null;}if(!r.ok)throw Error(dados?.erro||dados?.message||'Erro HTTP '+r.status);return dados;}
function mensagem(t){$('cr-mensagem').textContent=t;}
function renderizar(){
const busca=$('cr-busca').value.trim().toLowerCase(),filtro=$('cr-filtro').value,corpo=$('cr-linhas');corpo.replaceChildren();
const lista=itens.filter(x=>(!filtro||rotulo[estado(x)]===filtro)&&((x.prompt_original||x.promptOriginal||'')+' '+(x.categoria||'')).toLowerCase().includes(busca));
for(const x of lista){const tr=document.createElement('tr');tr.append(texto('td',x.prompt_original||x.promptOriginal),texto('td',x.categoria||'—'));const tdEstado=document.createElement('td'),b=texto('span',rotulo[estado(x)]||estado(x));b.className='cr-badge '+(rotulo[estado(x)]||'');tdEstado.append(b);tr.append(tdEstado,texto('td','—'));const td=document.createElement('td'),botao=texto('button','Ver detalhes');botao.type='button';botao.className='cr-btn';botao.addEventListener('click',()=>abrir(x.id));td.append(botao);tr.append(td);corpo.append(tr);}
if(!lista.length){const tr=document.createElement('tr'),td=texto('td','Nenhuma resposta encontrada.');td.colSpan=5;tr.append(td);corpo.append(tr);}
$('cr-total').textContent=itens.length;$('cr-pendente').textContent=itens.filter(x=>estado(x)==='EM_REVISAO').length;$('cr-aprovada').textContent=itens.filter(x=>estado(x)==='APROVADA').length;$('cr-inativas').textContent=itens.filter(x=>['BLOQUEADA','RETIRADA'].includes(estado(x))).length;
}
async function carregar(){try{itens=await requisicao('/api/admin/respostas?pagina=0&tamanho=100');if(!Array.isArray(itens))throw Error('Formato de lista inesperado');renderizar();}catch(e){itens=[];renderizar();mensagem('Não foi possível consultar a curadoria: '+e.message);}}
function preencher(d){const x=d.resposta||{},revisoes=Array.isArray(d.revisoes)?d.revisoes:[],versoes=Array.isArray(d.versoes)?d.versoes:[];$('cr-detalhes').hidden=false;$('cr-pergunta').textContent=x.promptOriginal||'—';$('cr-resposta').textContent=x.respostaGerada||'—';$('cr-politica').textContent='Categoria: '+(x.categoria||'Não informada');$('cr-qualidade').textContent='Avaliação numérica não disponível na API atual';$('cr-nota').value='';$('cr-versao').textContent='Estado: '+(rotulo[estado(x)]||estado(x))+' | Versões registradas: '+versoes.length;const h=$('cr-historico');h.replaceChildren();if(!revisoes.length)h.append(texto('li','Nenhuma revisão registrada.'));for(const r of revisoes){h.append(texto('li',String(r.revisada_em||'')+' — '+String(r.estado_anterior||'')+' → '+String(r.estado_atual||'')+' ('+String(r.justificativa||'')+')'));}}
async function abrir(id){try{selecionado=id;mensagem('');$('cr-motivo').value='';$('cr-verificado').checked=false;detalheAtual=await requisicao('/api/admin/respostas/'+encodeURIComponent(id));preencher(detalheAtual);$('cr-detalhes').scrollIntoView({behavior:'smooth',block:'start'});}catch(e){mensagem('Falha ao consultar detalhes: '+e.message);}}
for(const b of document.querySelectorAll('[data-acao]'))b.addEventListener('click',async()=>{if(selecionado==null)return;const mapa={aprovada:'APROVADA',bloqueada:'BLOQUEADA',retirada:'RETIRADA'},status=mapa[b.dataset.acao],justificativa=$('cr-motivo').value.trim();if(!justificativa){mensagem('Informe o motivo da decisão.');return;}if(status==='APROVADA'&&!$('cr-verificado').checked){mensagem('Para aprovar, confirme a revisão dos dados sensíveis.');return;}if(!confirm('Confirmar alteração para '+status+'?'))return;try{b.disabled=true;await requisicao('/api/admin/respostas/'+encodeURIComponent(selecionado)+'/revisoes',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({status,justificativa,expiraEm:null,dadosSensiveisVerificados:status==='APROVADA'&&$('cr-verificado').checked})});await carregar();await abrir(selecionado);mensagem('Revisão registrada no servidor.');}catch(e){mensagem('Não foi possível salvar a revisão: '+e.message);}finally{b.disabled=false;}});
$('cr-busca').addEventListener('input',renderizar);$('cr-filtro').addEventListener('change',renderizar);$('cr-atualizar').addEventListener('click',carregar);carregar();
})();
</script></body></html>
