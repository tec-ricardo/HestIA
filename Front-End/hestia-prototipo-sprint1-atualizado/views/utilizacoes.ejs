<!DOCTYPE html>
<html lang="pt-BR">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0">

    <title>
        HestIA - Utilizações de IA
    </title>

    <link
        rel="stylesheet"
        href="/styles.css">

</head>

<body>

    <div class="app-shell">

        <%- include("menu", {
            perfil: perfil,
            email: email,
            active: active
        }) %>


        <main class="main">

            <!-- TOPO -->

            <header class="topbar">

                <button
                    class="menu-button"
                    id="menuButton">

                    ☰

                </button>

                <div>

                    <p class="eyebrow">
                        Colaborador
                    </p>

                    <h1>
                        Utilizações de IA
                    </h1>

                </div>

                <div class="profile-switch">

                    <span>
                        <%= email %>
                    </span>

                    <select disabled>

                        <option selected>
                            Colaborador
                        </option>

                    </select>

                </div>

                <a
                    class="topbar-logout"
                    href="/sair">

                    Sair

                </a>

            </header>


            <!-- REGISTRO -->

            <section class="panel">

                <div class="panel-head">

                    <h3>
                        Registrar utilização de IA
                    </h3>

                </div>


                <form
                    class="form-grid"
                    onsubmit="return false;">


                    <label>

                        Usuário

                        <input
                            type="text"
                            value="<%= email %>"
                            required>

                    </label>


                    <label>

                        Modelo utilizado

                        <input
                            type="text"
                            placeholder="Modelo ou ferramenta de IA"
                            required>

                    </label>


                    <label>

                        Data

                        <input
                            type="date"
                            required>

                    </label>


                    <label>

                        Informações de consumo

                        <input
                            type="text"
                            placeholder="Consumo">

                    </label>


                    <label class="full">

                        Finalidade

                        <input
                            type="text"
                            placeholder="Finalidade da utilização"
                            required>

                    </label>


                    <button
                        class="primary fake-save"
                        type="button">

                        Registrar utilização

                    </button>

                </form>

            </section>


            <!-- HISTORICO -->

            <section class="panel">

                <div class="panel-head">

                    <div>

                        <h3>
                            Histórico de utilizações
                        </h3>

                        <p class="conformidade-description">
                            Consulte suas utilizações de IA e o status de conformidade.
                        </p>

                    </div>

                </div>


                <div class="table-wrap">

                    <table>

                        <thead>

                            <tr>

                                <th>
                                    Usuário
                                </th>

                                <th>
                                    Modelo
                                </th>

                                <th>
                                    Data
                                </th>

                                <th>
                                    Consumo
                                </th>

                                <th>
                                    Finalidade
                                </th>

                                <th>
                                    Conformidade
                                </th>

                            </tr>

                        </thead>


                        <tbody>


                            <!-- CONFORME -->

                            <tr>

                                <td>
                                    w@colaborador
                                </td>

                                <td>
                                    ChatGPT
                                </td>

                                <td>
                                    22/09/2026
                                </td>

                                <td>
                                    1.250 tokens
                                </td>

                                <td>
                                    Resumo de documento
                                </td>

                                <td>

                                    <strong style="color: #198754;">
                                        Conforme
                                    </strong>

                                </td>

                            </tr>


                            <!-- CONFORME -->

                            <tr>

                                <td>
                                    w@colaborador
                                </td>

                                <td>
                                    Copilot
                                </td>

                                <td>
                                    21/09/2026
                                </td>

                                <td>
                                    980 tokens
                                </td>

                                <td>
                                    Apoio na elaboração de relatório
                                </td>

                                <td>

                                    <strong style="color: #198754;">
                                        Conforme
                                    </strong>

                                </td>

                            </tr>


                            <!-- NAO CONFORME -->

                            <tr>

                                <td>
                                    w@colaborador
                                </td>

                                <td>
                                    ChatGPT
                                </td>

                                <td>
                                    20/09/2026
                                </td>

                                <td>
                                    1.540 tokens
                                </td>

                                <td>
                                    Análise de dados
                                </td>

                                <td>

                                    <strong style="color: #dc3545;">
                                        Não conforme
                                    </strong>

                                </td>

                            </tr>


                            <!-- AGUARDANDO AVALIACAO -->

                            <tr>

                                <td>
                                    w@colaborador
                                </td>

                                <td>
                                    Copilot
                                </td>

                                <td>
                                    23/09/2026
                                </td>

                                <td>
                                    760 tokens
                                </td>

                                <td>
                                    Geração de apresentação
                                </td>

                                <td>

                                    <strong style="color: #6c757d;">
                                        Aguardando avaliação
                                    </strong>

                                </td>

                            </tr>


                        </tbody>

                    </table>

                </div>


                <p class="dashboard-demo">
                    Dados demonstrativos utilizados para representação do wireframe.
                </p>

            </section>


            <div
                class="toast"
                id="toast">

                Ação demonstrativa do protótipo visual.

            </div>

        </main>

    </div>


    <script src="/app.js"></script>

</body>

</html>