<!DOCTYPE html>
<html lang="pt-BR">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0">

    <title>
        HestIA - Utilizações de IA
    </title>

    <link
        rel="stylesheet"
        href="/styles.css">

</head>

<body>

    <div class="app-shell">

        <%- include("menu", {
            perfil: perfil,
            email: email,
            active: active
        }) %>


        <main class="main">

            <!-- TOPO -->

            <header class="topbar">

                <button
                    class="menu-button"
                    id="menuButton">

                    ☰

                </button>

                <div>

                    <p class="eyebrow">
                        Colaborador
                    </p>

                    <h1>
                        Utilizações de IA
                    </h1>

                </div>

                <div class="profile-switch">

                    <span>
                        <%= email %>
                    </span>

                    <select disabled>

                        <option selected>
                            Colaborador
                        </option>

                    </select>

                </div>

                <a
                    class="topbar-logout"
                    href="/sair">

                    Sair

                </a>

            </header>


            <!-- REGISTRO -->

            <section class="panel">

                <div class="panel-head">

                    <h3>
                        Registrar utilização de IA
                    </h3>

                </div>


                <form
                    class="form-grid"
                    id="formUtilizacao">


                    <label>

                        Usuário

                        <input
                            type="text"
                            id="usuarioUtilizacao"
                            value="<%= email %>"
                            readonly>

                    </label>


                    <label>

                        Modelo utilizado

                        <input
                            type="text"
                            id="modeloUtilizacao"
                            placeholder="Modelo ou ferramenta de IA"
                            required>

                    </label>


                    <label>

                        Data

                        <input
                            type="date"
                            id="dataUtilizacao"
                            required>

                    </label>


                    <label>

                        Informações de consumo

                        <input
                            type="text"
                            id="consumoUtilizacao"
                            placeholder="Consumo">

                    </label>


                    <label class="full">

                        Finalidade

                        <input
                            type="text"
                            id="finalidadeUtilizacao"
                            placeholder="Finalidade da utilização"
                            required>

                    </label>


                    <button
                        class="primary"
                        type="submit">

                        Registrar utilização

                    </button>

                </form>

                <!-- CONFIRMAÇÃO DO REGISTRO -->

                <p
                    id="mensagemUtilizacao"
                    role="status"
                    aria-live="polite"
                    style="display: none; color: #15803d; margin-top: 15px;">

                    Utilização registrada com sucesso!

                </p>

            </section>


            <!-- HISTORICO -->

            <section class="panel">

                <div class="panel-head">

                    <div>

                        <h3>
                            Histórico de utilizações
                        </h3>

                        <p class="conformidade-description">
                            Consulte suas utilizações de IA e o status de conformidade.
                        </p>

                    </div>

                </div>


                <div class="table-wrap">

                    <table>

                        <thead>

                            <tr>

                                <th>
                                    Usuário
                                </th>

                                <th>
                                    Modelo
                                </th>

                                <th>
                                    Data
                                </th>

                                <th>
                                    Consumo
                                </th>

                                <th>
                                    Finalidade
                                </th>

                                <th>
                                    Conformidade
                                </th>

                            </tr>

                        </thead>


                        <tbody id="historicoUtilizacoes">

                            <tr>

                                <td>
                                    w@colaborador
                                </td>

                                <td>
                                    ChatGPT
                                </td>

                                <td>
                                    22/09/2026
                                </td>

                                <td>
                                    1.250 tokens
                                </td>

                                <td>
                                    Resumo de documento
                                </td>

                                <td>
                                    Conforme
                                </td>

                            </tr>


                            <tr>

                                <td>
                                    w@colaborador
                                </td>

                                <td>
                                    Copilot
                                </td>

                                <td>
                                    21/09/2026
                                </td>

                                <td>
                                    980 tokens
                                </td>

                                <td>
                                    Apoio na elaboração de relatório
                                </td>

                                <td>
                                    Conforme
                                </td>

                            </tr>


                            <tr>

                                <td>
                                    w@colaborador
                                </td>

                                <td>
                                    ChatGPT
                                </td>

                                <td>
                                    20/09/2026
                                </td>

                                <td>
                                    1.540 tokens
                                </td>

                                <td>
                                    Análise de dados
                                </td>

                                <td>
                                    Não conforme
                                </td>

                            </tr>


                            <tr>

                                <td>
                                    w@colaborador
                                </td>

                                <td>
                                    Copilot
                                </td>

                                <td>
                                    23/09/2026
                                </td>

                                <td>
                                    760 tokens
                                </td>

                                <td>
                                    Geração de apresentação
                                </td>

                                <td>
                                    Aguardando avaliação
                                </td>

                            </tr>

                        </tbody>

                    </table>

                </div>


                <p class="dashboard-demo">
                    Dados demonstrativos utilizados para representação do wireframe.
                </p>

            </section>


            <div
                class="toast"
                id="toast">

                Ação demonstrativa do protótipo visual.

            </div>

        </main>

    </div>


    <script src="/app.js"></script>

    <!-- REGISTRO DE UTILIZAÇÕES - FRONT-END -->

    <script>

        const formUtilizacao = document.getElementById("formUtilizacao");

        const historicoUtilizacoes = document.getElementById("historicoUtilizacoes");

        const mensagemUtilizacao = document.getElementById("mensagemUtilizacao");


        function adicionarUtilizacao(registro) {

            const novaLinha = document.createElement("tr");

            const valores = [
                registro.usuario,
                registro.modelo,
                registro.data,
                registro.consumo,
                registro.finalidade,
                "Aguardando avaliação"
            ];

            valores.forEach(function(valor) {

                const coluna = document.createElement("td");

                coluna.textContent = valor;

                novaLinha.appendChild(coluna);

            });

            historicoUtilizacoes.prepend(novaLinha);

        }


        formUtilizacao.addEventListener("submit", function(event) {

            event.preventDefault();

            const usuario = document.getElementById("usuarioUtilizacao").value;

            const modelo = document.getElementById("modeloUtilizacao").value.trim();

            const data = document.getElementById("dataUtilizacao").value;

            const consumo = document.getElementById("consumoUtilizacao").value.trim();

            const finalidade = document.getElementById("finalidadeUtilizacao").value.trim();


            if (!modelo || !data || !finalidade) {

                alert("Preencha todos os campos obrigatórios.");

                return;

            }


            const registro = {

                usuario: usuario,

                modelo: modelo,

                data: data.split("-").reverse().join("/"),

                consumo: consumo || "Não informado",

                finalidade: finalidade

            };


            adicionarUtilizacao(registro);


            mensagemUtilizacao.style.display = "block";


            formUtilizacao.reset();

        });

    </script>

</body>

</html>