<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>HestIA — Ocorrências</title>
  <link rel="stylesheet" href="/styles.css">
  <style>
    .oc-page{padding:8px 0 35px}.oc-panel{background:#fff;border:1px solid #dce3ee;border-radius:12px;padding:22px;margin:18px 0}.oc-head{display:flex;justify-content:space-between;align-items:end;gap:15px;flex-wrap:wrap}.oc-head h2{margin:0}.oc-muted{color:#64748b}.oc-table{overflow-x:auto;margin-top:15px}.oc-table table{width:100%;border-collapse:collapse}.oc-table th,.oc-table td{padding:13px 10px;text-align:left;border-bottom:1px solid #e5eaf2}.oc-table th{color:#64748b;font-size:12px}.oc-pill{display:inline-block;border-radius:99px;background:#f1f5f9;padding:5px 10px;font-size:12px}.oc-pill.ABERTA{background:#fff1dc;color:#875300}.oc-pill.EM_TRATAMENTO{background:#e8efff;color:#284db1}.oc-pill.RESOLVIDA{background:#e3f7ec;color:#216b44}.oc-alert{padding:12px 15px;border-radius:8px;background:#fff0f0;color:#a32a2a;margin:15px 0}.oc-pages{display:flex;justify-content:flex-end;align-items:center;gap:15px;margin-top:18px}.oc-pages a,.oc-table a{color:#2545a5;font-weight:600}select{border:1px solid #cbd5e1;border-radius:8px;padding:10px;background:#fff;color:#18263d;font:inherit}
  </style>
</head>
<body>
<div class="app-shell">
  <%- include("menu", {perfil, email, active}) %>
  <main class="main">
    <header class="topbar">
      <button class="menu-button" id="menuButton" aria-label="Abrir menu">☰</button>
      <div><p class="eyebrow">Governança</p><h1>Gestão de ocorrências</h1></div>
      <div class="profile-switch"><span><%= email %></span></div>
      <a class="topbar-logout" href="/sair">Sair</a>
    </header>
    <div class="oc-page">
      <p class="oc-muted">Tratamentos de não conformidade da sua empresa e do seu escopo de acesso.</p>
      <section class="oc-panel">
        <div class="oc-head">
          <div><h2>Ocorrências registradas</h2><% if (!erro) { %><p class="oc-muted"><%= totalItens %> tratamento(s) neste filtro.</p><% } %></div>
          <form action="/ocorrencias" method="get">
            <label for="statusFiltro">Status</label>
            <select id="statusFiltro" name="status" onchange="this.form.submit()">
              <option value="">Todos</option>
              <% Object.entries(nomesStatus).forEach(([codigo, nome]) => { %>
                <option value="<%= codigo %>" <%= status === codigo ? "selected" : "" %>><%= nome %></option>
              <% }); %>
            </select>
            <noscript><button type="submit">Filtrar</button></noscript>
          </form>
        </div>
        <% if (erro) { %>
          <div class="oc-alert" role="alert"><%= erro %> <% if (erro.includes("sessão")) { %><a href="/acesso">Entrar novamente</a><% } %></div>
        <% } else if (itens.length === 0) { %>
          <p class="oc-muted">Nenhuma ocorrência encontrada.</p>
        <% } else { %>
          <div class="oc-table"><table>
            <thead><tr><th>ID</th><th>Avaliação</th><th>Departamento</th><th>Responsável</th><th>Aberta em</th><th>Status</th><th></th></tr></thead>
            <tbody>
              <% itens.forEach(item => { %>
                <tr>
                  <td>#<%= item.id %></td><td>#<%= item.avaliacaoId %></td>
                  <td><%= item.departamentoId ?? "Não informado" %></td>
                  <td><%= item.responsavelId ?? "Não definido" %></td>
                  <td><%= item.criadoEm ? new Date(item.criadoEm).toLocaleString("pt-BR") : "Não informada" %></td>
                  <td><span class="oc-pill <%= item.status %>"><%= nomesStatus[item.status] || item.status %></span></td>
                  <td><a href="/ocorrencias/<%= item.id %>">Ver detalhes</a></td>
                </tr>
              <% }); %>
            </tbody>
          </table></div>
        <% } %>
        <% if (!erro && totalPaginas > 1) { %>
          <nav class="oc-pages" aria-label="Páginas de ocorrências">
            <% if (pagina > 0) { %><a href="/ocorrencias?status=<%= encodeURIComponent(status) %>&pagina=<%= pagina - 1 %>">Anterior</a><% } %>
            <span>Página <%= pagina + 1 %> de <%= totalPaginas %></span>
            <% if (pagina + 1 < totalPaginas) { %><a href="/ocorrencias?status=<%= encodeURIComponent(status) %>&pagina=<%= pagina + 1 %>">Próxima</a><% } %>
          </nav>
        <% } %>
      </section>
    </div>
  </main>
</div>
<script src="/app.js"></script>
</body>
</html>
