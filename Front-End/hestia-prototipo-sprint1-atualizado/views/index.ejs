<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HestIA - Visão Geral</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
<div class="app-shell">
    <%- include("menu", { perfil, email, active }) %>
    <main class="main">
        <header class="topbar">
            <button class="menu-button" id="menuButton">☰</button>
            <div><p class="eyebrow">Plataforma corporativa</p><h1>Visão geral</h1></div>
            <div class="profile-switch"><span><%= email %></span></div>
            <a class="topbar-logout" href="/sair">Sair</a>
        </header>

        <section class="hero-card">
            <p class="eyebrow"><%= perfil === 'colaborador' ? 'Minha jornada' : 'Visão organizacional' %></p>
            <h2><%= perfil === 'colaborador' ? 'Seu progresso no uso responsável de IA' : 'Governança e adoção de IA na empresa' %></h2>
            <p>Os valores abaixo vêm dos registros atuais da plataforma e são atualizados a cada acesso.</p>
        </section>

        <% if (perfil === 'colaborador') { %>
            <section class="dashboard-summary">
                <article class="dashboard-summary-card"><span>HestIA Pass</span><strong><%= resumo.xp === null ? '—' : resumo.xp + ' XP' %></strong><p><%= resumo.nivel || 'Progresso indisponível' %></p></article>
                <article class="dashboard-summary-card"><span>AI Credits</span><strong><%= resumo.creditos === null ? '—' : resumo.creditos %></strong><p>Mesmo histórico validado do Passe</p></article>
                <article class="dashboard-summary-card"><span>Ranking</span><strong><%= resumo.posicao ? resumo.posicao + 'º' : '—' %></strong><p><%= resumo.participantes %> participante<%= resumo.participantes === 1 ? '' : 's' %> com pontuação</p></article>
                <article class="dashboard-summary-card"><span>Registros de uso</span><strong><%= resumo.totalRegistros %></strong><p><%= resumo.registrosComSucesso %> execuções concluídas com sucesso</p></article>
            </section>

            <section class="grid two">
                <article class="panel">
                    <div class="panel-head"><div><h3>Evolução no HestIA Pass</h3><p>Progresso calculado pelo backend.</p></div></div>
                    <% if (resumo.xp === null) { %><p class="muted">Progresso indisponível.</p><% } else { %>
                        <h2><%= resumo.nivel %></h2>
                        <div class="personal-xp-progress"><div class="personal-xp-progress-value" style="width:<%= resumo.percentualProgresso %>%"></div></div>
                        <p><%= resumo.xpProximoNivel === null ? 'Nível máximo alcançado.' : resumo.percentualProgresso + '% do caminho para o próximo nível.' %></p>
                        <a class="personal-card-link" href="/passe-hestia">Ver HestIA Pass →</a>
                    <% } %>
                </article>
                <article class="panel">
                    <div class="panel-head"><div><h3>Uso registrado</h3><p>Dados associados à sua conta.</p></div></div>
                    <div class="list-clean"><span><strong><%= resumo.totalRegistros %></strong> utilizações registradas</span><span><strong><%= resumo.tokensRegistrados.toLocaleString('pt-BR') %></strong> tokens informados</span><span><strong><%= resumo.registrosComSucesso %></strong> execuções bem-sucedidas</span></div>
                    <a class="personal-card-link" href="/utilizacoes/registros">Ver registros →</a>
                </article>
            </section>

            <section class="panel">
                <div class="panel-head"><div><h3>Atividade recente</h3><p>Últimos registros encontrados no banco.</p></div></div>
                <% if (!resumo.atividadeRecente.length) { %><p class="muted">Nenhuma utilização registrada.</p><% } else { %>
                    <div class="table-wrap"><table><thead><tr><th>Ferramenta</th><th>Modelo</th><th>Finalidade</th><th>Status</th><th>Data</th></tr></thead><tbody>
                    <% resumo.atividadeRecente.forEach(item => { %><tr><td><%= item.ferramentaNome %></td><td><%= item.modeloIa %></td><td><%= item.finalidade %></td><td><%= item.statusExecucao %></td><td><%= new Date(item.dataHora).toLocaleString('pt-BR') %></td></tr><% }) %>
                    </tbody></table></div>
                <% } %>
            </section>
        <% } else { %>
            <section class="dashboard-summary">
                <article class="dashboard-summary-card"><span>Empresas</span><strong><%= indicadores.empresas %></strong><p>Cadastros acessíveis</p></article>
                <article class="dashboard-summary-card"><span>Departamentos</span><strong><%= indicadores.departamentos %></strong><p>Estruturas cadastradas</p></article>
                <article class="dashboard-summary-card"><span>Usuários</span><strong><%= indicadores.usuarios %></strong><p>Contas cadastradas</p></article>
                <article class="dashboard-summary-card"><span>Ferramentas</span><strong><%= indicadores.ferramentas %></strong><p>Ferramentas de IA cadastradas</p></article>
            </section>
            <section class="grid two">
                <article class="panel">
                    <div class="panel-head"><div><h3>AI Maturity Score</h3><p>Apuração parcial com a base sintética da QSoft.</p></div></div>
                    <h2><%= resumo.maturidadeParcial === null ? 'Não disponível' : resumo.maturidadeParcial.toFixed(2) + ' / 100' %></h2>
                    <p><%= resumo.coberturaMaturidade === null ? 'Cobertura não disponível.' : 'Cobertura dos pesos elegíveis: ' + resumo.coberturaMaturidade + '%.' %></p>
                    <a class="personal-card-link" href="/maturidade">Ver apuração →</a>
                </article>
                <article class="panel">
                    <div class="panel-head"><div><h3>Operação registrada</h3><p>Uso de IA presente no banco operacional.</p></div></div>
                    <div class="list-clean"><span><strong><%= resumo.totalRegistros %></strong> utilizações</span><span><strong><%= resumo.tokensRegistrados.toLocaleString('pt-BR') %></strong> tokens informados</span><span><strong><%= indicadores.politicas %></strong> políticas cadastradas</span></div>
                </article>
            </section>
        <% } %>
    </main>
</div>
<script src="/app.js"></script>
</body>
</html>
