<!doctype html><html lang="pt-BR"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Revisão do catálogo — HestIA</title><link rel="stylesheet" href="/styles.css"></head><body><div class="app-shell"><%- include('menu',{perfil,email,active}) %><main class="main-content" style="padding:32px"><a href="/catalogo-real">Voltar ao catálogo</a><h1><%= item.titulo %></h1><p><%= item.estado %> · Referência <%= item.id %> · Versão anterior <%= item.anterior_id||'Nenhuma' %></p><section class="panel"><h2>Metadados e revisão</h2><dl><% [['descricao','Resumo'],['tema','Tema'],['duracao_minutos','Duração (minutos)'],['fonte','Fonte e acesso'],['autorizacao_uso','Autoria e autorização'],['objetivo','Objetivo'],['publico','Público, idioma e pré-requisitos'],['atividade','Atividade prática'],['criterio_aceite','Critério de aceite'],['conteudo_sha256','Identificação da versão'],['evidencia_revisao','Evidência da revisão'],['motivo_retirada','Motivo da retirada']].forEach(([k,label])=>{ %><dt><strong><%= label %></strong></dt><dd style="white-space:pre-wrap"><%= item[k]||'Não informado' %></dd><% }) %></dl></section><section class="panel"><h2>Conteúdo</h2><div style="white-space:pre-wrap"><%= item.conteudo %></div></section><section class="panel"><h2>Avaliação (consulta restrita à curadoria)</h2><% const questoes=typeof item.questionario==='string'?JSON.parse(item.questionario):item.questionario;questoes.forEach(q=>{ %><article><h3><%= q.enunciado %></h3><ul><% Object.entries(q.alternativas).forEach(([k,v])=>{ %><li><%= k %>: <%= v %></li><% }) %></ul><p>Correta: <%= q.correta %>. <%= q.explicacao %></p></article><% }) %></section></main></div></body></html>
