<!DOCTYPE html>
<html lang="pt-BR">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0">

    <title>
        HestIA - Custos e eficiência
    </title>

    <link
        rel="stylesheet"
        href="/styles.css">

</head>

<body>

    <div class="app-shell">

        <%- include("menu", {
            perfil: perfil,
            email: email,
            active: active
        }) %>


        <main class="main">

            <!-- TOPO -->

            <header class="topbar">

                <button
                    class="menu-button"
                    id="menuButton">

                    ☰

                </button>


                <div>

                    <p class="eyebrow">
                        Gestor
                    </p>

                    <h1>
                        Custos e eficiência
                    </h1>

                </div>


                <div class="profile-switch">

                    <span>
                        <%= email %>
                    </span>

                    <select disabled>

                        <option selected>
                            Gestor
                        </option>

                    </select>

                </div>


                <a
                    class="topbar-logout"
                    href="/sair">

                    Sair

                </a>

            </header>


            <!-- INDICADORES -->

            <section class="grid four">

                <article class="metric-card">

                    <span>
                        Custo total
                    </span>

                    <strong id="custoTotal">
                        --
                    </strong>

                    <p>
                        Custo total das utilizações de IA.
                    </p>

                </article>


                <article class="metric-card">

                    <span>
                        Departamentos
                    </span>

                    <strong id="totalDepartamentos">
                        --
                    </strong>

                    <p>
                        Departamentos com registros de utilização.
                    </p>

                </article>


                <article class="metric-card">

                    <span>
                        Utilizações
                    </span>

                    <strong id="totalUtilizacoes">
                        --
                    </strong>

                    <p>
                        Registros utilizados na análise.
                    </p>

                </article>


                <article class="metric-card">

                    <span>
                        Eficiência
                    </span>

                    <strong id="eficienciaGeral">
                        --
                    </strong>

                    <p>
                        Média dos indicadores de eficiência.
                    </p>

                </article>

            </section>


            <!-- CUSTOS POR DEPARTAMENTO -->

            <section class="panel">

                <div class="panel-head">

                    <h3>
                        Custos por departamento
                    </h3>

                </div>


                <div class="dashboard-chart custos-chart">

                    <canvas id="graficoCustos"></canvas>

                    <div
                        class="chart-empty"
                        id="semCustos">

                        Nenhum dado de custo por departamento disponível.

                    </div>

                </div>

            </section>


            <!-- EFICIENCIA -->

            <section class="panel">

                <div class="panel-head">

                    <div>

                        <h3>
                            Indicadores de eficiência - Visão Geral
                        </h3>

                        <p>
                            Média dos indicadores de eficiência dos departamentos da organização.
                        </p>

                    </div>

                </div>


                <div class="dashboard-chart custos-chart">

                    <canvas id="graficoEficiencia"></canvas>

                    <div
                        class="chart-empty"
                        id="semEficiencia">

                        Nenhum indicador de eficiência disponível.

                    </div>

                </div>

            </section>


            <!-- COMPARACAO POR DEPARTAMENTO -->

            <section class="panel">

                <div class="panel-head">

                    <div>

                        <h3>
                            Comparação de eficiência por departamento
                        </h3>

                        <p>
                            Compare os indicadores de eficiência
                            entre as áreas da organização.
                        </p>

                    </div>

                </div>


                <div class="table-wrap">

                    <table>

                        <thead>

                            <tr>

                                <th>
                                    Departamento
                                </th>

                                <th>
                                    Utilizações
                                </th>

                                <th>
                                    Uso adequado
                                </th>

                                <th>
                                    Produtividade
                                </th>

                                <th>
                                    Aproveitamento
                                </th>

                                <th>
                                    Eficiência
                                </th>

                            </tr>

                        </thead>


                        <tbody id="tabelaEficiencia">

                        </tbody>

                    </table>

                </div>


                <p class="muted">
                    Dados demonstrativos utilizados para representação do wireframe.
                </p>

            </section>

        </main>

    </div>


    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>


    <script>

        /*
            DADOS DEMONSTRATIVOS

            Estes dados são utilizados enquanto os indicadores
            reais ainda não são fornecidos pelo backend.

            Futuramente estes valores poderão ser substituídos
            pelos dados recebidos pelo servidor.
        */


        /* CUSTOS */

        const graficoCustos =
            document.getElementById("graficoCustos");


        const departamentosCustos = [
            "Tecnologia",
            "Marketing",
            "Financeiro",
            "RH"
        ];


        const valoresCustos = [
            4200,
            2800,
            1900,
            1100
        ];


        /* DADOS DOS DEPARTAMENTOS */

        const dadosDepartamentos = [

            {

                departamento: "Tecnologia",

                utilizacoes: 320,

                usoAdequado: 91,

                produtividade: 86,

                aproveitamento: 83

            },

            {

                departamento: "Marketing",

                utilizacoes: 245,

                usoAdequado: 84,

                produtividade: 78,

                aproveitamento: 74

            },

            {

                departamento: "Financeiro",

                utilizacoes: 180,

                usoAdequado: 79,

                produtividade: 72,

                aproveitamento: 68

            },

            {

                departamento: "RH",

                utilizacoes: 120,

                usoAdequado: 82,

                produtividade: 69,

                aproveitamento: 66

            }

        ];


        /* CUSTO TOTAL */

        const custoTotal =
            valoresCustos.reduce(
                function(total, valor) {

                    return total + valor;

                },
                0
            );


        document
            .getElementById("custoTotal")
            .innerHTML =
            custoTotal.toLocaleString(
                "pt-BR",
                {
                    style: "currency",
                    currency: "BRL"
                }
            );


        /* TOTAL DE DEPARTAMENTOS */

        document
            .getElementById("totalDepartamentos")
            .innerHTML =
            dadosDepartamentos.length;


        /* TOTAL DE UTILIZACOES */

        const totalUtilizacoes =
            dadosDepartamentos.reduce(
                function(total, departamento) {

                    return total + departamento.utilizacoes;

                },
                0
            );


        document
            .getElementById("totalUtilizacoes")
            .innerHTML =
            totalUtilizacoes;


        /* GRAFICO DE CUSTOS */

        if (
            graficoCustos &&
            departamentosCustos.length > 0
        ) {

            document
                .getElementById("semCustos")
                .style.display = "none";


            new Chart(graficoCustos, {

                type: "bar",

                data: {

                    labels: departamentosCustos,

                    datasets: [{

                        label: "Custos de IA",

                        data: valoresCustos

                    }]

                },

                options: {

                    responsive: true,

                    maintainAspectRatio: false

                }

            });

        }


        /* EFICIENCIA */

        const graficoEficiencia =
            document.getElementById("graficoEficiencia");


        const indicadoresEficiencia = [
            "Uso adequado",
            "Produtividade",
            "Aproveitamento"
        ];


        const valoresEficiencia = [
            84,
            76,
            71
        ];


        /*
            EFICIENCIA GERAL

            Regra adotada no projeto:
            média simples entre uso adequado,
            produtividade e aproveitamento.
        */

        const eficienciaGeral =
            Math.round(

                valoresEficiencia.reduce(
                    function(total, valor) {

                        return total + valor;

                    },
                    0
                )

                /

                valoresEficiencia.length

            );


        document
            .getElementById("eficienciaGeral")
            .innerHTML =
            eficienciaGeral + "%";


        /* GRAFICO DE EFICIENCIA */

        if (
            graficoEficiencia &&
            indicadoresEficiencia.length > 0
        ) {

            document
                .getElementById("semEficiencia")
                .style.display = "none";


            new Chart(graficoEficiencia, {

                type: "bar",

                data: {

                    labels: indicadoresEficiencia,

                    datasets: [{

                        label: "Eficiência",

                        data: valoresEficiencia

                    }]

                },

                options: {

                    responsive: true,

                    maintainAspectRatio: false,

                    scales: {

                        y: {

                            beginAtZero: true,

                            max: 100

                        }

                    }

                }

            });

        }


        /* TABELA DE EFICIENCIA POR DEPARTAMENTO */

        const tabelaEficiencia =
            document.getElementById("tabelaEficiencia");


        dadosDepartamentos.forEach(
            function(departamento) {

                const eficienciaDepartamento =
                    Math.round(

                        (
                            departamento.usoAdequado +
                            departamento.produtividade +
                            departamento.aproveitamento
                        )

                        /

                        3

                    );


                const linha =
                    document.createElement("tr");


                linha.innerHTML =

                    "<td>" +
                        departamento.departamento +
                    "</td>" +

                    "<td>" +
                        departamento.utilizacoes +
                    "</td>" +

                    "<td>" +
                        departamento.usoAdequado +
                        "%" +
                    "</td>" +

                    "<td>" +
                        departamento.produtividade +
                        "%" +
                    "</td>" +

                    "<td>" +
                        departamento.aproveitamento +
                        "%" +
                    "</td>" +

                    "<td>" +
                        eficienciaDepartamento +
                        "%" +
                    "</td>";


                tabelaEficiencia.appendChild(linha);

            }
        );

    </script>


    <script src="/app.js"></script>

</body>

</html>