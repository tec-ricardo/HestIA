<!DOCTYPE html>
<html lang="pt-BR">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0">

    <title>
        HestIA - Custos e eficiência
    </title>

    <link
        rel="stylesheet"
        href="/styles.css">

</head>

<body>

    <div class="app-shell">

        <%- include("menu", {
            perfil: perfil,
            email: email,
            active: active
        }) %>


        <main class="main">

            <!-- TOPO -->

            <header class="topbar">

                <button
                    class="menu-button"
                    id="menuButton">

                    ☰

                </button>


                <div>

                    <p class="eyebrow">
                        Gestor
                    </p>

                    <h1>
                        Custos e eficiência
                    </h1>

                </div>


                <div class="profile-switch">

                    <span>
                        <%= email %>
                    </span>

                    <select disabled>

                        <option selected>
                            Gestor
                        </option>

                    </select>

                </div>


                <a
                    class="topbar-logout"
                    href="/sair">

                    Sair

                </a>

            </header>


            <!-- INDICADORES -->

            <section class="grid four">

                <article class="metric-card">

                    <span>
                        Custo total
                    </span>

                    <strong id="custoTotal">
                        --
                    </strong>

                    <p>
                        Custo total das utilizações de IA.
                    </p>

                </article>


                <article class="metric-card">

                    <span>
                        Departamentos
                    </span>

                    <strong id="totalDepartamentos">
                        --
                    </strong>

                    <p>
                        Departamentos com registros de utilização.
                    </p>

                </article>


                <article class="metric-card">

                    <span>
                        Utilizações
                    </span>

                    <strong id="totalUtilizacoes">
                        --
                    </strong>

                    <p>
                        Registros utilizados na análise.
                    </p>

                </article>


                <article class="metric-card">

                    <span>
                        Eficiência
                    </span>

                    <strong id="eficienciaGeral">
                        --
                    </strong>

                    <p>
                        Média da eficiência dos departamentos.
                    </p>

                </article>

            </section>


            <!-- CUSTOS POR DEPARTAMENTO -->

            <section class="panel">

                <div class="panel-head">

                    <div>

                        <h3>
                            Custos por departamento
                        </h3>

                        <p>
                            Comparação dos custos de utilização de IA entre as áreas da organização.
                        </p>

                    </div>

                </div>


                <div class="dashboard-chart custos-chart">

                    <canvas id="graficoCustos"></canvas>

                    <div
                        class="chart-empty"
                        id="semCustos">

                        Nenhum dado de custo por departamento disponível.

                    </div>

                </div>

            </section>


            <!-- EFICIENCIA POR DEPARTAMENTO -->

            <section class="panel">

                <div class="panel-head">

                    <div>

                        <h3>
                            Eficiência por departamento
                        </h3>

                        <p>
                            Comparação do indicador de eficiência entre os departamentos da organização.
                        </p>

                    </div>

                </div>


                <div class="dashboard-chart custos-chart">

                    <canvas id="graficoEficiencia"></canvas>

                    <div
                        class="chart-empty"
                        id="semEficiencia">

                        Nenhum indicador de eficiência disponível.

                    </div>

                </div>

            </section>


            <!-- ECONOMIA NO USO DE IA -->

            <section class="panel">

                <div class="panel-head">

                    <div>

                        <h3>
                            Economia no uso de IA
                        </h3>

                        <p>
                            Indicadores para acompanhar o consumo financeiro das ferramentas de IA.
                        </p>

                    </div>

                </div>


                <section class="grid two">

                    <article class="metric-card">

                        <span>
                            Custo médio por utilização
                        </span>

                        <strong id="custoMedioUtilizacao">
                            --
                        </strong>

                        <p>
                            Valor médio gasto por registro de utilização de IA.
                        </p>

                    </article>


                    <article class="metric-card">

                        <span>
                            Menor custo total
                        </span>

                        <strong id="departamentoMenorCusto">
                            --
                        </strong>

                        <p id="valorMenorCusto">
                            Departamento com menor custo registrado de IA.
                        </p>

                    </article>

                </section>

            </section>


            <!-- COMPARACAO POR DEPARTAMENTO -->

            <section class="panel">

                <div class="panel-head">

                    <div>

                        <h3>
                            Comparação de eficiência por departamento
                        </h3>

                        <p>
                            Compare utilização, uso adequado, produtividade,
                            custos e eficiência entre as áreas da organização.
                        </p>

                    </div>

                </div>


                <div class="table-wrap">

                    <table>

                        <thead>

                            <tr>

                                <th>
                                    Departamento
                                </th>

                                <th>
                                    Utilizações
                                </th>

                                <th>
                                    Uso adequado
                                </th>

                                <th>
                                    Produtividade
                                </th>

                                <th>
                                    Custo IA
                                </th>

                                <th>
                                    Eficiência
                                </th>

                            </tr>

                        </thead>


                        <tbody id="tabelaEficiencia">

                        </tbody>

                    </table>

                </div>


                <p class="muted">
                    Dados demonstrativos utilizados para representação do wireframe.
                </p>

            </section>

        </main>

    </div>


    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>


    <script>

        /*
            DADOS DEMONSTRATIVOS

            Estes dados são utilizados enquanto os indicadores
            reais ainda não são fornecidos pelo backend.

            Futuramente estes valores poderão ser substituídos
            pelos dados recebidos pelo servidor.
        */


        /* DADOS DOS DEPARTAMENTOS */

        const dadosDepartamentos = [

            {

                departamento: "Tecnologia",

                utilizacoes: 320,

                usoAdequado: 91,

                produtividade: 86,

                custoIA: 4200

            },

            {

                departamento: "Marketing",

                utilizacoes: 245,

                usoAdequado: 84,

                produtividade: 78,

                custoIA: 2800

            },

            {

                departamento: "Financeiro",

                utilizacoes: 180,

                usoAdequado: 79,

                produtividade: 72,

                custoIA: 1900

            },

            {

                departamento: "RH",

                utilizacoes: 120,

                usoAdequado: 82,

                produtividade: 69,

                custoIA: 1100

            }

        ];


        /*
            EFICIENCIA POR DEPARTAMENTO

            Regra adotada no projeto:
            média simples entre uso adequado
            e produtividade.
        */

        dadosDepartamentos.forEach(
            function(departamento) {

                departamento.eficiencia =
                    Math.round(
                        (
                            departamento.usoAdequado +
                            departamento.produtividade
                        )
                        /
                        2
                    );

            }
        );


        /* CUSTOS */

        const graficoCustos =
            document.getElementById("graficoCustos");


        const departamentosCustos =
            dadosDepartamentos.map(
                function(departamento) {

                    return departamento.departamento;

                }
            );


        const valoresCustos =
            dadosDepartamentos.map(
                function(departamento) {

                    return departamento.custoIA;

                }
            );


        /* CUSTO TOTAL */

        const custoTotal =
            dadosDepartamentos.reduce(
                function(total, departamento) {

                    return total + departamento.custoIA;

                },
                0
            );


        document
            .getElementById("custoTotal")
            .innerHTML =
            custoTotal.toLocaleString(
                "pt-BR",
                {
                    style: "currency",
                    currency: "BRL"
                }
            );


        /* TOTAL DE DEPARTAMENTOS */

        document
            .getElementById("totalDepartamentos")
            .innerHTML =
            dadosDepartamentos.length;


        /* TOTAL DE UTILIZACOES */

        const totalUtilizacoes =
            dadosDepartamentos.reduce(
                function(total, departamento) {

                    return total + departamento.utilizacoes;

                },
                0
            );


        document
            .getElementById("totalUtilizacoes")
            .innerHTML =
            totalUtilizacoes;


        /* EFICIENCIA GERAL */

        const eficienciaGeral =
            Math.round(

                dadosDepartamentos.reduce(
                    function(total, departamento) {

                        return total + departamento.eficiencia;

                    },
                    0
                )

                /

                dadosDepartamentos.length

            );


        document
            .getElementById("eficienciaGeral")
            .innerHTML =
            eficienciaGeral + "%";


        /* ECONOMIA - CUSTO MEDIO POR UTILIZACAO */

        const custoMedioUtilizacao =
            custoTotal / totalUtilizacoes;


        document
            .getElementById("custoMedioUtilizacao")
            .innerHTML =
            custoMedioUtilizacao.toLocaleString(
                "pt-BR",
                {
                    style: "currency",
                    currency: "BRL"
                }
            );


        /* ECONOMIA - DEPARTAMENTO COM MENOR CUSTO */

        const departamentoMenorCusto =
            dadosDepartamentos.reduce(
                function(menor, departamento) {

                    if (
                        departamento.custoIA <
                        menor.custoIA
                    ) {

                        return departamento;

                    }

                    return menor;

                }
            );


        document
            .getElementById("departamentoMenorCusto")
            .innerHTML =
            departamentoMenorCusto.departamento;


        document
            .getElementById("valorMenorCusto")
            .innerHTML =
            departamentoMenorCusto.custoIA.toLocaleString(
                "pt-BR",
                {
                    style: "currency",
                    currency: "BRL"
                }
            ) +
            " de custo total registrado de IA.";


        /* GRAFICO DE CUSTOS */

        if (
            graficoCustos &&
            departamentosCustos.length > 0
        ) {

            document
                .getElementById("semCustos")
                .style.display = "none";


            new Chart(graficoCustos, {

                type: "bar",

                data: {

                    labels: departamentosCustos,

                    datasets: [{

                        label: "Custos de IA",

                        data: valoresCustos

                    }]

                },

                options: {

                    responsive: true,

                    maintainAspectRatio: false

                }

            });

        }


        /* GRAFICO DE EFICIENCIA POR DEPARTAMENTO */

        const graficoEficiencia =
            document.getElementById("graficoEficiencia");


        const departamentosEficiencia =
            dadosDepartamentos.map(
                function(departamento) {

                    return departamento.departamento;

                }
            );


        const valoresEficiencia =
            dadosDepartamentos.map(
                function(departamento) {

                    return departamento.eficiencia;

                }
            );


        if (
            graficoEficiencia &&
            departamentosEficiencia.length > 0
        ) {

            document
                .getElementById("semEficiencia")
                .style.display = "none";


            new Chart(graficoEficiencia, {

                type: "bar",

                data: {

                    labels: departamentosEficiencia,

                    datasets: [{

                        label: "Eficiência",

                        data: valoresEficiencia

                    }]

                },

                options: {

                    responsive: true,

                    maintainAspectRatio: false,

                    scales: {

                        y: {

                            beginAtZero: true,

                            max: 100

                        }

                    }

                }

            });

        }


        /* TABELA DE EFICIENCIA POR DEPARTAMENTO */

        const tabelaEficiencia =
            document.getElementById("tabelaEficiencia");


        dadosDepartamentos.forEach(
            function(departamento) {

                const linha =
                    document.createElement("tr");


                linha.innerHTML =

                    "<td>" +
                        departamento.departamento +
                    "</td>" +

                    "<td>" +
                        departamento.utilizacoes +
                    "</td>" +

                    "<td>" +
                        departamento.usoAdequado +
                        "%" +
                    "</td>" +

                    "<td>" +
                        departamento.produtividade +
                        "%" +
                    "</td>" +

                    "<td>" +
                        departamento.custoIA.toLocaleString(
                            "pt-BR",
                            {
                                style: "currency",
                                currency: "BRL"
                            }
                        ) +
                    "</td>" +

                    "<td>" +
                        departamento.eficiencia +
                        "%" +
                    "</td>";


                tabelaEficiencia.appendChild(linha);

            }
        );

    </script>


    <script src="/app.js"></script>

</body>

</html>