<!DOCTYPE html>
<html lang="pt-BR">

<head>

    <meta charset="UTF-8">

    <meta
            name="viewport"
            content="width=device-width, initial-scale=1.0">

    <title>
        HestIA - AI Maturity Score
    </title>

    <link
            rel="stylesheet"
            href="/styles.css">

</head>

<body>

<div class="app-shell">

    <%- include("menu", {
    perfil: perfil,
    email: email,
    active: active
    }) %>


    <main class="main">

        <!-- TOPO -->

        <header class="topbar">

            <button
                    class="menu-button"
                    id="menuButton">

                ☰

            </button>


            <div>

                <p class="eyebrow">
                    Maturidade
                </p>

                <h1>
                    AI Maturity Score
                </h1>

            </div>


            <div class="profile-switch">

                    <span>
                        <%= email %>
                    </span>

                <select disabled>

                    <% if (perfil == "colaborador") { %>

                        <option selected>
                            Colaborador
                        </option>

                    <% } %>


                    <% if (perfil == "gestor") { %>

                        <option selected>
                            Gestor
                        </option>

                    <% } %>

                </select>

            </div>


            <a
                    class="topbar-logout"
                    href="/sair">

                Sair

            </a>

        </header>


        <!-- COLABORADOR -->

        <% if (perfil == "colaborador") { %>

            <section class="grid two">

                <article class="metric-card">

                        <span>
                            AI Maturity Score
                        </span>

                    <strong>
                        <%= maturityScore %>
                    </strong>

                    <p>
                        Pontuação geral de maturidade em IA.
                    </p>

                </article>

            </section>


            <section class="grid four">

                <article class="metric-card">

                        <span>
                            AI Literacy
                        </span>

                    <strong>
                        <%= indicadores.aiLiteracy %>
                    </strong>

                    <p>
                        Conhecimento e compreensão sobre o uso de Inteligência Artificial.
                    </p>

                </article>


                <article class="metric-card">

                        <span>
                            Governança
                        </span>

                    <strong>
                        <%= indicadores.governanca %>
                    </strong>

                    <p>
                        Aderência às políticas e diretrizes de uso de IA da organização.
                    </p>

                </article>


                <article class="metric-card">

                        <span>
                            Uso Responsável
                        </span>

                    <strong>
                        <%= indicadores.usoResponsavel %>
                    </strong>

                    <p>
                        Uso da IA de forma adequada, segura e em conformidade.
                    </p>

                </article>


                <article class="metric-card">

                        <span>
                            Produtividade
                        </span>

                    <strong>
                        <%= indicadores.produtividade %>
                    </strong>

                    <p>
                        Contribuição da IA para apoiar e otimizar as atividades realizadas.
                    </p>

                </article>


                <article class="metric-card">

                        <span>
                            FinOps
                        </span>

                    <strong>
                        <%= indicadores.finOps %>
                    </strong>

                    <p>
                        Eficiência no consumo e nos custos relacionados ao uso de IA.
                    </p>

                </article>


                <article class="metric-card">

                        <span>
                            Segurança
                        </span>

                    <strong>
                        <%= indicadores.seguranca %>
                    </strong>

                    <p>
                        Cuidados com dados, privacidade e uso seguro das ferramentas de IA.
                    </p>

                </article>


                <article class="metric-card">

                        <span>
                            Colaboração
                        </span>

                    <strong>
                        <%= indicadores.colaboracao %>
                    </strong>

                    <p>
                        Uso e compartilhamento de conhecimentos sobre IA entre colaboradores.
                    </p>

                </article>


                <article class="metric-card">

                        <span>
                            Desenvolvimento de Competências
                        </span>

                    <strong>
                        <%= indicadores.desenvolvimentoCompetencias %>
                    </strong>

                    <p>
                        Evolução das habilidades e conhecimentos relacionados à IA.
                    </p>

                </article>

            </section>


            <!-- GRAFICO COLABORADOR -->

            <section class="panel">

                <div class="panel-head">

                    <h3>
                        Indicadores de AI Maturity Score
                    </h3>

                </div>


                <div class="dashboard-chart maturidade-chart">

                    <canvas id="graficoMaturidade"></canvas>

                    <div
                            class="chart-empty"
                            id="semMaturidade">

                        Sem dados registrados para gerar o gráfico.

                    </div>

                </div>

            </section>

        <% } %>


        <!-- GESTOR -->

        <% if (perfil == "gestor") { %>

            <section class="grid two">

                <article class="metric-card">

                        <span>
                            AI Maturity Score
                        </span>

                    <strong>
                        Comparação
                    </strong>

                    <p>
                        Comparação da maturidade entre departamentos
                        ou grupos da organização.
                    </p>

                </article>


                <article class="metric-card">

                        <span>
                            Estratégia
                        </span>

                    <strong>
                        Indicadores
                    </strong>

                    <p>
                        Os indicadores apoiam a definição de estratégias
                        para ampliar a maturidade organizacional.
                    </p>

                </article>

            </section>


            <section class="panel">

                <div class="panel-head">

                    <h3>
                        Comparação entre departamentos
                    </h3>

                </div>


                <div class="dashboard-chart maturidade-chart">

                    <canvas id="graficoDepartamentos"></canvas>

                    <div
                            class="chart-empty"
                            id="semDepartamentos">

                        Nenhum departamento possui dados de maturidade
                        para comparação.

                    </div>

                </div>

            </section>

        <% } %>

    </main>

</div>


<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>


<script>


    /* COLABORADOR */

    const graficoMaturidade =
        document.getElementById("graficoMaturidade");


    if (graficoMaturidade) {

        const valoresMaturidade = [
            <%= indicadores.aiLiteracy %>,
            <%= indicadores.governanca %>,
            <%= indicadores.usoResponsavel %>,
            <%= indicadores.produtividade %>,
            <%= indicadores.finOps %>,
            <%= indicadores.seguranca %>,
            <%= indicadores.colaboracao %>,
            <%= indicadores.desenvolvimentoCompetencias %>
        ];


        if (valoresMaturidade.length > 0) {

            document
                .getElementById("semMaturidade")
                .style.display = "none";


            new Chart(graficoMaturidade, {

                type: "bar",

                data: {

                    labels: [
                        "AI Literacy",
                        "Governança",
                        "Uso Responsável",
                        "Produtividade",
                        "FinOps",
                        "Segurança",
                        "Colaboração",
                        "Competências"
                    ],

                    datasets: [{

                        label: "AI Maturity Score",

                        data: valoresMaturidade

                    }]

                },


                options: {

                    responsive: true,

                    maintainAspectRatio: false,

                    scales: {

                        y: {

                            beginAtZero: true,

                            max: 100

                        }

                    }

                }

            });

        }

    }



    /* GESTOR */

    const graficoDepartamentos =
        document.getElementById("graficoDepartamentos");


    if (graficoDepartamentos) {

        const departamentos = [
            "Tecnologia",
            "Marketing",
            "Financeiro",
            "RH"
        ];


        const valoresDepartamentos = [
            82,
            74,
            67,
            61
        ];


        if (departamentos.length > 0) {

            document
                .getElementById("semDepartamentos")
                .style.display = "none";


            new Chart(graficoDepartamentos, {

                type: "bar",

                data: {

                    labels: departamentos,

                    datasets: [{

                        label: "AI Maturity Score",

                        data: valoresDepartamentos

                    }]

                },


                options: {

                    responsive: true,

                    maintainAspectRatio: false,

                    scales: {

                        y: {

                            beginAtZero: true,

                            max: 100

                        }

                    }

                }

            });

        }

    }


</script>


<script src="/app.js"></script>

</body>

</html>