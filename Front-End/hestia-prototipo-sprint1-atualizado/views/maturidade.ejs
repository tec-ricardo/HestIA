<!DOCTYPE html>
<html lang="pt-BR">

<head>

    <meta charset="UTF-8">

    <meta
            name="viewport"
            content="width=device-width, initial-scale=1.0">

    <title>
        HestIA - AI Maturity Score
    </title>

    <link
            rel="stylesheet"
            href="/styles.css">

</head>

<body>

<div class="app-shell">

    <%- include("menu", {
    perfil: perfil,
    email: email,
    active: active
    }) %>


    <main class="main">

        <!-- TOPO -->

        <header class="topbar">

            <button
                    class="menu-button"
                    id="menuButton">

                ☰

            </button>


            <div>

                <p class="eyebrow">
                    Maturidade
                </p>

                <h1>
                    AI Maturity Score
                </h1>

            </div>


            <div class="profile-switch">

                    <span>
                        <%= email %>
                    </span>

                <select disabled>

                    <% if (perfil == "colaborador") { %>

                        <option selected>
                            Colaborador
                        </option>

                    <% } %>


                    <% if (perfil == "gestor") { %>

                        <option selected>
                            Gestor
                        </option>

                    <% } %>

                </select>

            </div>


            <a
                    class="topbar-logout"
                    href="/sair">

                Sair

            </a>

        </header>


        <!-- COLABORADOR -->

        <% if (perfil == "colaborador") { %>

            <section class="grid two">

                <article class="metric-card">

                        <span>
                            AI Maturity Score
                        </span>

                    <strong>
                        <%= maturityScore %>
                    </strong>

                    <p>
                        Pontuação geral de maturidade em IA.
                    </p>

                </article>

            </section>


            <section class="grid four">

                <article class="metric-card">

                        <span>
                            AI Literacy
                        </span>

                    <strong>
                        <%= indicadores.aiLiteracy %>
                    </strong>

                    <p>
                        Conhecimento e compreensão sobre o uso de Inteligência Artificial.
                    </p>

                </article>


                <article class="metric-card">

                        <span>
                            Governança
                        </span>

                    <strong>
                        <%= indicadores.governanca %>
                    </strong>

                    <p>
                        Aderência às políticas e diretrizes de uso de IA da organização.
                    </p>

                </article>


                <article class="metric-card">

                        <span>
                            Uso Responsável
                        </span>

                    <strong>
                        <%= indicadores.usoResponsavel %>
                    </strong>

                    <p>
                        Uso da IA de forma adequada, segura e em conformidade.
                    </p>

                </article>


                <article class="metric-card">

                        <span>
                            Produtividade
                        </span>

                    <strong>
                        <%= indicadores.produtividade %>
                    </strong>

                    <p>
                        Contribuição da IA para apoiar e otimizar as atividades realizadas.
                    </p>

                </article>


                <article class="metric-card">

                        <span>
                            FinOps
                        </span>

                    <strong>
                        <%= indicadores.finOps %>
                    </strong>

                    <p>
                        Eficiência no consumo e nos custos relacionados ao uso de IA.
                    </p>

                </article>


                <article class="metric-card">

                        <span>
                            Segurança
                        </span>

                    <strong>
                        <%= indicadores.seguranca %>
                    </strong>

                    <p>
                        Cuidados com dados, privacidade e uso seguro das ferramentas de IA.
                    </p>

                </article>


                <article class="metric-card">

                        <span>
                            Colaboração
                        </span>

                    <strong>
                        <%= indicadores.colaboracao %>
                    </strong>

                    <p>
                        Uso e compartilhamento de conhecimentos sobre IA entre colaboradores.
                    </p>

                </article>


                <article class="metric-card">

                        <span>
                            Desenvolvimento de Competências
                        </span>

                    <strong>
                        <%= indicadores.desenvolvimentoCompetencias %>
                    </strong>

                    <p>
                        Evolução das habilidades e conhecimentos relacionados à IA.
                    </p>

                </article>

            </section>


            <!-- GRAFICO COLABORADOR -->

            <section class="panel">

                <div class="panel-head">

                    <h3>
                        Indicadores de AI Maturity Score
                    </h3>

                </div>


                <div class="dashboard-chart maturidade-chart">

                    <canvas id="graficoMaturidade"></canvas>

                    <div
                            class="chart-empty"
                            id="semMaturidade">

                        Sem dados registrados para gerar o gráfico.

                    </div>

                </div>

            </section>

        <% } %>


        <!-- GESTOR -->

<% if (perfil == "gestor") { %>

    <!-- CARDS PRINCIPAIS -->

    <section class="grid">

        <article class="metric-card">

            <span>
                AI Maturity Score
            </span>

            <strong>
                Comparação
            </strong>

            <p>
                Comparação da maturidade entre departamentos
                ou grupos da organização.
            </p>

        </article>

    </section>


            <!-- RESUMO ANALITICO -->

            <section class="grid four">

                <article class="metric-card">

                        <span>
                            Média organizacional
                        </span>

                    <strong>
                        71
                    </strong>

                    <p>
                        Média do AI Maturity Score dos departamentos analisados.
                    </p>

                </article>


                <article class="metric-card">

                        <span>
                            Maior maturidade
                        </span>

                    <strong>
                        Tecnologia
                    </strong>

                    <p>
                        Score 82 — maior resultado entre os departamentos analisados.
                    </p>

                </article>


                <article class="metric-card">

                        <span>
                            Menor maturidade
                        </span>

                    <strong>
                        RH
                    </strong>

                    <p>
                        Score 61 — menor resultado entre os departamentos analisados.
                    </p>

                </article>


                <article class="metric-card">

                        <span>
                            Departamentos analisados
                        </span>

                    <strong>
                        4
                    </strong>

                    <p>
                        Tecnologia, Marketing, Financeiro e RH.
                    </p>

                </article>

            </section>


            <!-- GRAFICO GERAL DOS DEPARTAMENTOS -->

            <section class="panel">

                <div class="panel-head">

                    <h3>
                        Comparação entre departamentos
                    </h3>

                </div>


                <div class="dashboard-chart maturidade-chart">

                    <canvas id="graficoDepartamentos"></canvas>

                    <div
                            class="chart-empty"
                            id="semDepartamentos">

                        Nenhum departamento possui dados de maturidade
                        para comparação.

                    </div>

                </div>

            </section>


            <!-- TABELA COMPARATIVA -->

            <section class="panel">

                <div class="panel-head">

                    <div>

                        <h3>
                            Análise comparativa da maturidade
                        </h3>

                        <p>
                            Comparação dos resultados de AI Maturity Score
                            entre os departamentos da organização.
                        </p>

                    </div>

                </div>


                <div class="table-wrap">

                    <table>

                        <thead>

                        <tr>

                            <th>
                                Departamento
                            </th>

                            <th>
                                AI Maturity Score
                            </th>

                            <th>
                                Comparação com a média
                            </th>

                            <th>
                                Diferença
                            </th>

                        </tr>

                        </thead>


                        <tbody>

                        <tr>

                            <td>
                                Tecnologia
                            </td>

                            <td>
                                <strong>82</strong>
                            </td>

                            <td>
                                Acima da média
                            </td>

                            <td>
                                +11 pontos
                            </td>

                        </tr>


                        <tr>

                            <td>
                                Marketing
                            </td>

                            <td>
                                <strong>74</strong>
                            </td>

                            <td>
                                Acima da média
                            </td>

                            <td>
                                +3 pontos
                            </td>

                        </tr>


                        <tr>

                            <td>
                                Financeiro
                            </td>

                            <td>
                                <strong>67</strong>
                            </td>

                            <td>
                                Abaixo da média
                            </td>

                            <td>
                                -4 pontos
                            </td>

                        </tr>


                        <tr>

                            <td>
                                RH
                            </td>

                            <td>
                                <strong>61</strong>
                            </td>

                            <td>
                                Abaixo da média
                            </td>

                            <td>
                                -10 pontos
                            </td>

                        </tr>

                        </tbody>

                    </table>

                </div>

                <p class="mock-note">
                    Dados demonstrativos utilizados para representação do wireframe.
                </p>

            </section>


            <!-- INDICADORES POR DEPARTAMENTO -->

            <section class="panel">

                <div class="panel-head">

                    <div>

                        <h3>
                            Indicadores de maturidade por departamento
                        </h3>

                        <p>
                            Detalhamento dos indicadores para apoiar a comparação
                            da maturidade entre as áreas.
                        </p>

                    </div>

                </div>


                <div class="dashboard-chart maturidade-chart">

                    <canvas id="graficoIndicadoresDepartamentos"></canvas>

                </div>

            </section>


            <!-- DETALHAMENTO DOS INDICADORES -->

            <section class="panel">

                <div class="panel-head">

                    <div>

                        <h3>
                            Detalhamento dos indicadores
                        </h3>

                        <p>
                            Visão comparativa dos componentes de maturidade
                            utilizados no cenário demonstrativo.
                        </p>

                    </div>

                </div>


                <div class="table-wrap">

                    <table>

                        <thead>

                        <tr>

                            <th>
                                Indicador
                            </th>

                            <th>
                                Tecnologia
                            </th>

                            <th>
                                Marketing
                            </th>

                            <th>
                                Financeiro
                            </th>

                            <th>
                                RH
                            </th>

                        </tr>

                        </thead>


                        <tbody>

                        <tr>
                            <td>AI Literacy</td>
                            <td>88</td>
                            <td>80</td>
                            <td>70</td>
                            <td>66</td>
                        </tr>

                        <tr>
                            <td>Governança</td>
                            <td>78</td>
                            <td>72</td>
                            <td>65</td>
                            <td>59</td>
                        </tr>

                        <tr>
                            <td>Uso Responsável</td>
                            <td>90</td>
                            <td>83</td>
                            <td>75</td>
                            <td>69</td>
                        </tr>

                        <tr>
                            <td>Produtividade</td>
                            <td>85</td>
                            <td>79</td>
                            <td>68</td>
                            <td>63</td>
                        </tr>

                        <tr>
                            <td>FinOps</td>
                            <td>76</td>
                            <td>68</td>
                            <td>61</td>
                            <td>55</td>
                        </tr>

                        <tr>
                            <td>Segurança</td>
                            <td>91</td>
                            <td>86</td>
                            <td>78</td>
                            <td>73</td>
                        </tr>

                        <tr>
                            <td>Colaboração</td>
                            <td>79</td>
                            <td>73</td>
                            <td>65</td>
                            <td>60</td>
                        </tr>

                        <tr>
                            <td>Desenvolvimento de Competências</td>
                            <td>80</td>
                            <td>71</td>
                            <td>64</td>
                            <td>58</td>
                        </tr>

                        </tbody>

                    </table>

                </div>

                <p class="mock-note">
                    Indicadores e valores demonstrativos utilizados para representação do MVP.
                </p>

            </section>

        <% } %>

    </main>

</div>


<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>


<script>


    /* COLABORADOR */

    const graficoMaturidade =
        document.getElementById("graficoMaturidade");


    if (graficoMaturidade) {

        const valoresMaturidade = [
            <%= indicadores.aiLiteracy %>,
            <%= indicadores.governanca %>,
            <%= indicadores.usoResponsavel %>,
            <%= indicadores.produtividade %>,
            <%= indicadores.finOps %>,
            <%= indicadores.seguranca %>,
            <%= indicadores.colaboracao %>,
            <%= indicadores.desenvolvimentoCompetencias %>
        ];


        if (valoresMaturidade.length > 0) {

            document
                .getElementById("semMaturidade")
                .style.display = "none";


            new Chart(graficoMaturidade, {

                type: "bar",

                data: {

                    labels: [
                        "AI Literacy",
                        "Governança",
                        "Uso Responsável",
                        "Produtividade",
                        "FinOps",
                        "Segurança",
                        "Colaboração",
                        "Competências"
                    ],

                    datasets: [{

                        label: "AI Maturity Score",

                        data: valoresMaturidade

                    }]

                },


                options: {

                    responsive: true,

                    maintainAspectRatio: false,

                    scales: {

                        y: {

                            beginAtZero: true,

                            max: 100

                        }

                    }

                }

            });

        }

    }



    /* GESTOR - COMPARACAO GERAL */

    const graficoDepartamentos =
        document.getElementById("graficoDepartamentos");


    if (graficoDepartamentos) {

        const departamentos = [
            "Tecnologia",
            "Marketing",
            "Financeiro",
            "RH"
        ];


        const valoresDepartamentos = [
            82,
            74,
            67,
            61
        ];


        if (departamentos.length > 0) {

            document
                .getElementById("semDepartamentos")
                .style.display = "none";


            new Chart(graficoDepartamentos, {

                type: "bar",

                data: {

                    labels: departamentos,

                    datasets: [{

                        label: "AI Maturity Score",

                        data: valoresDepartamentos

                    }]

                },


                options: {

                    responsive: true,

                    maintainAspectRatio: false,

                    scales: {

                        y: {

                            beginAtZero: true,

                            max: 100

                        }

                    }

                }

            });

        }

    }



    /* GESTOR - INDICADORES POR DEPARTAMENTO */

    const graficoIndicadoresDepartamentos =
        document.getElementById("graficoIndicadoresDepartamentos");


    if (graficoIndicadoresDepartamentos) {

        new Chart(graficoIndicadoresDepartamentos, {

            type: "bar",

            data: {

                labels: [
                    "AI Literacy",
                    "Governança",
                    "Uso Responsável",
                    "Produtividade",
                    "FinOps",
                    "Segurança",
                    "Colaboração",
                    "Competências"
                ],

                datasets: [

                    {
                        label: "Tecnologia",
                        data: [88, 78, 90, 85, 76, 91, 79, 80]
                    },

                    {
                        label: "Marketing",
                        data: [80, 72, 83, 79, 68, 86, 73, 71]
                    },

                    {
                        label: "Financeiro",
                        data: [70, 65, 75, 68, 61, 78, 65, 64]
                    },

                    {
                        label: "RH",
                        data: [66, 59, 69, 63, 55, 73, 60, 58]
                    }

                ]

            },


            options: {

                responsive: true,

                maintainAspectRatio: false,

                interaction: {

                    mode: "index",

                    intersect: false

                },

                scales: {

                    y: {

                        beginAtZero: true,

                        max: 100

                    }

                }

            }

        });

    }


</script>


<script src="/app.js"></script>

</body>

</html>