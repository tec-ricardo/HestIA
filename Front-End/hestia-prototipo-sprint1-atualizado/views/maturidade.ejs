<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HestIA — Maturidade e confiança dos indicadores</title>
    <link rel="stylesheet" href="/styles.css">
    <style>
        .confianca-aviso { padding:16px; border-left:4px solid #a16207; background:#fffbeb; margin:16px 0; color:#713f12; }
        .confianca-selo { display:inline-block; font-weight:700; padding:5px 9px; border-radius:5px; background:#e2e8f0; color:#334155; }
        .confianca-selo[data-classe="CONFIAVEL"] { background:#dcfce7; color:#166534; }
        .confianca-selo[data-classe="PARCIAL"] { background:#fef3c7; color:#854d0e; }
        .confianca-filtros { display:flex; gap:16px; flex-wrap:wrap; align-items:end; margin-bottom:20px; }
        .confianca-filtros label { display:grid; gap:6px; }
        .confianca-card { padding:20px; border:1px solid #cbd5e1; border-radius:12px; background:#fff; }
        .confianca-card h3 { margin:8px 0 16px; }
        .confianca-nota { display:block; font-size:30px; font-weight:700; margin:12px 0; }
        .confianca-card dl { display:grid; grid-template-columns:1fr 1fr; gap:8px; }
        .confianca-card dd { margin:0; }
    </style>
</head>
<body>
<div class="app-shell">
    <%- include("menu", { perfil, email, active }) %>
    <main class="main">
        <header class="topbar">
            <button class="menu-button" id="menuButton" aria-label="Abrir menu">☰</button>
            <div><p class="eyebrow">Maturidade</p><h1>AI Maturity Score</h1></div>
            <span><%= email %></span><a class="topbar-logout" href="/sair">Sair</a>
        </header>
        <form class="confianca-filtros" action="/maturidade" method="get">
            <label>Início <input type="date" name="inicio" value="<%= inicio %>" required></label>
            <label>Fim <input type="date" name="fim" value="<%= fim %>" required></label>
            <label>Visão
                <select name="visao">
                    <option value="PESSOAL" <%= visao === "PESSOAL" ? "selected" : "" %>>Meus registros</option>
                    <% if (gerencial) { %>
                    <option value="GERENCIAL" <%= visao === "GERENCIAL" ? "selected" : "" %>>Meu escopo gerencial</option>
                    <% } %>
                </select>
            </label>
            <button class="primary" type="submit">Consultar</button>
        </form>
        <% if (erro) { %>
            <div class="confianca-aviso" role="status"><%= erro %> <a href="/acesso">Acessar conta</a></div>
            <section class="panel"><h2>Sem resultados disponíveis</h2><p>A ausência de uma consulta válida não representa nota zero.</p></section>
        <% } %>
        <% if (dados) {
            const numero = v => typeof v === "number" && Number.isFinite(v)
                ? v.toLocaleString("pt-BR", { maximumFractionDigits: 2 }) : "Não disponível";
            const percentual = v => typeof v === "number" && Number.isFinite(v)
                ? numero(v * 100) + "%" : "Não disponível";
            const rotulo = c => c.situacao === "SEM_DADOS" ? "Sem dados"
                : c.situacao === "FONTE_PENDENTE" ? "Fonte pendente"
                : ({CONFIAVEL:"Confiável", PARCIAL:"Parcial", ESTIMADO:"Estimado"}[c.classificacao] || "Não classificado");
        %>
            <p>Período: <%= dados.periodo.inicio %> a <%= dados.periodo.fim %>.
                Visão: <%= dados.visao === "PESSOAL" ? "Meus registros" : "Meu escopo gerencial" %>.
                Fonte: dados operacionais cadastrados no HestIA.</p>
            <section class="grid two">
                <article class="confianca-card"><h2>Índice completo</h2>
                    <strong class="confianca-nota"><%= numero(dados.scoreGlobal) %></strong>
                    <p>Exige todas as oito dimensões elegíveis.</p>
                </article>
                <article class="confianca-card"><h2>Índice parcial exploratório</h2>
                    <strong class="confianca-nota"><%= numero(dados.scoreParcial) %></strong>
                    <p>Cobertura dos pesos: <%= percentual(dados.coberturaPesos) %>. Não comparar com um índice completo.</p>
                </article>
            </section>
            <div class="confianca-aviso" role="status">
                Confiança indica a qualidade da evidência disponível, não o nível de maturidade da pessoa ou da empresa.
                Uma nota zero só aparece quando foi efetivamente calculada.
            </div>
            <section class="grid two" aria-label="Indicadores e confiabilidade">
                <% dados.indicadores.forEach(i => { const c = i.confianca; %>
                <article class="confianca-card">
                    <h3><%= i.nome %></h3>
                    <span class="confianca-selo" data-classe="<%= c.classificacao %>"><%= rotulo(c) %></span>
                    <strong class="confianca-nota"><%= numero(i.valor) %><%= i.valor == null ? "" : " / 100" %></strong>
                    <dl>
                        <dt>Cobertura</dt><dd><%= percentual(c.cobertura) %></dd>
                        <dt>Completude</dt><dd><%= percentual(c.completude) %></dd>
                        <dt>Amostra válida</dt><dd><%= numero(c.amostra) %></dd>
                        <dt>Registros observados</dt><dd><%= numero(c.universoObservado) %></dd>
                    </dl>
                    <ul><% c.motivos.forEach(m => { %><li><%= m %></li><% }); %></ul>
                    <details><summary>Como interpretar</summary>
                        <p>Período: <%= dados.periodo.inicio %> a <%= dados.periodo.fim %>.</p>
                        <p>Regra de confiança: <%= c.versaoRegra %>.</p>
                        <% if (c.amostraMinima != null) { %>
                        <p>Limites: cobertura e completude mínimas de <%= percentual(c.limiteCobertura) %>;
                            amostra mínima de <%= c.amostraMinima %> registros distintos.</p>
                        <% } else { %>
                        <p>Os critérios específicos serão publicados com a calculadora desta dimensão.</p>
                        <% } %>
                        <p>Fonte: <%= i.fonte %>. <%= i.formula || "Fórmula de cálculo ainda não disponibilizada." %></p>
                        <p>Peso na composição: <%= percentual(i.peso) %>.</p>
                    </details>
                </article>
                <% }); %>
            </section>
            <section class="panel" style="margin-top:20px">
                <h2>Limitações e rastreabilidade</h2>
                <ul><% dados.limitacoes.forEach(m => { %><li><%= m %></li><% }); %></ul>
                <p>Apurado em <%= dados.apuradoEm %>. Composição: <%= dados.versaoComposicao %>.
                    Confiança: <%= dados.versaoConfianca %>. A classificação é recalculada a cada consulta.</p>
            </section>
        <% } %>
    </main>
</div>
<script src="/app.js"></script>
</body>
</html>
