<section aria-labelledby="tituloHistorico" style="margin-top:24px"><h2 id="tituloHistorico">Histórico e evolução</h2><p>Guarde uma apuração experimental com suas regras e fontes. A comparação exige escopo, versões, duração e parâmetros compatíveis.</p><button type="button" id="guardarApuracao">Guardar apuração experimental</button><p id="statusApuracao" role="status"></p><label>Apuração anterior <select id="apuracaoAnterior"></select></label><label>Apuração atual <select id="apuracaoAtual"></select></label><button type="button" id="compararApuracoes">Comparar apurações</button><div id="evolucaoApuracoes" aria-live="polite"></div><h3>Confiança dos indicadores</h3><ul id="confiancaApuracoes"><li>Aguardando consulta.</li></ul></section>
<script>
(async()=>{const aviso=document.getElementById('statusApuracao');async function requisitar(url,op){const r=await fetch(url,op);const d=await r.json();if(!r.ok)throw Error(d.erro||'Consulta indisponível');return d;}async function carregar(){const linhas=await requisitar('/api/maturidade/apuracoes');for(const id of ['apuracaoAnterior','apuracaoAtual']){const el=document.getElementById(id);el.replaceChildren();for(const linha of linhas){const op=document.createElement('option');op.value=linha.id;op.textContent='#'+linha.id+' | '+linha.inicio+' a '+linha.fim+' | '+linha.fonte;el.append(op);}}}const parametros=new URLSearchParams(location.search);const dto=Object.fromEntries(parametros);document.getElementById('guardarApuracao').onclick=async()=>{try{if(!dto.inicio||!dto.fim||!dto.fonte)throw Error('Selecione período e fonte antes de guardar.');await requisitar('/api/maturidade/apuracoes',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(dto)});aviso.textContent='Apuração experimental preservada.';await carregar();}catch(e){aviso.textContent=e.message;}};document.getElementById('compararApuracoes').onclick=async()=>{const caixa=document.getElementById('evolucaoApuracoes');try{const a=document.getElementById('apuracaoAnterior').value,b=document.getElementById('apuracaoAtual').value;const d=await requisitar('/api/maturidade/evolucao?anteriorId='+encodeURIComponent(a)+'&atualId='+encodeURIComponent(b));caixa.replaceChildren();const p=document.createElement('p');p.textContent=d.motivo+(d.variacaoGlobal===null?' | Sem score global comparável.':' | Variação global: '+d.variacaoGlobal+' pontos.');caixa.append(p);for(const [fator,valor]of Object.entries(d.variacaoFatoresElegiveis||{})){const linha=document.createElement('p');linha.textContent=fator+': '+valor+' pontos';caixa.append(linha);}}catch(e){caixa.textContent=e.message;}};try{await carregar();if(dto.inicio&&dto.fim&&dto.fonte){const d=await requisitar('/api/maturidade/consolidada?'+parametros.toString());const ul=document.getElementById('confiancaApuracoes');ul.replaceChildren();for(const c of d.confianca){const li=document.createElement('li');li.textContent=c.fator+': '+c.classificacao+' - '+c.motivo;ul.append(li);}}}catch(e){aviso.textContent=e.message;}})();
</script>
