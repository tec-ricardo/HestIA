// Microtreinamentos HestIA







// Funcoes simples com fetch, if, for e getElementById















let cursos = [];







let cursoAtual = null;







let filtroAtual = "todos";















function buscarDados(url, metodo, dados) {







    let opcoes = {







        method: metodo,







        headers: { "Content-Type": "application/json" }







    };















    if (dados != null) {







        opcoes.body = JSON.stringify(dados);







    }















    return fetch(url, opcoes).then(function(resposta) {







        return resposta.json().then(function(resultado) {







            if (!resposta.ok) {







                throw new Error(resultado.erro || "Erro na requisicao.");







            }







            return resultado;







        });







    });







}















function limparTexto(texto) {







    let elemento = document.createElement("div");







    elemento.textContent = texto;







    return elemento.innerHTML;







}















function porcentagem(curso) {







    if (curso.concluido) {







        return 100;







    }







    return Math.round(curso.etapa * 100 / curso.totalEtapas);







}















function carregarCursos() {







    let lista = document.getElementById("mt-list");







    lista.innerHTML = "Carregando cursos...";















    buscarDados("/api/microtreinamentos", "GET", null).then(function(resultado) {







        cursos = resultado.treinamentos;



        window.hestiaNivelAtual = resultado.nivelAtual;







        mostrarCursos();



        mostrarCertificacoes();







    }).catch(function(erro) {







        lista.textContent = erro.message;



        let certLista = document.getElementById("mt-cert-list");



        if (certLista) certLista.textContent = "Não foi possível carregar as certificações.";







    });







}















function mostrarCursos() {







    let lista = document.getElementById("mt-list");







    let concluidos = 0;







    let andamento = 0;







    let disponiveis = 0;







    let html = "";















    for (let i = 0; i < cursos.length; i++) {







        let curso = cursos[i];















        if (curso.concluido) concluidos++;







        if (curso.etapa > 0 && !curso.concluido) andamento++;







        if (!curso.bloqueado) disponiveis++;















        let mostrar = true;







        if (filtroAtual == "recomendados" && !curso.recomendado) mostrar = false;







        if (filtroAtual == "andamento" && (curso.etapa == 0 || curso.concluido)) mostrar = false;







        if (filtroAtual == "concluidos" && !curso.concluido) mostrar = false;







        if (!mostrar) continue;















        let estado = "Disponivel";







        if (curso.bloqueado) estado = "Bloqueado";







        else if (curso.concluido) estado = "Concluido";







        else if (curso.etapa > 0) estado = "Em andamento";















        html += '<div class="mt-card">';







        html += '<div class="mt-card-top"><span class="mt-tag">🏅 ' + limparTexto(curso.nivel) + '</span>';







        html += '<span class="mt-tag">' + estado + '</span></div>';







        html += '<h3>' + limparTexto(curso.titulo) + '</h3>';







        html += '<p>' + limparTexto(curso.descricao) + '</p>';







        html += '<div class="mt-meta">' + curso.duracao + ' minutos | ' + curso.totalEtapas + ' aulas</div>';







        html += '<div class="mt-progress"><span style="width:' + porcentagem(curso) + '%"></span></div>';







        html += '<div class="mt-card-footer"><small>' + porcentagem(curso) + '% concluido</small>';















        if (curso.bloqueado) {







            html += '<small>' + limparTexto(curso.motivo) + '</small>';







        } else {







            html += '<a class="mt-btn mt-btn-primary" href="/microtreinamentos/' + encodeURIComponent(curso.id) + '">Abrir curso</a>';







        }







        html += '</div></div>';







    }















    document.getElementById("mt-total").textContent = disponiveis;







    document.getElementById("mt-done").textContent = concluidos;







    document.getElementById("mt-running").textContent = andamento;







    lista.innerHTML = html || '<div class="mt-empty">Nenhum curso encontrado.</div>';







}















function carregarCurso() {







    let tela = document.getElementById("mt-course");







    let id = tela.getAttribute("data-course");















    buscarDados("/api/microtreinamentos/" + id, "GET", null).then(function(resultado) {







        cursoAtual = resultado.treinamento;







        mostrarAula(cursoAtual.etapa);







    }).catch(function(erro) {







        tela.textContent = erro.message;







    });







}















function mostrarAula(numero) {







    let tela = document.getElementById("mt-course");







    let curso = cursoAtual;















    if (numero >= curso.licoes.length) {







        tela.innerHTML = '<h2>Conteudo concluido!</h2><p>Voce ja pode fazer a avaliacao.</p>' +







            '<a class="mt-btn mt-btn-primary" href="/microtreinamentos/' + curso.id + '/avaliacao">Fazer avaliacao</a>';







        return;







    }















    let aula = curso.licoes[numero];







    let html = '<p class="mt-step">Aula ' + (numero + 1) + ' de ' + curso.licoes.length + '</p>';







    html += '<h2 class="mt-lesson-title">' + limparTexto(aula.titulo) + '</h2>';







    html += '<div class="mt-lesson-text" style="white-space:pre-line;line-height:1.85">' + limparTexto(aula.texto) + '</div>';







    html += '<div class="mt-actions">';







    if (numero > 0) html += '<button class="mt-btn" id="voltarAula">Anterior</button>';







    html += '<button class="mt-btn mt-btn-primary" id="proximaAula">Concluir aula</button></div>';







    tela.innerHTML = html;















    if (numero > 0) {







        document.getElementById("voltarAula").addEventListener("click", function() {







            mostrarAula(numero - 1);







        });







    }















    document.getElementById("proximaAula").addEventListener("click", function() {







        let botao = document.getElementById("proximaAula");







        botao.disabled = true;















        if (numero < curso.etapa) {







            mostrarAula(numero + 1);







            return;







        }















        buscarDados("/api/microtreinamentos/" + curso.id + "/progresso", "POST", { etapa: numero + 1 })







            .then(function() {







                curso.etapa = numero + 1;







                mostrarAula(numero + 1);







            }).catch(function(erro) {







                alert(erro.message);







                botao.disabled = false;







            });







    });







}















function carregarAvaliacao() {







    let tela = document.getElementById("mt-exam");







    let id = tela.getAttribute("data-course");















    buscarDados("/api/microtreinamentos/" + id + "?avaliacao=1", "GET", null).then(function(resultado) {







        cursoAtual = resultado.treinamento;







        if (cursoAtual.etapa < cursoAtual.totalEtapas) {







            window.location.href = "/microtreinamentos/" + id;







            return;







        }







        mostrarAvaliacao();







    }).catch(function(erro) {







        tela.textContent = erro.message;







    });







}















function mostrarAvaliacao() {







    let tela = document.getElementById("mt-exam");







    let html = '<h2>Avaliacao: ' + limparTexto(cursoAtual.titulo) + '</h2>';



    html += '<p>Responda todas as perguntas. Nota minima: 80%.</p>';



    html += '<form id="formAvaliacao">';















    for (let i = 0; i < cursoAtual.questoes.length; i++) {







        let questao = cursoAtual.questoes[i];







        html += '<div class="mt-question"><strong>' + (i + 1) + '. ' + limparTexto(questao.pergunta) + '</strong>';







        for (let j = 0; j < questao.opcoes.length; j++) {







            html += '<label class="mt-choice"><input type="radio" name="questao' + i + '" value="' + j + '"> ' + limparTexto(questao.opcoes[j]) + '</label>';







        }







        html += '</div>';







    }















    html += '<div id="resultadoAvaliacao"></div><button class="mt-btn mt-btn-primary" type="submit">Enviar prova</button></form>';







    tela.innerHTML = html;







    document.getElementById("formAvaliacao").addEventListener("submit", enviarAvaliacao);







}















function enviarAvaliacao(evento) {







    evento.preventDefault();







    let respostas = [];







    let formulario = document.getElementById("formAvaliacao");







    let resultado = document.getElementById("resultadoAvaliacao");















    for (let i = 0; i < cursoAtual.questoes.length; i++) {







        let selecionada = formulario.querySelector('input[name="questao' + i + '"]:checked');







        if (selecionada == null) {







            resultado.textContent = "Responda todas as perguntas.";







            return;







        }







        respostas.push(parseInt(selecionada.value));







    }















    buscarDados("/api/microtreinamentos/" + cursoAtual.id + "/avaliacao", "POST", { respostas: respostas })







        .then(function(dados) {







            resultado.innerHTML = '<div class="mt-alert">Nota: ' + dados.nota + '%. ' + limparTexto(dados.mensagem) + '</div>';







            if (dados.aprovado) {







                resultado.innerHTML += '<a class="mt-btn mt-btn-primary" href="/microtreinamentos">Voltar aos cursos</a>';







            }







        }).catch(function(erro) {







            resultado.textContent = erro.message;







        });







}



















// SCRUM-486 integrada às concessões persistidas das SCRUM-484/485.



async function mostrarCertificacoes() {



    const lista = document.getElementById("mt-cert-list");



    if (!lista) return;



    try {



        const resultado = await buscarDados("/api/certificacoes", "GET", null);



        const progresso = Array.isArray(resultado.progresso) ? resultado.progresso : [];



        const concedidos = Array.isArray(resultado.certificacoes) ? resultado.certificacoes : [];



        // Compatibilidade com certificacoes anteriores a HestIA Academy.
        const temAcademy = [...progresso, ...concedidos].some(item =>
            /^HESTIA_ACADEMY_N[1-4]$/.test(String(item.codigo || ""))
        );
        if (!temAcademy && (progresso.length || concedidos.length)) {
            lista.replaceChildren();
            const registros = progresso.length ? progresso : concedidos;
            for (const item of registros) {
                const certificado = concedidos.find(c =>
                    (item.definicaoId != null && c.definicaoId === item.definicaoId) ||
                    (c.nome === item.nome && c.nivel === item.nivel)
                );
                const total = Number(item.totalRequisitos || 0);
                const atendidos = Number(item.requisitosAtendidos || 0);
                const pendentes = Number(item.requisitosPendentes ?? Math.max(0, total - atendidos));
                const card = document.createElement("article");
                card.className = "mt-cert-card";
                const titulo = document.createElement("h3");
                titulo.textContent = item.nome || "Certificação";
                const descricao = document.createElement("p");
                descricao.textContent = item.nivel || "";
                const progressoTexto = document.createElement("p");
                progressoTexto.textContent = certificado ? "Certificação conquistada" : atendidos + " de " + total + " requisitos atendidos";
                const rodape = document.createElement("p");
                rodape.textContent = certificado ? "Certificado disponível" : pendentes + " requisitos obrigatórios pendentes";
                card.append(titulo, descricao, progressoTexto, rodape);
                lista.append(card);
            }
            return;
        }

        const niveis = ["Aprendiz", "Consciente", "Guardião", "Embaixador"];



        lista.replaceChildren();



        for (let i = 1; i <= 4; i++) {



            const codigo = "HESTIA_ACADEMY_N" + i;



            const situacao = progresso.find(item => item.codigo === codigo);



            const certificado = concedidos.find(item => item.codigo === codigo);



            const concedida = Boolean(certificado || (situacao && situacao.concedida));



            const total = situacao ? situacao.totalRequisitos : 4;



            const atendidos = concedida ? total : (situacao ? situacao.requisitosAtendidos : 0);



            const percentual = total ? Math.max(0, Math.min(100, Math.round(atendidos / total * 100))) : 0;



            const card = document.createElement("article");



            card.className = "mt-cert-card mt-academy-card" + (concedida ? " mt-academy-earned" : "");



            const topo = document.createElement("div");



            topo.className = "mt-academy-top";



            const emblema = document.createElement("span");



            emblema.className = "mt-academy-emblem";



            emblema.textContent = ["✦", "◆", "★", "✧"][i - 1];



            const selo = document.createElement("span");



            selo.className = "mt-academy-badge";



            selo.textContent = concedida ? "✓ Conquistado" : (situacao ? "Em progresso" : "Aguardando configuração");



            topo.append(emblema, selo);



            const subtitulo = document.createElement("p");



            subtitulo.className = "mt-academy-eyebrow";



            subtitulo.textContent = "HESTIA ACADEMY · NÍVEL " + i;



            const titulo = document.createElement("h3");



            titulo.textContent = niveis[i - 1];



            const descricao = document.createElement("p");



            descricao.className = "mt-academy-description";



            descricao.textContent = concedida ? "Certificação conquistada com suas avaliações aprovadas." : "Aprove as quatro avaliações deste nível para conquistar sua certificação.";



            const progressoLinha = document.createElement("div");



            progressoLinha.className = "mt-academy-progress-label";



            const quantidade = document.createElement("strong");



            quantidade.textContent = atendidos + " de " + total + " avaliações";



            const porcentagem = document.createElement("span");



            porcentagem.textContent = percentual + "%";



            progressoLinha.append(quantidade, porcentagem);



            const barra = document.createElement("div");



            barra.className = "mt-academy-progress";



            const preenchimento = document.createElement("span");



            preenchimento.style.width = percentual + "%";



            barra.append(preenchimento);



            card.append(topo, subtitulo, titulo, descricao, progressoLinha, barra);



            if (certificado) {



                const botao = document.createElement("button");



                botao.type = "button";



                botao.className = "mt-btn mt-btn-primary mt-academy-action";



                botao.textContent = "Ver certificado";



                botao.addEventListener("click", () => abrirCertificado(certificado));



                card.append(botao);



            } else {



                const rodape = document.createElement("p");



                rodape.className = "mt-academy-footnote";



                rodape.textContent = situacao ? "Faltam " + Math.max(0, total - atendidos) + " avaliações aprovadas." : "Aguardando publicação pelo administrador.";



                card.append(rodape);



            }



            lista.append(card);



        }



    } catch (erro) {



        lista.textContent = erro.message;



    }



}



