
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Revisão de respostas | HestIA</title>

    <link rel="stylesheet" href="/styles.css">

    <style>
        .layout-revisao {
            display: flex;
            min-height: 100vh;
        }

        .layout-revisao > aside {
            width: 215px;
            min-width: 215px;
            flex-shrink: 0;
        }

        .layout-revisao > main {
            flex: 1;
            min-width: 0;
            max-width: 1100px;
            margin: 30px auto;
            padding: 20px;
        }

        .layout-revisao table {
            width: 100%;
            border-collapse: collapse;
        }

        .layout-revisao td,
        .layout-revisao th {
            padding: 12px;
            text-align: left;
            border-bottom: 1px solid #ddd;
        }

        .layout-revisao textarea,
        .layout-revisao select,
        .layout-revisao input {
            display: block;
            width: 100%;
            margin: 8px 0 20px;
            padding: 10px;
            box-sizing: border-box;
        }

        .layout-revisao pre {
            white-space: pre-wrap;
            overflow-wrap: anywhere;
        }

        .layout-revisao button {
            padding: 12px;
        }

        @media (max-width: 768px) {
            .layout-revisao {
                flex-direction: column;
            }

            .layout-revisao > aside {
                width: 100%;
                min-width: 0;
            }

            .layout-revisao > main {
                width: 100%;
                box-sizing: border-box;
                margin: 20px auto;
            }
        }
    </style>
</head>

<body>
    <div class="layout-revisao">
        <%- include('menu') %>

        <main>
            <h1>Revisão de respostas</h1>

            <p>
                As decisões preservam responsável, justificativa,
                validade e versão do conteúdo.
            </p>

            <table>
                <thead>
                    <tr>
                        <th>Resposta</th>
                        <th>Situação</th>
                        <th>Ação</th>
                    </tr>
                </thead>

                <tbody>
                    <% for (const item of lista) { %>
                        <tr>
                            <td><%= item.prompt_original %></td>
                            <td><%= item.status_qualidade %></td>
                            <td>
                                <a href="?id=<%= item.id %>">Revisar</a>
                            </td>
                        </tr>
                    <% } %>
                </tbody>
            </table>

            <% if (!lista.length) { %>
                <p>Nenhuma resposta cadastrada.</p>
            <% } %>

            <% if (detalhe) { %>
                <h2>Conteúdo</h2>

                <pre><%= detalhe.resposta.respostaGerada %></pre>

                <form
                    method="post"
                    action="/administracao/respostas/<%= detalhe.resposta.id %>/revisoes"
                >
                    <label>
                        Situação
                        <select name="status">
                            <option>EM_REVISAO</option>
                            <option>APROVADA</option>
                            <option>BLOQUEADA</option>
                            <option>RETIRADA</option>
                        </select>
                    </label>

                    <label>
                        Justificativa
                        <textarea
                            name="justificativa"
                            maxlength="1000"
                            required
                        ></textarea>
                    </label>

                    <label>
                        Validade opcional
                        <input name="expiraEm" type="datetime-local">
                    </label>

                    <button>Registrar revisão</button>
                </form>

                <h2>Histórico de revisão</h2>

                <% for (const r of detalhe.revisoes) { %>
                    <p>
                        <%= r.revisada_em %> |
                        <%= r.estado_anterior %> para
                        <%= r.estado_atual %> |
                        Responsável <%= r.responsavel_id %>
                    </p>

                    <p><%= r.justificativa %></p>
                <% } %>

                <h2>Versões de conteúdo</h2>

                <% for (const v of detalhe.versoes) { %>
                    <p>
                        Versão <%= v.numero_versao %> |
                        <%= v.criada_em %>
                    </p>
                <% } %>
            <% } %>
        </main>
    </div>
</body>
</html>
