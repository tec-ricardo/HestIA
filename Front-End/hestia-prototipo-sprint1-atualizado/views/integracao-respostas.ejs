<!DOCTYPE html><html lang="pt-BR"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Revisão de respostas | HestIA</title><link rel="stylesheet" href="/style.css"><style>main{max-width:1100px;margin:30px auto;padding:20px}table{width:100%;border-collapse:collapse}td,th{padding:12px;text-align:left;border-bottom:1px solid #ddd}textarea,select,input{display:block;width:100%;margin:8px 0 20px;padding:10px}pre{white-space:pre-wrap;overflow-wrap:anywhere}button{padding:12px}</style></head><body><%- include('menu') %><main><h1>Revisão de respostas</h1><p>As decisões preservam responsável, justificativa, validade e versão do conteúdo.</p><table><thead><tr><th>Resposta</th><th>Situação</th><th>Ação</th></tr></thead><tbody><% for(const item of lista){ %><tr><td><%= item.prompt_original %></td><td><%= item.status_qualidade %></td><td><a href="?id=<%= item.id %>">Revisar</a></td></tr><% } %></tbody></table><% if(!lista.length){ %><p>Nenhuma resposta cadastrada.</p><% } %><% if(detalhe){ %><h2>Conteúdo</h2><pre><%= detalhe.resposta.respostaGerada %></pre><form method="post" action="/administracao/respostas/<%= detalhe.resposta.id %>/revisoes"><label>Situação<select name="status"><option>EM_REVISAO</option><option>APROVADA</option><option>BLOQUEADA</option><option>RETIRADA</option></select></label><label>Justificativa<textarea name="justificativa" maxlength="1000" required></textarea></label><label>Validade opcional<input name="expiraEm" type="datetime-local"></label><button>Registrar revisão</button></form><h2>Histórico de revisão</h2><% for(const r of detalhe.revisoes){ %><p><%= r.revisada_em %> | <%= r.estado_anterior %> para <%= r.estado_atual %> | Responsável <%= r.responsavel_id %></p><p><%= r.justificativa %></p><% } %><h2>Versões de conteúdo</h2><% for(const v of detalhe.versoes){ %><p>Versão <%= v.numero_versao %> | <%= v.criada_em %></p><% } %><% } %></main></body></html>
