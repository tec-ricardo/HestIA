<!DOCTYPE html>
<html lang="pt-BR">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0">

    <title>
        HestIA - Administração
    </title>

    <link
        rel="stylesheet"
        href="/styles.css">

</head>

<body>

    <div class="app-shell">

        <%- include("menu", {
            perfil: perfil,
            email: email,
            active: active
        }) %>


        <main class="main">

            <!-- TOPO -->

            <header class="topbar">

                <button
                    class="menu-button"
                    id="menuButton">

                    ☰

                </button>

                <div>

                    <p class="eyebrow">
                        Administrador
                    </p>

                    <h1>
                        Administração
                    </h1>

                </div>

                <div class="profile-switch">

                    <span>
                        <%= email %>
                    </span>

                    <select disabled>

                        <option selected>
                            Administrador
                        </option>

                    </select>

                </div>

                <a
                    class="topbar-logout"
                    href="/sair">

                    Sair

                </a>

            </header>

            <% if (mensagem) { %>
                <div class="feedback success"><%= mensagem %></div>
            <% } %>
            <% if (erro) { %>
                <div class="feedback error"><%= erro %></div>
            <% } %>


            <section class="grid two">


                <!-- EMPRESA -->

                <article class="panel">

                    <div class="panel-head">

                        <h3>
                            Cadastro de empresa
                        </h3>

                    </div>

                    <form
                        class="form-grid"
                        action="/administracao/empresas"
                        method="post">

                        <label class="full">

                            Empresa

                            <input
                                name="nome"
                                type="text"
                                required>

                        </label>

                        <label>
                            CNPJ
                            <input name="cnpj" type="text" placeholder="00.000.000/0000-00" required>
                        </label>

                        <label>
                            Orçamento
                            <input name="orcamento" type="number" min="0" step="0.01">
                        </label>

                        <button
                            class="primary"
                            type="submit">

                            Cadastrar empresa

                        </button>

                    </form>

                </article>


                <!-- DEPARTAMENTO -->

                <article class="panel">

                    <div class="panel-head">

                        <h3>
                            Cadastro de departamento
                        </h3>

                    </div>

                    <form
                        class="form-grid"
                        action="/administracao/departamentos"
                        method="post">

                        <label>

                            Departamento

                            <input
                                name="nome"
                                type="text"
                                required>

                        </label>

                        <label>

                            Empresa existente

                            <select name="empresaId" required>
                                <option value="">Selecione</option>
                                <% empresas.forEach(function(empresa) { %>
                                    <option value="<%= empresa.id %>"><%= empresa.nome %></option>
                                <% }) %>
                            </select>

                        </label>

                        <label>
                            Responsável
                            <input name="responsavel" type="text">
                        </label>

                        <button
                            class="primary"
                            type="submit">

                            Cadastrar departamento

                        </button>

                    </form>

                </article>


                <!-- USUARIO -->

                <article class="panel">

                    <div class="panel-head">

                        <h3>
                            Cadastro de usuário
                        </h3>

                    </div>

                    <form
                        class="form-grid"
                        action="/administracao/usuarios"
                        method="post">

                        <label>

                            Usuário

                            <input
                                name="nome"
                                type="text"
                                required>

                        </label>

                        <label>

                            E-mail

                            <input name="email" type="email" required>

                        </label>

                        <label>

                            Senha

                            <input name="senha" type="password" minlength="8" required>

                        </label>

                        <label>

                            Perfil

                            <select name="perfil" required>

                                <option value="FUNCIONARIO">
                                    Colaborador
                                </option>

                                <option value="GESTOR">
                                    Gestor
                                </option>

                                <option value="ADMIN">
                                    Administrador
                                </option>

                            </select>

                        </label>

                        <label>
                            Cargo
                            <input name="cargo" type="text" required>
                        </label>

                        <label>
                            Empresa
                            <select name="empresaId" required>
                                <option value="">Selecione</option>
                                <% empresas.forEach(function(empresa) { %>
                                    <option value="<%= empresa.id %>"><%= empresa.nome %></option>
                                <% }) %>
                            </select>
                        </label>

                        <label>
                            Departamento
                            <select name="departamentoId" required>
                                <option value="">Selecione</option>
                                <% departamentos.forEach(function(departamento) { %>
                                    <option value="<%= departamento.id %>"><%= departamento.nome %></option>
                                <% }) %>
                            </select>
                        </label>

                        <button
                            class="primary"
                            type="submit">

                            Cadastrar usuário

                        </button>

                    </form>

                </article>


                <!-- PERFIS -->

                <article class="panel">

                    <div class="panel-head">

                        <h3>
                            Perfis e permissões
                        </h3>

                    </div>

                    <div class="list-clean">

                        <span>
                            Colaborador
                        </span>

                        <span>
                            Gestor
                        </span>

                        <span>
                            Administrador
                        </span>

                    </div>

                </article>


                <!-- FERRAMENTA -->

                <article class="panel">

                    <div class="panel-head">

                        <h3>
                            Cadastro de modelo ou ferramenta de IA
                        </h3>

                    </div>

                    <form
                        class="form-grid"
                        action="/administracao/ferramentas"
                        method="post">

                        <label class="full">

                            Identificação

                            <input
                                name="nome"
                                type="text"
                                required>

                        </label>

                        <label>
                            Fornecedor
                            <input name="fornecedor" type="text" required>
                        </label>

                        <label>
                            Empresa
                            <select name="empresaId" required>
                                <option value="">Selecione</option>
                                <% empresas.forEach(function(empresa) { %>
                                    <option value="<%= empresa.id %>"><%= empresa.nome %></option>
                                <% }) %>
                            </select>
                        </label>

                        <label>
                            Tipo
                            <select name="tipo" required>
                                <option value="CHATBOT">Chatbot</option>
                                <option value="GERACAO_TEXTO">Geração de texto</option>
                                <option value="GERACAO_IMAGEM">Geração de imagem</option>
                                <option value="ASSISTENTE_CODIGO">Assistente de código</option>
                                <option value="ANALISE_DADOS">Análise de dados</option>
                                <option value="OUTROS">Outros</option>
                            </select>
                        </label>

                        <label class="full">
                            Finalidade de uso
                            <input name="finalidadeUso" type="text" minlength="10" required>
                        </label>

                        <label>
                            Trata dados pessoais?
                            <select name="trataDadosPessoais" required>
                                <option value="false">Não</option>
                                <option value="true">Sim</option>
                            </select>
                        </label>

                        <button
                            class="primary"
                            type="submit">

                            Cadastrar ferramenta de IA

                        </button>

                    </form>

                </article>

            </section>

            <section class="panel">
                <div class="panel-head"><h3>Dados cadastrados no backend</h3></div>
                <div class="integration-summary">
                    <span><strong><%= empresas.length %></strong> empresas</span>
                    <span><strong><%= departamentos.length %></strong> departamentos</span>
                    <span><strong><%= usuarios.length %></strong> usuários</span>
                    <span><strong><%= ferramentas.length %></strong> ferramentas de IA</span>
                </div>
                <div class="table-wrap">
                    <table>
                        <thead><tr><th>Tipo</th><th>Nome</th><th>Detalhe</th></tr></thead>
                        <tbody>
                            <% empresas.forEach(function(item) { %>
                                <tr><td>Empresa</td><td><%= item.nome %></td><td><%= item.cnpj %></td></tr>
                            <% }) %>
                            <% departamentos.forEach(function(item) { %>
                                <tr><td>Departamento</td><td><%= item.nome %></td><td><%= item.responsavel || "—" %></td></tr>
                            <% }) %>
                            <% usuarios.forEach(function(item) { %>
                                <tr><td>Usuário</td><td><%= item.nome %></td><td><%= item.email %></td></tr>
                            <% }) %>
                            <% ferramentas.forEach(function(item) { %>
                                <tr><td>Ferramenta IA</td><td><%= item.nome %></td><td><%= item.status %></td></tr>
                            <% }) %>
                            <% if (!empresas.length && !departamentos.length && !usuarios.length && !ferramentas.length) { %>
                                <tr><td colspan="3">Nenhum dado cadastrado.</td></tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </section>


            <div
                class="toast"
                id="toast">

                Dados persistidos pelo backend HestIA.

            </div>

        </main>

    </div>


    <script src="/app.js"></script>

</body>

</html>
