<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HestIA - AI Credits</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
<div class="app-shell">
    <%- include("menu", { perfil, email, active }) %>
    <main class="main">
        <header class="topbar">
            <button class="menu-button" id="menuButton">☰</button>
            <div><p class="eyebrow">Reconhecimento</p><h1>AI Credits</h1></div>
            <div class="profile-switch"><span><%= email %></span></div>
            <a class="topbar-logout" href="/sair">Sair</a>
        </header>

        <% if (erro) { %>
            <section class="panel"><p class="error-message"><%= erro %></p></section>
        <% } else { %>
            <section class="grid three">
                <article class="metric-card">
                    <span>Meus AI Credits</span>
                    <strong><%= creditos.saldo %></strong>
                    <p>Saldo confirmado pelo histórico de ações da plataforma.</p>
                </article>
                <article class="metric-card">
                    <span>Minha posição</span>
                    <strong><%= creditos.posicao ? creditos.posicao + 'º' : '—' %></strong>
                    <p><%= creditos.posicao ? 'Entre participantes com créditos na empresa.' : 'Você ainda não possui créditos para entrar no ranking.' %></p>
                </article>
                <article class="metric-card">
                    <span>Participantes</span>
                    <strong><%= creditos.participantes %></strong>
                    <p>Pessoas da empresa com ações pontuadas.</p>
                </article>
            </section>

            <section class="panel">
                <div class="panel-head"><div><h3>Como os créditos funcionam</h3><p><%= creditos.regra %></p></div></div>
                <div class="pill-grid">
                    <div class="solid-item"><span>Registrar utilização válida: +10</span></div>
                    <div class="solid-item"><span>Utilização conforme: +25</span></div>
                    <div class="solid-item"><span>Concluir microtreinamento: +40</span></div>
                    <div class="solid-item"><span>Reutilizar resposta aprovada: +15</span></div>
                    <div class="solid-item"><span>Concluir missão: +50</span></div>
                </div>
            </section>

            <section class="panel">
                <div class="panel-head"><div><h3>Ranking da empresa</h3><p>Classificação baseada somente em ações registradas e validadas no HestIA.</p></div></div>
                <% if (!creditos.ranking.length) { %>
                    <p class="muted">Ainda não há participantes com AI Credits.</p>
                <% } else { %>
                    <div class="table-wrap"><table>
                        <thead><tr><th>Posição</th><th>Participante</th><th>AI Credits</th></tr></thead>
                        <tbody>
                        <% creditos.ranking.forEach(item => { %>
                            <tr class="<%= item.usuarioAtual ? 'current-user-row' : '' %>">
                                <td><%= item.posicao %>º</td>
                                <td><%= item.usuarioAtual ? item.nome + ' (você)' : item.nome %></td>
                                <td><strong><%= item.creditos %></strong></td>
                            </tr>
                        <% }) %>
                        </tbody>
                    </table></div>
                <% } %>
            </section>
        <% } %>
    </main>
</div>
<script src="/app.js"></script>
</body>
</html>
