<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>HestIA - AI Credits</title>
<link rel="stylesheet" href="/styles.css">
<style>
/* Visual HestIA atualizado: estilos isolados por pagina */
.hx-page{padding:4px 0 42px;color:#172c49}
.hx-page .hx-hero{position:relative;overflow:hidden;background:linear-gradient(120deg,#172c49,#294a70);border:0;border-radius:20px;padding:30px 32px;color:white;margin-bottom:22px;box-shadow:0 14px 30px rgba(23,44,73,.12)}
.hx-page .hx-hero:after{content:"";position:absolute;right:-85px;top:-120px;width:240px;height:240px;border:38px solid rgba(255,255,255,.05);border-radius:50%;pointer-events:none}
.hx-page .hx-hero .eyebrow{color:#f2b07d;font-weight:800;letter-spacing:1.4px}
.hx-page .hx-hero h2{font-size:clamp(23px,3vw,31px);margin:9px 0;color:white}
.hx-page .hx-hero p:last-child{color:#dbe5f1;margin-bottom:0;line-height:1.6}
.hx-page .hx-kpis{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px;margin-bottom:20px}
.hx-page .hx-governance-kpis{grid-template-columns:repeat(4,minmax(0,1fr))}
.hx-page .hx-metrics{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px;margin-bottom:20px}
.hx-page .hx-card{min-width:0;background:#fff;border:1px solid #dce5ef;border-top:4px solid #d47739;border-radius:16px;padding:21px;box-shadow:0 8px 24px rgba(23,44,73,.04);transition:transform .2s,box-shadow .2s}
.hx-page .hx-card:nth-child(2){border-top-color:#4777bc}
.hx-page .hx-card:nth-child(3){border-top-color:#29966a}
.hx-page .hx-card:nth-child(4){border-top-color:#8162b4}
.hx-page .hx-card:hover{transform:translateY(-2px);box-shadow:0 12px 28px rgba(23,44,73,.09)}
.hx-page .hx-card>span{display:block;color:#6c7e93;font-size:12px;font-weight:800;letter-spacing:.045em;text-transform:uppercase}
.hx-page .hx-card>strong{display:block;font-size:clamp(23px,2.7vw,32px);line-height:1.2;margin:12px 0 8px;color:#172c49;overflow-wrap:anywhere}
.hx-page .hx-card>p{margin:0;color:#708199;font-size:12px;line-height:1.6}
.hx-page .hx-panel{background:#fff;border:1px solid #dce5ef;border-radius:18px;padding:25px;margin-bottom:20px;box-shadow:0 10px 28px rgba(23,44,73,.035)}
.hx-page .hx-panel .panel-head{margin-bottom:20px;align-items:flex-start}
.hx-page .hx-panel .panel-head h3{font-size:20px;color:#172c49;margin:0 0 7px}
.hx-page .hx-panel .panel-head p{margin:0;color:#708199;font-size:13px;line-height:1.6}
.hx-page .hx-rules{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
.hx-page .hx-rules .solid-item{background:#f5f8fc;border:1px solid #e3eaf2;border-radius:11px;padding:15px 17px;position:relative}
.hx-page .hx-rules .solid-item:before{content:"";display:block;position:absolute;left:0;top:13px;bottom:13px;width:3px;background:#d47739;border-radius:4px}
.hx-page .hx-rules .solid-item span{margin:0;color:#3b506a;font-size:13px;font-weight:600}
.hx-page .hx-table-wrap{overflow-x:auto;border:1px solid #e4ebf3;border-radius:12px}
.hx-page .hx-table{width:100%;min-width:650px;border-collapse:collapse}
.hx-page .hx-table th{text-align:left;background:#f4f7fb;color:#63758e;font-size:12px;font-weight:800;padding:15px}
.hx-page .hx-table td{padding:16px 15px;color:#273d58;font-size:13px;border-top:1px solid #edf1f6;vertical-align:middle}
.hx-page .hx-table tbody tr:hover{background:#f8fbff}
.hx-page .hx-table .current-user-row{background:#fff7ed}
.hx-page .hx-table td strong{color:#172c49}
.hx-page .hx-table td small{display:inline-block;color:#73849a;margin-top:5px;line-height:1.5}
.hx-page .hx-muted{color:#708199;font-size:13px;line-height:1.6}
.hx-page .hx-form{gap:16px}
.hx-page .hx-form label{color:#344963;font-weight:750}
.hx-page .hx-form input,.hx-page .hx-form textarea{width:100%;border:1px solid #d7e1ec;border-radius:10px;background:#fbfcfe;padding:12px;font:inherit;color:#172c49}
.hx-page .hx-form input:focus,.hx-page .hx-form textarea:focus{outline:2px solid #adc6e9;outline-offset:1px}
.hx-page .hx-form .primary{background:#d47739;border-radius:10px;padding:12px 19px}
.hx-page .hx-form .primary:hover{background:#bd622b}
.hx-page .hx-info-link{display:inline-flex;margin-top:14px;color:#b45b27;font-weight:800}
.hx-page .hx-info-link:hover{text-decoration:underline}
.hx-page .hx-panel>p{font-size:13px;line-height:1.7;color:#526680}
@media(max-width:1100px){.hx-page .hx-governance-kpis{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:800px){.hx-page .hx-kpis,.hx-page .hx-metrics{grid-template-columns:1fr}}
@media(max-width:650px){.hx-page .hx-governance-kpis,.hx-page .hx-rules{grid-template-columns:1fr}.hx-page .hx-panel,.hx-page .hx-hero{padding:20px}}

/* Secao retratil: regras de AI Credits, sem alterar os dados */
.hx-page .hx-accordion{padding:0;overflow:hidden}
.hx-page .hx-accordion-summary{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:23px 25px;cursor:pointer;list-style:none;font-size:20px;font-weight:800;color:#172c49;user-select:none}
.hx-page .hx-accordion-summary::-webkit-details-marker{display:none}
.hx-page .hx-accordion-summary:hover{background:#f8fafc}
.hx-page .hx-accordion-summary:focus-visible{outline:3px solid #adc6e9;outline-offset:-3px}
.hx-page .hx-accordion-arrow{width:11px;height:11px;flex-shrink:0;border-right:2px solid #d47739;border-bottom:2px solid #d47739;transform:rotate(45deg);transition:transform .2s}
.hx-page .hx-accordion[open] .hx-accordion-arrow{transform:rotate(225deg)}
.hx-page .hx-accordion-content{padding:0 25px 25px;border-top:1px solid #e8edf3}
.hx-page .hx-rule-description{margin:18px 0;color:#708199;font-size:13px;line-height:1.6}
@media(max-width:650px){.hx-page .hx-accordion{padding:0}.hx-page .hx-accordion-summary{padding:20px;font-size:18px}.hx-page .hx-accordion-content{padding:0 20px 20px}}

/* Ranking visual no estilo da tela Ranking HestIA */
.hx-page .hx-rank-head{display:flex;align-items:center;justify-content:space-between;gap:16px;margin-bottom:18px}
.hx-page .hx-rank-head .panel-head{margin:0}
.hx-page .hx-rank-count{border-radius:99px;padding:8px 13px;background:#eaf1f8;color:#193c62;font-size:12px;font-weight:800;white-space:nowrap}
.hx-page .hx-rank-kicker{font-size:10px;letter-spacing:1.3px;font-weight:850;color:#d47739;text-transform:uppercase;margin:0 0 6px}
.hx-page .hx-rank-subtitle{font-size:15px;font-weight:800;color:#172c49;margin:0 0 12px}
.hx-page .hx-rank-leader{display:flex;align-items:center;gap:13px;padding:17px 20px;border:1.5px solid #d9a31a;background:linear-gradient(100deg,#fffdf4,#fff8e0);border-radius:13px;margin-bottom:18px;box-shadow:0 4px 12px rgba(171,123,17,.08)}
.hx-page .hx-rank-place{display:grid;place-items:center;flex-shrink:0;width:40px;height:40px;border-radius:50%;background:#eaf0f6;color:#9b7209;font-size:14px;font-weight:850}
.hx-page .hx-rank-avatar{display:grid;place-items:center;flex-shrink:0;width:46px;height:46px;border:1px solid #d1a124;border-radius:11px;background:#ebca65;color:#654500;font-size:14px;font-weight:850}
.hx-page .hx-rank-name{min-width:0;flex:1;font-size:14px;font-weight:800;color:#172c49;overflow-wrap:anywhere}
.hx-page .hx-rank-points{text-align:right;color:#a47508;font-weight:850;font-size:18px;white-space:nowrap}
.hx-page .hx-rank-you{display:block;width:max-content;margin:5px 0 0 auto;padding:3px 9px;background:#e4effb;color:#244d77;border-radius:99px;font-size:11px;font-weight:800}
.hx-page .hx-rank-table thead th{font-size:10px;letter-spacing:.055em;text-transform:uppercase}
.hx-page .hx-rank-table td{font-weight:650}
.hx-page .hx-rank-table td:last-child{font-weight:850;color:#193c62}
.hx-page .hx-rank-table .current-user-row{background:#edf4fc}
.hx-page .hx-rank-table .hx-rank-number{display:inline-block;border-radius:8px;padding:6px 9px;background:#eaf1f8;font-weight:850}
.hx-page .hx-rank-table .hx-rank-person{display:flex;align-items:center;gap:11px}
.hx-page .hx-rank-table .hx-rank-initials{width:34px;height:34px;display:grid;place-items:center;background:#eaf1f8;border:1px solid #dce5ef;border-radius:9px;color:#234b70;font-size:11px;font-weight:850;flex-shrink:0}
.hx-page .hx-rank-table .hx-rank-self{display:block;margin-top:3px;font-size:11px;color:#2563eb;font-weight:800}
@media(max-width:650px){.hx-page .hx-rank-leader{padding:13px;gap:9px}.hx-page .hx-rank-avatar{width:38px;height:38px}.hx-page .hx-rank-place{width:32px;height:32px}.hx-page .hx-rank-points{font-size:14px}.hx-page .hx-rank-head{align-items:flex-start}}
</style>
</head>
<body>
<div class="app-shell">
<%- include("menu", { perfil, email, active }) %>
<main class="main">
<header class="topbar"><button class="menu-button" id="menuButton">☰</button><div><p class="eyebrow">Reconhecimento</p><h1>AI Credits</h1></div><div class="profile-switch"><span><%= email %></span></div><a class="topbar-logout" href="/sair">Sair</a></header>
<div class="hx-page">
<% if (erro) { %>
<section class="hx-panel"><p class="error-message"><%= erro %></p></section>
<% } else { %>
<section class="hx-kpis">
<article class="hx-card"><span>Meus AI Credits</span><strong><%= creditos.saldo %></strong><p>Saldo confirmado pelo histórico de ações da plataforma.</p></article>
<article class="hx-card"><span>Minha posição</span><strong><%= creditos.posicao ? creditos.posicao + 'º' : '—' %></strong><p><%= creditos.posicao ? 'Entre participantes com créditos na empresa.' : 'Você ainda não possui créditos para entrar no ranking.' %></p></article>
<article class="hx-card"><span>Participantes</span><strong><%= creditos.participantes %></strong><p>Pessoas da empresa com ações pontuadas.</p></article>
</section>
<section class="hx-panel">
<div class="hx-rank-head"><div class="panel-head"><div><h3>Ranking da empresa</h3><p>Classificação baseada somente em ações registradas e validadas no HestIA.</p></div></div><span class="hx-rank-count"><%= creditos.ranking.length %> participante<%= creditos.ranking.length === 1 ? '' : 's' %></span></div>
<% if (!creditos.ranking.length) { %>
<p class="muted hx-muted">Ainda não há participantes com AI Credits.</p>
<% } else { %>
<% const lider = creditos.ranking.find(item => Number(item.posicao) === 1) || creditos.ranking[0]; %>
<p class="hx-rank-kicker">Destaques</p>
<h4 class="hx-rank-subtitle">Líder da classificação</h4>
<div class="hx-rank-leader">
<span class="hx-rank-place"><%= lider.posicao %>º</span>
<span class="hx-rank-avatar"><%= String(lider.nome || '?').trim().split(/\s+/).slice(0,2).map(parte => parte.charAt(0)).join('').toUpperCase() %></span>
<span class="hx-rank-name"><%= lider.nome %></span>
<div class="hx-rank-points"><%= lider.creditos %> AI Credits<% if (lider.usuarioAtual) { %><span class="hx-rank-you">Você</span><% } %></div>
</div>
<div class="hx-table-wrap"><table class="hx-table hx-rank-table">
<thead><tr><th>Posição</th><th>Participante</th><th>AI Credits</th></tr></thead>
<tbody>
<% creditos.ranking.forEach(item => { %>
<tr class="<%= item.usuarioAtual ? 'current-user-row' : '' %>">
<td><span class="hx-rank-number"><%= item.posicao %>º</span></td>
<td><div class="hx-rank-person"><span class="hx-rank-initials"><%= String(item.nome || '?').trim().split(/\s+/).slice(0,2).map(parte => parte.charAt(0)).join('').toUpperCase() %></span><span><%= item.nome %><% if (item.usuarioAtual) { %><small class="hx-rank-self">Você</small><% } %></span></div></td>
<td><%= item.creditos %></td>
</tr>
<% }) %>
</tbody>
</table></div>
<% } %>
</section>
<details class="hx-panel hx-accordion">
<summary class="hx-accordion-summary"><span>Como os créditos funcionam</span><span class="hx-accordion-arrow" aria-hidden="true"></span></summary>
<div class="hx-accordion-content">
<p class="hx-rule-description"><%= creditos.regra %></p>
<div class="hx-rules">
<div class="solid-item"><span>Registrar utilização válida: +10</span></div>
<div class="solid-item"><span>Utilização conforme: +25</span></div>
<div class="solid-item"><span>Concluir microtreinamento: +40</span></div>
<div class="solid-item"><span>Reutilizar resposta aprovada: +15</span></div>
<div class="solid-item"><span>Concluir missão: +50</span></div>
</div>
</div>
</details>
<% } %>
</div>
</main>
</div>
<script src="/app.js"></script>
</body>
</html>