<!doctype html><html lang="pt-BR"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Relatório de usos — HestIA</title><link rel="stylesheet" href="/styles.css"></head><body><div class="app-shell"><%- include('menu',{perfil,email,active}) %><main class="main-content" style="padding:32px"><h1>Relatório de usos</h1><% if(perfil==='administrador'){ %><p><a href="/relatorios-economia">Consultar e exportar economia acumulada</a></p><% } %><p><a href="/relatorios-maturidade">Consultar e exportar maturidade ou evolução</a></p><form method="get" class="form-grid"><label>De<input type="date" name="inicio" value="<%= filtros.inicio||'' %>"></label><label>Até<input type="date" name="fim" value="<%= filtros.fim||'' %>"></label><label>Departamento (referência)<input type="number" min="1" name="departamentoId" value="<%= filtros.departamentoId||'' %>"></label><label>Ferramenta (referência)<input type="number" min="1" name="ferramentaId" value="<%= filtros.ferramentaId||'' %>"></label><label>Finalidade<select name="finalidade"><option value="">Todas</option><% ["GERACAO_CODIGO","GERACAO_CONTEUDO","PESQUISA","ANALISE_DADOS","RESUMO","AUTOMACAO","SUPORTE_DECISAO","OUTROS"].forEach(f=>{ %><option value="<%= f %>" <%= filtros.finalidade===f?"selected":"" %>><%= f.replaceAll("_"," ") %></option><% }) %></select></label><button type="submit">Aplicar filtros</button></form><a href="/relatorios-uso/exportar?<%= consulta %>">Exportar este resultado em CSV</a><p><%= itens.length %> registros no escopo autorizado.</p><div class="panel" style="overflow:auto"><table><thead><tr><% ['Data','Usuário','Departamento','Ferramenta','Finalidade','Tokens','Custo estimado'].forEach(t=>{ %><th><%= t %></th><% }) %></tr></thead><tbody><% itens.forEach(i=>{ %><tr><% ['data','usuario','departamento','ferramenta','finalidade','tokens','custo_estimado'].forEach(k=>{ %><td><%= i[k]??'Não informado' %></td><% }) %></tr><% }) %></tbody></table></div></main></div></body></html>
